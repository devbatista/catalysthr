<%# The simulation notice has its own banner (panel/shared/_impersonation) %>
<% flash.each do |type, message| %>
  <% next if type.to_s == "simulation" %>
  <p class="mb-6 <%= type == "alert" ? "alert-bad" : "alert-ok" %>"
     role="<%= type == "alert" ? "alert" : "status" %>"><%= message %></p>
<% end %>
