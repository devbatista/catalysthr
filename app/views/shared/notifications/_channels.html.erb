<%# The channels of each notice type (RN-15-020 to RN-15-022): the bell is always on; the
    external channels of this phase can be chosen. A mandatory type with a single external
    channel keeps it, shown checked and locked (RN-15-022). locals: types, channels (code =>
    channels chosen), name (the field's prefix), errors (code => messages) %>
<div class="overflow-x-auto">
  <table class="data-table">
    <thead>
      <tr>
        <th scope="col"><%= t("notifications.channels.type") %></th>
        <th scope="col" class="w-20 text-center"><%= t("notifications.channels.system") %></th>
        <th scope="col" class="w-20 text-center"><%= t("notifications.channels.email") %></th>
      </tr>
    </thead>
    <tbody>
      <% types.each do |type| %>
        <% chosen = channels.fetch(type.code) %>
        <% locked = type.mandatory && type.configurable_channels.one? %>
        <tr>
          <td>
            <span class="block font-semibold text-ink-strong"><%= t("notification_types.#{type.code}.name") %></span>
            <span class="block text-xs text-ink-muted"><%= t("notification_types.#{type.code}.hint") %></span>
            <% if type.mandatory %><span class="pill pill-info mt-1"><%= t("notifications.channels.mandatory") %></span><% end %>
            <% Array(errors[type.code]).each do |message| %><span class="mt-1 block text-xs font-semibold text-bad"><%= message %></span><% end %>
          </td>
          <td class="text-center text-xs text-ink-muted"><%= type.in_bell? ? t("notifications.channels.always") : "—" %></td>
          <td class="text-center">
            <%= hidden_field_tag "#{name}[#{type.code}][]", "", id: nil %>
            <% if type.configurable_channels.include?("email") %>
              <% if locked %><%= hidden_field_tag "#{name}[#{type.code}][]", "email", id: nil %><% end %>
              <%= check_box_tag "#{name}[#{type.code}][]", "email", chosen.include?("email") || locked, id: "#{name.parameterize}_#{type.code.parameterize}_email",
                disabled: locked, class: "size-4", "aria-label": t("notifications.channels.email_for", type: t("notification_types.#{type.code}.name")) %>
            <% else %>—<% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
