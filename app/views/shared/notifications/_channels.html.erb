<%# The channels of each notice type (RN-15-020 to RN-15-022): the bell is always on; the
    external channels that exist now can be chosen. A mandatory type with a single external
    channel keeps it, shown checked and locked (RN-15-022). locals: types, channels (code =>
    channels chosen), name (the field's prefix), errors (code => messages) and, on a
    person's own table, roles %>
<% roles = local_assigns[:roles] %>
<% columns = NotificationType.available_channels %>
<div class="overflow-x-auto">
  <table class="data-table">
    <thead>
      <tr>
        <th scope="col"><%= t("notifications.channels.type") %></th>
        <th scope="col" class="w-20 text-center"><%= t("notifications.channels.system") %></th>
        <% columns.each do |channel| %>
          <th scope="col" class="w-20 text-center"><%= t("notifications.channels.#{channel}") %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% types.each do |type| %>
        <% chosen = channels.fetch(type.code) %>
        <% configurable = type.configurable_channels(roles) %>
        <% locked = type.mandatory && configurable.one? %>
        <tr>
          <td>
            <span class="block font-semibold text-ink-strong"><%= t("notification_types.#{type.code}.name") %></span>
            <span class="block text-xs text-ink-muted"><%= t("notification_types.#{type.code}.hint") %></span>
            <% if type.mandatory %><span class="pill pill-info mt-1"><%= t("notifications.channels.mandatory") %></span><% end %>
            <% Array(errors[type.code]).each do |message| %><span class="mt-1 block text-xs font-semibold text-bad"><%= message %></span><% end %>
          </td>
          <td class="text-center text-xs text-ink-muted"><%= type.in_bell? ? t("notifications.channels.always") : "—" %></td>
          <% columns.each_with_index do |channel, index| %>
            <td class="text-center">
              <% if index.zero? %><%= hidden_field_tag "#{name}[#{type.code}][]", "", id: nil %><% end %>
              <% if configurable.include?(channel) %>
                <% if locked %><%= hidden_field_tag "#{name}[#{type.code}][]", channel, id: nil %><% end %>
                <%= check_box_tag "#{name}[#{type.code}][]", channel, chosen.include?(channel) || locked, id: "#{name.parameterize}_#{type.code.parameterize}_#{channel}",
                  disabled: locked, class: "size-4", "aria-label": t("notifications.channels.#{channel}_for", type: t("notification_types.#{type.code}.name")) %>
              <% else %>—<% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
