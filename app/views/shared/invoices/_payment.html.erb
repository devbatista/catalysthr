<%# How the invoice is paid (RN-19-042, D-622): the PIX for whoever pays it, its status for
    the CatalystHR team. locals: invoice; payer; pix: the valid PIX, or nil. %>
<% if invoice.paid? %>
  <p class="alert-ok mt-6"><%= t("shared.invoices.payment.paid", date: l(invoice.paid_at.to_date)) %></p>
<% elsif !invoice.payable? %>
  <%# Void, or nothing to charge. %>
<% elsif !payer %>
  <p class="field-hint mt-2"><%= t("shared.invoices.payment.awaiting") %></p>
<% elsif pix %>
  <section class="card card-body mt-6" aria-labelledby="pix-title">
    <h2 id="pix-title" class="card-title"><%= t("shared.invoices.payment.title") %></h2>
    <div class="mt-4 flex flex-col gap-6 sm:flex-row sm:items-start">
      <% if pix.qr_code_base64.present? %>
        <img src="data:image/png;base64,<%= pix.qr_code_base64 %>" alt="<%= t("shared.invoices.payment.qr_alt") %>"
          class="h-48 w-48 shrink-0 self-center rounded-lg border border-line bg-white p-2 sm:self-start">
      <% end %>
      <div class="min-w-0 flex-1">
        <label for="pix-code" class="field-label"><%= t("shared.invoices.payment.code") %></label>
        <textarea id="pix-code" class="input mt-1 font-mono text-xs break-all" rows="4" readonly><%= pix.qr_code %></textarea>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <button type="button" class="btn btn-primary" data-copy="pix-code" data-copied="<%= t("shared.invoices.payment.copied") %>"><%= t("shared.invoices.payment.copy") %></button>
          <% if pix.ticket_url.present? %>
            <%= link_to t("shared.invoices.payment.ticket"), pix.ticket_url, class: "btn btn-secondary", target: "_blank", rel: "noopener noreferrer" %>
          <% end %>
        </div>
        <p class="field-hint mt-3">
          <%= t("shared.invoices.payment.valid_until", amount: reais(pix.amount_cents), date: l(pix.expires_at.to_date), time: pix.expires_at.strftime("%Hh%M")) %>
        </p>
      </div>
    </div>
  </section>
<% else %>
  <p class="alert-info mt-6"><%= t("shared.invoices.payment.unavailable") %></p>
<% end %>
