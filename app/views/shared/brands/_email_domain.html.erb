<%# The brand's e-mail domain (RN-01-040, D-596). Locals: brand, url. %>
<section class="card card-body mt-6 max-w-2xl" aria-labelledby="email-domain-title">
  <h2 id="email-domain-title" class="card-title"><%= t("brands.email_domain.title") %></h2>
  <% if brand.email_domain.blank? %>
    <p class="mt-1 text-sm"><%= t("brands.email_domain.not_configured", address: BrandSender::PLATFORM_ADDRESS) %></p>
    <%= form_with url: url, method: :post, class: "mt-3 flex flex-wrap items-end gap-3" do |form| %>
      <div>
        <%= form.label :email_domain, t("brands.email_domain.label"), class: "field-label" %>
        <%= form.text_field :email_domain, required: true, placeholder: "auroragestao.com.br", autocomplete: "off",
          class: "input w-72 max-w-full font-mono" %>
      </div>
      <%= form.submit t("brands.email_domain.submit"), class: "btn btn-secondary" %>
    <% end %>
    <p class="mt-2 text-xs text-ink-muted"><%= t("brands.email_domain.hint") %></p>
  <% else %>
    <p class="mt-1 text-sm">
      <span class="font-mono"><%= brand.email_domain %></span>
      <span class="pill <%= { "verified" => "pill-ok", "failed" => "pill-bad" }.fetch(brand.email_domain_status, "pill-warn") %>"><%= t("brands.email_domain.statuses.#{brand.email_domain_status}") %></span>
      <% if brand.email_domain_checked_at %>
        <span class="text-ink-muted">(<%= t("brands.email_domain.checked_at", time: l(brand.email_domain_checked_at, format: :short)) %>)</span>
      <% end %>
    </p>
    <p class="mt-1 text-sm"><%= t("brands.email_domain.sender",
      address: brand.email_domain_verified? ? "#{BrandSender::LOCAL_PART}@#{brand.email_domain}" : BrandSender::PLATFORM_ADDRESS) %></p>
    <% unless brand.email_domain_verified? %>
      <p class="mt-3 text-sm"><%= t("brands.email_domain.records_hint") %></p>
    <% end %>
    <% if brand.email_domain_records.any? %>
      <div class="mt-3 overflow-x-auto rounded-lg border border-line">
        <table class="data-table text-xs">
          <thead>
            <tr>
              <th><%= t("brands.email_domain.record_type") %></th>
              <th><%= t("brands.email_domain.record_name") %></th>
              <th><%= t("brands.email_domain.record_value") %></th>
            </tr>
          </thead>
          <tbody class="font-mono">
            <% brand.email_domain_records.each do |record| %>
              <tr class="align-top">
                <td><%= record["type"] %></td>
                <td class="break-all"><%= record["name"] %></td>
                <td class="break-all"><%= record["value"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    <%= form_with url: url, method: :delete, class: "mt-4", data: { confirm: t("brands.email_domain.remove_confirm") } do |form| %>
      <%= form.submit t("brands.email_domain.remove"), class: "btn btn-danger" %>
    <% end %>
  <% end %>
</section>
