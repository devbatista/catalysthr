<%# The brand's e-mail domain (RN-01-040, D-596). Locals: brand, url. %>
<section class="mt-10 max-w-2xl" aria-labelledby="email-domain-title">
  <h2 id="email-domain-title" class="text-lg font-semibold"><%= t("brands.email_domain.title") %></h2>
  <% if brand.email_domain.blank? %>
    <p class="mt-1 text-sm"><%= t("brands.email_domain.not_configured", address: BrandSender::PLATFORM_ADDRESS) %></p>
    <%= form_with url: url, method: :post, class: "mt-3 flex items-end gap-3" do |form| %>
      <div>
        <%= form.label :email_domain, t("brands.email_domain.label"), class: "block text-sm font-medium" %>
        <%= form.text_field :email_domain, required: true, placeholder: "auroragestao.com.br", autocomplete: "off",
          class: "mt-1 block w-72 rounded-lg border border-slate-300 px-3 py-2 font-mono" %>
      </div>
      <%= form.submit t("brands.email_domain.submit"), class: "rounded-lg px-4 py-2 ring-1 ring-slate-300" %>
    <% end %>
    <p class="mt-2 text-xs text-slate-500"><%= t("brands.email_domain.hint") %></p>
  <% else %>
    <p class="mt-1 text-sm">
      <span class="font-mono"><%= brand.email_domain %></span> —
      <strong><%= t("brands.email_domain.statuses.#{brand.email_domain_status}") %></strong>
      <% if brand.email_domain_checked_at %>
        <span class="text-slate-500">(<%= t("brands.email_domain.checked_at", time: l(brand.email_domain_checked_at, format: :short)) %>)</span>
      <% end %>
    </p>
    <p class="mt-1 text-sm"><%= t("brands.email_domain.sender",
      address: brand.email_domain_verified? ? "#{BrandSender::LOCAL_PART}@#{brand.email_domain}" : BrandSender::PLATFORM_ADDRESS) %></p>
    <% unless brand.email_domain_verified? %>
      <p class="mt-3 text-sm"><%= t("brands.email_domain.records_hint") %></p>
    <% end %>
    <% if brand.email_domain_records.any? %>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="py-2 pr-3"><%= t("brands.email_domain.record_type") %></th>
              <th class="py-2 pr-3"><%= t("brands.email_domain.record_name") %></th>
              <th class="py-2"><%= t("brands.email_domain.record_value") %></th>
            </tr>
          </thead>
          <tbody class="font-mono">
            <% brand.email_domain_records.each do |record| %>
              <tr class="border-b border-slate-100 align-top">
                <td class="py-2 pr-3"><%= record["type"] %></td>
                <td class="break-all py-2 pr-3"><%= record["name"] %></td>
                <td class="break-all py-2"><%= record["value"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    <%= form_with url: url, method: :delete, class: "mt-4", data: { confirm: t("brands.email_domain.remove_confirm") } do |form| %>
      <%= form.submit t("brands.email_domain.remove"), class: "rounded-lg px-4 py-2 text-sm text-red-700 ring-1 ring-red-200" %>
    <% end %>
  <% end %>
</section>
