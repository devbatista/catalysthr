<%# Brand fields (RN-01-030). The client company's own brand only takes the name and the colors (RN-01-034) %>
<% fields = local_assigns.fetch(:fields) %>
<% if brand.errors.any? %>
  <div class="alert-bad" role="alert">
    <ul class="list-disc space-y-1 pl-5">
      <% brand.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  </div>
<% end %>

<div class="form-grid">
  <% if fields.include?(:commercial_name) %>
    <div>
      <%= form.label :commercial_name, t("brands.fields.commercial_name"), class: "field-label" %>
      <%= form.text_field :commercial_name, required: true, class: "input" %>
    </div>
  <% end %>
  <% if fields.include?(:short_name) %>
    <div>
      <%= form.label :short_name, t("brands.fields.short_name"), class: "field-label" %>
      <%= form.text_field :short_name, maxlength: 30, class: "input" %>
      <p class="field-hint"><%= t("brands.fields.short_name_hint") %></p>
    </div>
  <% end %>

  <fieldset class="field-full">
    <legend class="field-label"><%= t("brands.fields.colors") %></legend>
    <p class="field-hint"><%= t("brands.fields.colors_hint") %></p>
    <div class="mt-2 form-grid">
      <%# The swatch shows the saved color only, never what was just typed. It is an SVG fill,
          because the CSP blocks style attributes (P-05-29) %>
      <% %i[primary secondary accent].each do |name| %>
        <div>
          <%= form.label :"#{name}_color", t("brands.fields.#{name}_color"), class: "block text-xs font-semibold text-ink-soft" %>
          <div class="mt-1 flex items-center gap-2">
            <span class="inline-block size-8 shrink-0 overflow-hidden rounded-lg border border-line">
              <svg class="block size-full" viewBox="0 0 1 1" aria-hidden="true"><rect width="1" height="1" fill="<%= brand.attribute_in_database(:"#{name}_color").presence || Brand::DEFAULT_COLORS[name] %>"/></svg>
            </span>
            <%= form.text_field :"#{name}_color", placeholder: Brand::DEFAULT_COLORS[name], maxlength: 7, pattern: "#[0-9A-Fa-f]{6}",
              class: "input mt-0 font-mono" %>
          </div>
        </div>
      <% end %>
    </div>
  </fieldset>

  <% if fields.include?(:login_welcome_text) %>
    <div class="field-full">
      <%= form.label :login_welcome_text, t("brands.fields.login_welcome_text"), class: "field-label" %>
      <%= form.text_area :login_welcome_text, rows: 2, maxlength: 300, class: "input" %>
    </div>
  <% end %>
  <% if fields.include?(:support_email) %>
    <div>
      <%= form.label :support_email, t("brands.fields.support_email"), class: "field-label" %>
      <%= form.email_field :support_email, class: "input" %>
    </div>
    <div>
      <%= form.label :support_phone, t("brands.fields.support_phone"), class: "field-label" %>
      <%= form.telephone_field :support_phone, class: "input" %>
    </div>
  <% end %>

  <% if local_assigns[:images].present? %>
    <fieldset class="field-full">
      <legend class="field-label"><%= t("brands.fields.images") %></legend>
      <p class="field-hint"><%= t("brands.fields.images_hint") %></p>
      <div class="mt-2 form-grid">
        <% images.each do |kind| %>
          <div class="rounded-lg border border-line bg-canvas p-3">
            <%= label_tag "brand_images_#{kind}", t("brands.fields.#{kind}"), class: "field-label" %>
            <p class="field-hint"><%= t("brands.fields.#{kind}_hint") %></p>
            <% if brand.persisted? && brand.public_send(kind).attached? %>
              <p class="mt-1 text-xs"><%= t("brands.fields.current_file", name: brand.public_send(kind).filename) %></p>
              <label class="mt-1 flex items-center gap-2 text-xs">
                <%= check_box_tag "remove_images[]", kind, false, id: "remove_images_#{kind}" %>
                <%= t("brands.fields.remove") %>
              </label>
            <% end %>
            <%= file_field_tag "brand_images[#{kind}]", id: "brand_images_#{kind}", accept: Brand::IMAGE_TYPES.join(","),
              class: "mt-2 block w-full text-sm file:mr-3 file:cursor-pointer file:rounded-lg file:border file:border-line-strong file:bg-white file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-ink-strong" %>
          </div>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <% if local_assigns[:company] %>
    <fieldset class="field-wide">
      <legend class="field-label"><%= t("brands.fields.display_mode") %></legend>
      <% %w[alongside replace].each do |mode| %>
        <label class="mt-2 flex items-start gap-2 text-sm">
          <%= radio_button_tag :brand_display_mode, mode, company.brand_display_mode == mode, id: "brand_display_mode_#{mode}" %>
          <span><strong><%= t("brands.display_modes.#{mode}.name") %>:</strong> <%= t("brands.display_modes.#{mode}.hint") %></span>
        </label>
      <% end %>
    </fieldset>
  <% end %>
</div>
