<%# Brand fields (RN-01-030). The client company's own brand only takes the name and the colors (RN-01-034) %>
<% fields = local_assigns.fetch(:fields) %>
<% if brand.errors.any? %>
  <div class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
    <ul class="list-disc space-y-1 pl-5">
      <% brand.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  </div>
<% end %>

<% if fields.include?(:commercial_name) %>
  <div>
    <%= form.label :commercial_name, t("brands.fields.commercial_name"), class: "block text-sm font-medium" %>
    <%= form.text_field :commercial_name, required: true, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </div>
<% end %>
<% if fields.include?(:short_name) %>
  <div>
    <%= form.label :short_name, t("brands.fields.short_name"), class: "block text-sm font-medium" %>
    <%= form.text_field :short_name, maxlength: 30, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2" %>
    <p class="mt-1 text-xs text-slate-500"><%= t("brands.fields.short_name_hint") %></p>
  </div>
<% end %>

<fieldset>
  <legend class="text-sm font-medium"><%= t("brands.fields.colors") %></legend>
  <p class="text-xs text-slate-500"><%= t("brands.fields.colors_hint") %></p>
  <div class="mt-2 grid grid-cols-1 gap-3 sm:grid-cols-3">
    <%# The swatch shows the saved color only, never what was just typed %>
    <% %i[primary secondary accent].each do |name| %>
      <div>
        <%= form.label :"#{name}_color", t("brands.fields.#{name}_color"), class: "block text-sm" %>
        <div class="mt-1 flex items-center gap-2">
          <span class="inline-block h-6 w-6 rounded ring-1 ring-slate-300" style="background: <%= brand.attribute_in_database(:"#{name}_color").presence || Brand::DEFAULT_COLORS[name] %>"></span>
          <%= form.text_field :"#{name}_color", placeholder: Brand::DEFAULT_COLORS[name], maxlength: 7, pattern: "#[0-9A-Fa-f]{6}",
            class: "block w-full rounded-lg border border-slate-300 px-3 py-2 font-mono" %>
        </div>
      </div>
    <% end %>
  </div>
</fieldset>

<% if fields.include?(:login_welcome_text) %>
  <div>
    <%= form.label :login_welcome_text, t("brands.fields.login_welcome_text"), class: "block text-sm font-medium" %>
    <%= form.text_area :login_welcome_text, rows: 2, maxlength: 300, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </div>
<% end %>
<% if fields.include?(:support_email) %>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <div>
      <%= form.label :support_email, t("brands.fields.support_email"), class: "block text-sm font-medium" %>
      <%= form.email_field :support_email, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :support_phone, t("brands.fields.support_phone"), class: "block text-sm font-medium" %>
      <%= form.telephone_field :support_phone, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2" %>
    </div>
  </div>
<% end %>

<% if local_assigns[:images].present? %>
  <fieldset>
    <legend class="text-sm font-medium"><%= t("brands.fields.images") %></legend>
    <p class="text-xs text-slate-500"><%= t("brands.fields.images_hint") %></p>
    <div class="mt-2 space-y-3">
      <% images.each do |kind| %>
        <div class="rounded-lg bg-white p-3 ring-1 ring-slate-200">
          <%= label_tag "brand_images_#{kind}", t("brands.fields.#{kind}"), class: "block text-sm font-medium" %>
          <p class="text-xs text-slate-500"><%= t("brands.fields.#{kind}_hint") %></p>
          <% if brand.persisted? && brand.public_send(kind).attached? %>
            <p class="mt-1 text-xs"><%= t("brands.fields.current_file", name: brand.public_send(kind).filename) %></p>
            <label class="mt-1 flex items-center gap-2 text-xs">
              <%= check_box_tag "remove_images[]", kind, false, id: "remove_images_#{kind}" %>
              <%= t("brands.fields.remove") %>
            </label>
          <% end %>
          <%= file_field_tag "brand_images[#{kind}]", id: "brand_images_#{kind}", accept: Brand::IMAGE_TYPES.join(","),
            class: "mt-2 block w-full text-sm" %>
        </div>
      <% end %>
    </div>
  </fieldset>
<% end %>

<% if local_assigns[:company] %>
  <fieldset>
    <legend class="text-sm font-medium"><%= t("brands.fields.display_mode") %></legend>
    <% %w[alongside replace].each do |mode| %>
      <label class="mt-2 flex items-start gap-2 text-sm">
        <%= radio_button_tag :brand_display_mode, mode, company.brand_display_mode == mode, id: "brand_display_mode_#{mode}" %>
        <span><strong><%= t("brands.display_modes.#{mode}.name") %>:</strong> <%= t("brands.display_modes.#{mode}.hint") %></span>
      </label>
    <% end %>
  </fieldset>
<% end %>
