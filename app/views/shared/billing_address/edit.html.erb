<%# The client's billing address (D-635), in the direct company's and the partner's area. %>
<% content_for :title, t("shared.billing_address.title") %>

<p class="text-sm"><%= link_to t("shared.billing_address.back"), billing_address_invoices_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t("shared.billing_address.title") %></h1>
<p class="page-subtitle"><%= t("shared.billing_address.hint") %> <%= t("shared.billing_address.next_note") %></p>

<%= form_with model: @account, url: billing_address_form_path, method: :patch, class: "card card-body mt-6 space-y-5" do |form| %>
  <%= render "panel/employees/errors", record: @account %>
  <%= render "shared/billing_address/fields", form: form, scope: "billing_account", lookup_url: billing_address_lookup_url %>

  <div class="flex items-center gap-4 border-t border-line-soft pt-5">
    <%= form.submit t("shared.billing_address.submit"), class: "btn btn-primary" %>
    <%= link_to t("shared.billing_address.cancel"), billing_address_invoices_path, class: "link-button text-sm" %>
  </div>
<% end %>
