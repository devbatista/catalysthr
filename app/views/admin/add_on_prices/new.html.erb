<% content_for :title, t(".title", add_on: t("add_ons.names.#{@add_on.code}")) %>

<p class="text-sm"><%= link_to t("admin.plans.show.back"), admin_plans_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title", add_on: t("add_ons.names.#{@add_on.code}")) %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<%= form_with model: @price, scope: :add_on_price, url: admin_add_on_prices_path(@add_on.code), method: :post,
  class: "card card-body mt-6 space-y-5" do |form| %>
  <%= render "admin/plans/errors", records: [ @price ] %>

  <div class="form-grid">
    <div>
      <%= form.label :monthly_price, t(".monthly_price"), class: "field-label" %>
      <%= form.text_field :monthly_price, inputmode: "decimal", placeholder: "0,00", required: true, class: "input w-48" %>
    </div>

    <div>
      <%= form.label :valid_from, t("admin.plans.version_fields.valid_from"), class: "field-label" %>
      <%= form.date_field :valid_from, min: Date.current, required: true, class: "input w-auto" %>
      <p class="field-hint"><%= t("admin.plans.version_fields.valid_from_hint") %></p>
    </div>
  </div>

  <div class="flex items-center gap-4 border-t border-line-soft pt-5">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), admin_plans_path, class: "link-button text-sm" %>
  </div>
<% end %>
