<%# The feature flags, for the superadmin (RN-20-030, D-617) %>
<% content_for :title, t(".title") %>
<% missing = FeatureFlags.missing %>
<% undeclared = FeatureFlags.undeclared %>
<% pills = { on: "pill-ok", off: "pill-mute", conditional: "pill-warn", missing: "pill-bad" } %>

<h1 class="page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<% if missing.any? %>
  <div class="alert-bad mt-6 flex flex-wrap items-center justify-between gap-3" role="alert">
    <span><%= t(".missing", flags: missing.map { |name| t("feature_flags.#{name}.name") }.to_sentence) %></span>
    <%= button_to t(".declare"), declare_admin_feature_flags_path, class: "btn btn-secondary btn-sm" %>
  </div>
<% end %>

<div class="card mt-6 overflow-x-auto">
  <table class="data-table">
    <thead>
      <tr>
        <th><%= t(".flag") %></th>
        <th><%= t(".state") %></th>
        <th class="hidden md:table-cell"><%= t(".last_change") %></th>
        <th class="text-right"><span class="sr-only"><%= t(".actions") %></span></th>
      </tr>
    </thead>
    <tbody>
      <% FeatureFlags::ALL.each do |name| %>
        <% state = FeatureFlags.state(name) %>
        <% change = @last_changes[name.to_s] %>
        <% flag_name = t("feature_flags.#{name}.name") %>
        <tr>
          <td>
            <p class="font-bold text-ink-strong"><%= flag_name %></p>
            <p class="mt-0.5 text-xs text-ink-soft"><%= t("feature_flags.#{name}.description") %></p>
            <p class="mt-1 font-mono text-[11px] text-ink-soft"><%= name %></p>
          </td>
          <td><span class="pill <%= pills.fetch(state) %>"><%= t(".states.#{state}") %></span></td>
          <td class="hidden text-xs text-ink-soft md:table-cell">
            <% if change %>
              <%= t(".change", action: t(".actions_done.#{change.action}"), name: change.changed_by.name,
                date: l(change.created_at, format: :short)) %>
            <% else %>
              <%= t(".no_change") %>
            <% end %>
          </td>
          <td class="text-right">
            <% unless state == :missing %>
              <% if state == :on && FeatureFlags::NOT_OFF_ON_SCREEN.include?(name) %>
                <span class="text-xs text-ink-soft"><%= t(".console_only") %></span>
              <% elsif state == :on %>
                <%= button_to t(".disable"), admin_feature_flag_path(name), method: :patch, params: { state: "off" },
                  class: "btn btn-secondary btn-sm", form: { data: { confirm: t(".disable_confirm", flag: flag_name) } } %>
              <% else %>
                <%= button_to t(".enable"), admin_feature_flag_path(name), method: :patch, params: { state: "on" },
                  class: "btn btn-primary btn-sm", form: { data: { confirm: t(".enable_confirm", flag: flag_name) } } %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if undeclared.any? %>
  <div class="card card-body mt-6">
    <h2 class="text-sm font-bold text-ink-strong"><%= t(".undeclared_title") %></h2>
    <p class="field-hint"><%= t(".undeclared_hint") %></p>
    <ul class="mt-3 divide-y divide-line-soft">
      <% undeclared.each do |name| %>
        <li class="flex flex-wrap items-center justify-between gap-3 py-2">
          <span class="font-mono text-sm"><%= name %></span>
          <%= button_to t(".remove"), admin_feature_flag_path(name), method: :delete, class: "btn btn-danger btn-sm",
            form: { data: { confirm: t(".remove_confirm", flag: name) } } %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
