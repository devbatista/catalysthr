<% content_for :title, t(".title") %>

<h1 class="text-3xl font-bold"><%= t(".title") %></h1>
<p class="mt-2"><%= t(".subtitle") %></p>
<%= render "shared/flash" %>

<p class="mt-6 flex gap-4">
  <% LegalDocument::KINDS.each do |kind| %>
    <%= link_to t(".publish.#{kind}"), new_admin_legal_document_path(kind: kind), class: "rounded-lg bg-brand-primary px-4 py-2 font-semibold text-white" %>
  <% end %>
</p>

<% if @documents.empty? %>
  <p class="mt-6"><%= t(".empty") %></p>
<% else %>
  <ul class="mt-6 space-y-4">
    <% @documents.each do |document| %>
      <li class="rounded-lg bg-white p-4 ring-1 ring-slate-200">
        <details>
          <summary class="cursor-pointer font-semibold">
            <%= t(".item", kind: t("admin.legal_documents.kinds.#{document.kind}"), version: document.version,
              date: l(document.published_at, format: :short), author: document.published_by.name) %>
          </summary>
          <div class="mt-3 text-sm"><%= simple_format(document.body) %></div>
        </details>
      </li>
    <% end %>
  </ul>
<% end %>
