<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<p class="mt-6 flex flex-wrap gap-3">
  <% LegalDocument::KINDS.each do |kind| %>
    <%= link_to t(".publish.#{kind}"), new_admin_legal_document_path(kind: kind), class: "btn btn-primary" %>
  <% end %>
</p>

<% if @documents.empty? %>
  <p class="card card-body mt-6 text-sm text-ink-soft"><%= t(".empty") %></p>
<% else %>
  <ul class="mt-6 max-w-4xl space-y-3">
    <% @documents.each do |document| %>
      <li class="card px-5 py-4">
        <details>
          <summary class="cursor-pointer text-sm font-bold text-ink-strong">
            <%= t(".item", kind: t("admin.legal_documents.kinds.#{document.kind}"), version: document.version,
              date: l(document.published_at, format: :short), author: document.published_by.name) %>
          </summary>
          <div class="mt-3 max-h-96 overflow-y-auto rounded-lg bg-canvas p-4 text-sm"><%= simple_format(document.body) %></div>
        </details>
      </li>
    <% end %>
  </ul>
<% end %>
