<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".instructions") %></p>

<% if @document.errors.any? %>
  <div class="mt-6 alert-bad" role="alert">
    <ul class="list-disc space-y-1 pl-5">
      <% @document.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @document, url: admin_legal_documents_path, class: "card card-body mt-6 max-w-3xl space-y-5" do |form| %>
  <div>
    <%= form.label :kind, class: "field-label" %>
    <%= form.select :kind, LegalDocument::KINDS.map { |kind| [ t("admin.legal_documents.kinds.#{kind}"), kind ] }, {},
      class: "input w-auto" %>
  </div>

  <div>
    <%= form.label :body, class: "field-label" %>
    <%= form.text_area :body, rows: 20, required: true, class: "input" %>
  </div>

  <div class="flex items-center gap-4 border-t border-line-soft pt-5">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), admin_legal_documents_path, class: "link-button text-sm" %>
  </div>
<% end %>
