<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<h2 class="section-title mt-6"><%= t(".pending") %></h2>
<div class="mt-3">
  <%= render "table", adjustments: @pending, client: true %>
</div>

<h2 class="section-title mt-8"><%= t(".recent", limit: Admin::BillingAdjustmentsController::RECENT) %></h2>
<div class="mt-3">
  <%= render "table", adjustments: @recent, client: true %>
</div>
