<% content_for :title, t(".title") %>

<p class="text-sm"><%= link_to t(".back", name: @account.name), admin_client_path(@account), class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle", name: @account.name) %></p>

<%= form_with model: @adjustment, url: admin_client_adjustments_path(@account), scope: :adjustment, class: "card card-body mt-6 space-y-5" do |form| %>
  <% if @adjustment.errors.any? %>
    <div class="alert-bad">
      <ul class="list-disc pl-5">
        <% @adjustment.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <fieldset>
    <legend class="field-label"><%= t(".kind") %></legend>
    <div class="mt-2 grid gap-3 sm:grid-cols-3">
      <% BillingAdjustment::KINDS.each do |kind| %>
        <label class="flex items-start gap-2 rounded-lg border border-line p-3 text-sm">
          <%= form.radio_button :kind, kind, class: "mt-0.5" %>
          <span>
            <span class="font-semibold text-ink-strong"><%= t("billing.adjustment_kinds.#{kind}") %></span>
            <span class="block text-xs text-ink-soft"><%= t(".kinds.#{kind}") %></span>
          </span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="form-grid">
    <div>
      <%= form.label :value, t(".value"), class: "field-label" %>
      <%= form.text_field :value, inputmode: "decimal", placeholder: "0,00", class: "input" %>
      <p class="field-hint"><%= t(".value_hint") %></p>
    </div>
    <div>
      <%= form.label :percent, t(".percent"), class: "field-label" %>
      <%= form.text_field :percent, value: @adjustment.percent && Billing::Adjustments.percent(@adjustment.percent), inputmode: "decimal", placeholder: "10", class: "input" %>
      <p class="field-hint"><%= t(".percent_hint") %></p>
    </div>
    <div>
      <%= form.label :cycles, t(".cycles"), class: "field-label" %>
      <%= form.number_field :cycles, min: 1, max: BillingAdjustment::MAX_CYCLES, class: "input" %>
      <p class="field-hint"><%= t(".cycles_hint") %></p>
    </div>
    <div>
      <%= form.label :overage_scope, t(".overage_scope"), class: "field-label" %>
      <%= form.select :overage_scope, BillingAdjustment::OVERAGE_SCOPES.keys.map { |scope| [ t("billing.adjustments.overage_waiver.#{scope}"), scope ] },
        { include_blank: true }, class: "input" %>
      <p class="field-hint"><%= t(".overage_scope_hint") %></p>
    </div>
    <div class="field-full">
      <%= form.label :reason, t(".reason"), class: "field-label" %>
      <%= form.text_area :reason, rows: 3, maxlength: 1_000, required: true, class: "input" %>
      <p class="field-hint"><%= t(".reason_hint") %></p>
    </div>
  </div>

  <p class="alert-info"><%= t(current_user.superadmin? ? ".approval_superadmin" : ".approval_finance") %></p>

  <div class="flex items-center gap-4 border-t border-line-soft pt-5">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), admin_client_path(@account), class: "link-button text-sm" %>
  </div>
<% end %>
