<%# The assisted import (RN-18-060, RN-18-061, D-666): find the company, direct or of a
    partner, see whether its HR administrator authorized the support and open its imports. %>
<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".instructions") %></p>

<%= form_with url: admin_assisted_imports_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3" do |form| %>
  <div class="flex-1">
    <%= form.label :q, t(".query"), class: "field-label" %>
    <%= form.text_field :q, value: @query, autocomplete: "off", required: true, minlength: 3, class: "input" %>
  </div>
  <%= form.submit t(".search"), class: "btn btn-secondary" %>
<% end %>

<% if @query.length >= 3 && @companies.empty? %>
  <p class="alert-info mt-6"><%= t(".not_found") %></p>
<% end %>

<% @companies.each do |company| %>
  <% authorization = @authorizations[company.id] %>
  <section class="card card-body mt-6 flex flex-wrap items-center justify-between gap-4" data-company="<%= company.id %>">
    <div>
      <h2 class="card-title"><%= company.name %></h2>
      <p class="mt-0.5 font-mono text-xs text-ink-muted"><%= company.formatted_document %></p>
      <p class="mt-2 text-sm <%= authorization ? "text-ink-soft" : "text-bad" %>">
        <%= authorization ? t(".authorized", name: authorization.authorized_by.name, date: l(authorization.valid_until.to_date)) : t(".not_authorized") %>
      </p>
    </div>
    <% if authorization %>
      <%= link_to t(".open"), admin_company_data_imports_path(company), class: "btn btn-primary" %>
    <% end %>
  </section>
<% end %>
