<% content_for :title, t(".title") %>

<p class="text-sm"><%= link_to t(".back", plan: @plan.name), admin_plan_path(@plan), class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle", plan: @plan.name) %></p>

<%= form_with url: admin_plan_versions_path(@plan), method: :post, class: "card card-body mt-6 space-y-5" do |form| %>
  <%= render "admin/plans/errors", records: [ @version ] %>
  <%= render "admin/plans/version_fields", version: @version %>

  <div class="flex items-center gap-4 border-t border-line-soft pt-5">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), admin_plan_path(@plan), class: "link-button text-sm" %>
  </div>
<% end %>
