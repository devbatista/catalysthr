<% content_for :title, t(".title") %>

<p class="text-sm"><%= link_to t(".back"), admin_fiscal_settings_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<%= form_with model: @setting, scope: :fiscal_setting, url: admin_fiscal_settings_path, method: :patch,
  class: "card card-body mt-6 space-y-5" do |form| %>
  <%= render "admin/plans/errors", records: [ @setting ] %>

  <div class="form-grid">
    <div>
      <%= form.label :service_code, t(".service_code"), class: "field-label" %>
      <%= form.text_field :service_code, required: true, maxlength: 20, class: "input" %>
      <p class="field-hint"><%= t(".service_code_hint") %></p>
    </div>

    <div class="field-wide">
      <%= form.label :service_name, t(".service_name"), class: "field-label" %>
      <%= form.text_field :service_name, required: true, maxlength: 255, class: "input" %>
    </div>

    <div>
      <%= form.label :nbs_code, t(".nbs_code"), class: "field-label" %>
      <%= form.text_field :nbs_code, required: true, placeholder: "1.1506.21.00", pattern: '\d\.\d{4}\.\d{2}\.\d{2}', class: "input" %>
      <p class="field-hint"><%= t(".nbs_code_hint") %></p>
    </div>

    <div>
      <%= form.label :operation_indicator_code, t(".operation_indicator_code"), class: "field-label" %>
      <%= form.text_field :operation_indicator_code, required: true, inputmode: "numeric", pattern: '\d{6}', class: "input" %>
      <p class="field-hint"><%= t(".operation_indicator_code_hint") %></p>
    </div>

    <div class="field-full">
      <%= form.label :description, t(".description"), class: "field-label" %>
      <%= form.text_area :description, rows: 2, required: true, class: "input" %>
      <p class="field-hint"><%= t(".description_hint") %></p>
    </div>

    <div class="field-full">
      <%= form.label :observations, t(".observations"), class: "field-label" %>
      <%= form.text_area :observations, rows: 2, required: true, class: "input" %>
    </div>
  </div>

  <fieldset class="border-t border-line-soft pt-5">
    <legend class="field-label"><%= t(".retentions") %></legend>
    <p class="field-hint"><%= t(".retentions_hint") %></p>
    <label class="mt-3 flex items-center gap-2 text-sm">
      <%= form.check_box :retain_iss %>
      <%= t(".retain_iss") %>
    </label>
    <div class="form-grid mt-4">
      <% FiscalSetting::RATES.each do |rate| %>
        <div>
          <%= form.label rate, t(".#{rate}"), class: "field-label" %>
          <%= form.number_field rate, step: "0.01", min: 0, max: 100, required: true, class: "input w-32" %>
        </div>
      <% end %>
    </div>
  </fieldset>

  <div class="flex items-center gap-4 border-t border-line-soft pt-5">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), admin_fiscal_settings_path, class: "link-button text-sm" %>
  </div>
<% end %>
