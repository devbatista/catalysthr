<% content_for :title, t("shared.billing_address.title") %>

<p class="text-sm"><%= link_to t(".back", name: @account.name), admin_client_path(@account), class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t("shared.billing_address.title") %></h1>
<p class="page-subtitle"><%= @account.name %> · <%= @account.owner.legal_name %></p>

<%= form_with model: @account, url: admin_client_billing_address_path(@account), method: :patch,
  class: "card card-body mt-6 space-y-5" do |form| %>
  <%= render "admin/plans/errors", records: [ @account ] %>
  <p class="field-hint"><%= t("shared.billing_address.hint") %> <%= t(".next_note") %></p>
  <%= render "shared/billing_address/fields", form: form, scope: "billing_account", lookup_url: admin_address_lookup_path(postal_code: "CEP") %>

  <div class="flex items-center gap-4 border-t border-line-soft pt-5">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), admin_client_path(@account), class: "link-button text-sm" %>
  </div>
<% end %>
