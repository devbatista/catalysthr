<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".title") %></h1>

<%= form_with url: admin_brands_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3" do |form| %>
  <div class="flex-1">
    <%= form.label :q, t(".query"), class: "field-label" %>
    <%= form.text_field :q, value: @query, class: "input" %>
  </div>
  <%= form.submit t(".search"), class: "btn btn-secondary" %>
<% end %>

<ul class="card mt-6 divide-y divide-line-soft">
  <% @brands.each do |brand| %>
    <li class="px-5 py-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span>
          <span class="font-bold text-ink-strong"><%= brand.commercial_name %></span>
          <span class="ml-2 font-mono text-xs text-ink-muted">
            <%= t(".owners.#{brand.owner_type.underscore}") %> · <%= brand.active_subdomain&.slug || t(".no_subdomain") %>
          </span>
        </span>
        <% if can?(:update, brand) %><%= link_to t(".edit"), edit_admin_brand_path(brand), class: "link-button text-sm" %><% end %>
      </div>
      <% if brand.owner.is_a?(Partner) && brand.owner.companies.any? %>
        <ul class="mt-3 space-y-1.5 border-l-2 border-line-soft pl-4 text-[13px]">
          <% brand.owner.companies.order(:name).each do |company| %>
            <li class="flex items-center justify-between gap-3">
              <span><%= company.name %> <span class="text-ink-muted">(<%= t("brands.display_modes.#{company.brand_display_mode}.name") %>)</span></span>
              <%= link_to t(".company_brand"), edit_admin_company_brand_path(company), class: "link-button text-sm" %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </li>
  <% end %>
</ul>
