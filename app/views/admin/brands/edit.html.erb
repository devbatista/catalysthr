<% content_for :title, @brand.commercial_name %>

<p class="text-sm"><%= link_to t("admin.brands.index.title"), admin_brands_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= @brand.commercial_name %></h1>
<p class="page-subtitle"><%= t("admin.brands.index.owners.#{@brand.owner_type.underscore}") %>: <%= @brand.owner.name %></p>

<%= form_with model: @brand, url: admin_brand_path(@brand), method: :patch, multipart: true, class: "card card-body mt-6 space-y-5" do |form| %>
  <%= render "shared/brands/fields", form: form, brand: @brand, fields: BrandEditing::FIELDS, images: Brands::AttachImages::KINDS %>
  <div class="border-t border-line-soft pt-5"><%= form.submit t("brands.edit.submit"), class: "btn btn-primary" %></div>
<% end %>

<% if FeatureFlags.enabled?(FeatureFlags::BRAND_EMAIL_DOMAIN) && can?(:manage_email_domain, @brand) %>
  <%= render "shared/brands/email_domain", brand: @brand, url: admin_brand_email_domain_path(@brand) %>
<% end %>

<% if can?(:change_slug, @brand) %>
  <section class="card card-body mt-6">
    <h2 class="card-title"><%= t(".slug_title") %></h2>
    <p class="mt-1 text-sm"><%= t(".slug_current", url: @brand.active_subdomain ? @brand.panel_url : "—") %></p>
    <p class="field-hint"><%= t(".slug_hint") %></p>
    <%= form_with url: slug_admin_brand_path(@brand), method: :patch, class: "mt-3 flex flex-wrap items-end gap-3",
      data: { confirm: t(".slug_confirm") } do |form| %>
      <%= form.text_field :slug, value: @brand.active_subdomain&.slug, required: true, pattern: "[a-z0-9-]{3,40}",
        "aria-label": t(".slug_label"), class: "input mt-0 w-64 max-w-full font-mono" %>
      <%= form.submit t(".slug_submit"), class: "btn btn-secondary" %>
    <% end %>
  </section>
<% end %>
