<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".instructions") %></p>

<%= form_with url: admin_users_path, method: :get, class: "mt-6 flex max-w-xl flex-wrap items-end gap-3" do |form| %>
  <div class="flex-1">
    <%= form.label :cpf, t(".cpf"), class: "field-label" %>
    <%= form.text_field :cpf, value: @cpf, autocomplete: "off", required: true,
      class: "input" %>
  </div>
  <%= form.submit t(".search"), class: "btn btn-secondary" %>
<% end %>

<% if @cpf.present? && @user.nil? %>
  <p class="alert-info mt-6 max-w-xl"><%= t(".not_found") %></p>
<% elsif @user %>
  <section class="card card-body mt-6 max-w-2xl space-y-6">
    <div>
      <h2 class="card-title"><%= @user.name %></h2>
      <dl class="details-list mt-4">
        <div><dt><%= t(".email") %></dt><dd><%= @user.email.presence || "—" %> <%= email_status_pill(@user) %></dd></div>
        <div><dt><%= t(".mobile_phone") %></dt><dd><%= @user.mobile_phone.presence || "—" %></dd></div>
        <div><dt><%= t(".mfa") %></dt><dd><%= t(@user.mfa_enabled? ? ".mfa_on" : ".mfa_off") %></dd></div>
        <div><dt><%= t(".status") %></dt><dd><%= t(".statuses.#{@user.status}") %></dd></div>
      </dl>
    </div>

    <div>
      <h3 class="card-title"><%= t(".accesses") %></h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-[13px]">
        <% @user.memberships.where.not(status: "revoked").includes(:organization).each do |membership| %>
          <li><%= membership.organization.name %>: <%= membership.roles.map { |role| t("roles.#{role}") }.join(", ") %>
            (<%= t("membership_statuses.#{membership.status}") %>)</li>
        <% end %>
      </ul>
    </div>

    <% if can?(:correct_contact, @user) %>
      <%= form_with url: contact_admin_user_path(@user), method: :patch, class: "space-y-2" do |form| %>
        <h3 class="card-title"><%= t(".contact") %></h3>
        <p class="field-hint"><%= t(".contact_hint") %></p>
        <%= email_field_tag :email, @user.email, class: "input", "aria-label": t(".email") %>
        <%= telephone_field_tag :mobile_phone, @user.mobile_phone, class: "input", "aria-label": t(".mobile_phone") %>
        <%= text_field_tag :reason, nil, id: "contact_reason", required: true, maxlength: 500, placeholder: t(".reason"),
          class: "input", "aria-label": t(".reason") %>
        <%= form.submit t(".contact_submit"), class: "btn btn-secondary" %>
      <% end %>
    <% end %>

    <% if @user.email_bounced? && can?(:release_email, @user) %>
      <%= form_with url: release_email_admin_user_path(@user), method: :post, class: "space-y-2" do |form| %>
        <h3 class="card-title"><%= t(".release_email") %></h3>
        <p class="field-hint"><%= t(".release_email_hint") %></p>
        <%= text_field_tag :reason, nil, id: "release_reason", required: true, maxlength: 500, placeholder: t(".reason"),
          class: "input", "aria-label": t(".reason") %>
        <%= form.submit t(".release_email_submit"), class: "btn btn-secondary" %>
      <% end %>
    <% end %>

    <% if @user.mfa_enabled? && can?(:reset_mfa, @user) %>
      <%= form_with url: reset_mfa_admin_user_path(@user), method: :post, class: "space-y-2",
        data: { confirm: t(".reset_mfa_confirm") } do |form| %>
        <h3 class="card-title"><%= t(".reset_mfa") %></h3>
        <%= text_field_tag :reason, nil, id: "mfa_reason", required: true, maxlength: 500, placeholder: t(".reason"),
          class: "input", "aria-label": t(".reason") %>
        <%= form.submit t(".reset_mfa_submit"), class: "btn btn-danger" %>
      <% end %>
    <% end %>
  </section>
<% end %>
