<% content_for :title, t(".title") %>

<p class="text-sm"><%= link_to t(".back"), admin_root_path, class: "underline" %></p>
<h1 class="mt-4 text-3xl font-bold"><%= t(".title") %></h1>
<p class="mt-2"><%= t(".instructions") %></p>
<%= render "shared/flash" %>

<%= form_with url: admin_users_path, method: :get, class: "mt-6 flex max-w-xl items-end gap-3" do |form| %>
  <div class="flex-1">
    <%= form.label :cpf, t(".cpf"), class: "block text-sm font-medium" %>
    <%= form.text_field :cpf, value: @cpf, autocomplete: "off", required: true,
      class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </div>
  <%= form.submit t(".search"), class: "rounded-lg px-4 py-2 ring-1 ring-slate-300" %>
<% end %>

<% if @cpf.present? && @user.nil? %>
  <p class="mt-6"><%= t(".not_found") %></p>
<% elsif @user %>
  <section class="mt-8 max-w-2xl space-y-6 rounded-2xl bg-white p-6 ring-1 ring-slate-200">
    <div>
      <h2 class="text-lg font-semibold"><%= @user.name %></h2>
      <dl class="mt-3 grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
        <div><dt class="font-medium"><%= t(".email") %></dt><dd><%= @user.email.presence || "—" %></dd></div>
        <div><dt class="font-medium"><%= t(".mobile_phone") %></dt><dd><%= @user.mobile_phone.presence || "—" %></dd></div>
        <div><dt class="font-medium"><%= t(".mfa") %></dt><dd><%= t(@user.mfa_enabled? ? ".mfa_on" : ".mfa_off") %></dd></div>
        <div><dt class="font-medium"><%= t(".status") %></dt><dd><%= t(".statuses.#{@user.status}") %></dd></div>
      </dl>
    </div>

    <div>
      <h3 class="font-semibold"><%= t(".accesses") %></h3>
      <ul class="mt-2 list-disc pl-5 text-sm">
        <% @user.memberships.where.not(status: "revoked").includes(:organization).each do |membership| %>
          <li><%= membership.organization.name %>: <%= membership.roles.map { |role| t("roles.#{role}") }.join(", ") %>
            (<%= t("membership_statuses.#{membership.status}") %>)</li>
        <% end %>
      </ul>
    </div>

    <% if can?(:correct_contact, @user) %>
      <%= form_with url: contact_admin_user_path(@user), method: :patch, class: "space-y-2" do |form| %>
        <h3 class="font-semibold"><%= t(".contact") %></h3>
        <p class="text-xs text-slate-500"><%= t(".contact_hint") %></p>
        <%= email_field_tag :email, @user.email, class: "block w-full rounded-lg border border-slate-300 px-3 py-2", "aria-label": t(".email") %>
        <%= telephone_field_tag :mobile_phone, @user.mobile_phone, class: "block w-full rounded-lg border border-slate-300 px-3 py-2", "aria-label": t(".mobile_phone") %>
        <%= text_field_tag :reason, nil, id: "contact_reason", required: true, maxlength: 500, placeholder: t(".reason"),
          class: "block w-full rounded-lg border border-slate-300 px-3 py-2", "aria-label": t(".reason") %>
        <%= form.submit t(".contact_submit"), class: "rounded-lg px-4 py-2 ring-1 ring-slate-300" %>
      <% end %>
    <% end %>

    <% if @user.mfa_enabled? && can?(:reset_mfa, @user) %>
      <%= form_with url: reset_mfa_admin_user_path(@user), method: :post, class: "space-y-2",
        data: { confirm: t(".reset_mfa_confirm") } do |form| %>
        <h3 class="font-semibold"><%= t(".reset_mfa") %></h3>
        <%= text_field_tag :reason, nil, id: "mfa_reason", required: true, maxlength: 500, placeholder: t(".reason"),
          class: "block w-full rounded-lg border border-slate-300 px-3 py-2", "aria-label": t(".reason") %>
        <%= form.submit t(".reset_mfa_submit"), class: "rounded-lg px-4 py-2 font-semibold text-red-700 ring-1 ring-red-300" %>
      <% end %>
    <% end %>
  </section>
<% end %>
