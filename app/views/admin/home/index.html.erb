<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".greeting", name: current_user.first_name) %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
  <% [
    ([ t(".brands"), admin_brands_path ] if can?(:read, Brand)),
    ([ t(".impersonate"), new_admin_impersonation_path ] if can?(:create, ImpersonationSession)),
    ([ t(".support_access"), new_admin_support_access_path ] if can?(:create, SupportAccess)),
    ([ t(".users"), admin_users_path ] if can?(:read, User.new)),
    ([ t(".legal_documents"), admin_legal_documents_path ] if can?(:read, LegalDocument)),
    [ t("account.security_link"), account_root_path ]
  ].compact.each do |label, path| %>
    <%= link_to label, path, class: "card card-body text-sm font-bold text-ink-strong no-underline hover:border-brand-primary hover:no-underline" %>
  <% end %>
</div>
