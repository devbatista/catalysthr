<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".greeting", name: current_user.first_name) %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<%# The same items as the menu, already filtered by permission and feature flag. %>
<% admin_navigation.each do |group| %>
  <% items = group.items.reject { |item| item.path == admin_root_path } %>
  <% next if items.empty? %>
  <h2 class="section-title mt-8"><%= group.label %></h2>
  <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
    <% items.each do |item| %>
      <%= link_to item.label, item.path, class: "card card-body text-sm font-bold text-ink-strong no-underline hover:border-brand-primary hover:no-underline" %>
    <% end %>
  </div>
<% end %>

<h2 class="section-title mt-8"><%= t(".account") %></h2>
<div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
  <%= link_to t("account.security_link"), account_root_path, class: "card card-body text-sm font-bold text-ink-strong no-underline hover:border-brand-primary hover:no-underline" %>
</div>
