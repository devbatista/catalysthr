<% content_for :title, t(".title") %>

<h1 class="text-3xl font-bold"><%= t(".title") %></h1>
<%= render "shared/flash" %>
<p class="mt-2 text-lg"><%= t(".greeting", name: current_user.first_name) %></p>
<p class="mt-2"><%= t(".subtitle") %></p>

<% if can?(:read, Brand) %>
  <p class="mt-6"><%= link_to t(".brands"), admin_brands_path, class: "underline" %></p>
<% end %>
<% if can?(:create, ImpersonationSession) %>
  <p class="mt-6"><%= link_to t(".impersonate"), new_admin_impersonation_path, class: "underline" %></p>
<% end %>
<% if can?(:create, SupportAccess) %>
  <p class="mt-2"><%= link_to t(".support_access"), new_admin_support_access_path, class: "underline" %></p>
<% end %>
<% if can?(:read, User.new) %>
  <p class="mt-2"><%= link_to t(".users"), admin_users_path, class: "underline" %></p>
<% end %>

<% if can?(:read, LegalDocument) %>
  <p class="mt-6"><%= link_to t(".legal_documents"), admin_legal_documents_path, class: "underline" %></p>
<% end %>

<p class="mt-2"><%= link_to t("account.security_link"), account_root_path, class: "underline" %></p>

<div class="max-w-xs">
  <%= render "users/shared/sign_out" %>
</div>
