<% content_for :title, t(".title") %>

<p class="text-sm"><%= link_to t(".back"), admin_plan_path(@plan), class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<%= form_with model: @plan, url: admin_plan_path(@plan), method: :patch, class: "card card-body mt-6 space-y-5" do |form| %>
  <%= render "errors", records: [ @plan ] %>

  <div class="form-grid">
    <div>
      <%= form.label :name, t("admin.plans.new.name"), class: "field-label" %>
      <%= form.text_field :name, required: true, maxlength: 120, class: "input" %>
    </div>

    <div>
      <%= form.label :status, t(".status"), class: "field-label" %>
      <%= form.select :status, Plan::STATUSES.map { |status| [ t("billing.plan_statuses.#{status}"), status ] }, {}, class: "input w-auto" %>
      <p class="field-hint"><%= t(".status_hint") %></p>
    </div>
  </div>

  <div class="flex items-center gap-4 border-t border-line-soft pt-5">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), admin_plan_path(@plan), class: "link-button text-sm" %>
  </div>
<% end %>
