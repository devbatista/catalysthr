<% content_for :title, t(".title.#{@plan.kind}") %>

<p class="text-sm"><%= link_to t("admin.plans.show.back"), admin_plans_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title.#{@plan.kind}") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<%= form_with model: @plan, url: admin_plans_path, method: :post, class: "card card-body mt-6 space-y-5" do |form| %>
  <%= render "errors", records: [ @plan, @version ] %>
  <%= form.hidden_field :kind %>

  <div class="form-grid">
    <div>
      <%= form.label :name, t(".name"), class: "field-label" %>
      <%= form.text_field :name, required: true, maxlength: 120, class: "input" %>
    </div>
  </div>

  <%= render "version_fields", version: @version %>

  <div class="flex items-center gap-4 border-t border-line-soft pt-5">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), admin_plans_path, class: "link-button text-sm" %>
  </div>
<% end %>
