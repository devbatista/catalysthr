<nav class="mt-6 flex flex-col items-center gap-2 text-sm">
  <% unless controller_name == "sessions" %>
    <%= link_to t(".sign_in"), new_user_session_path, class: "underline" %>
  <% end %>
  <% unless controller_name == "passwords" %>
    <%= link_to t(".forgot_password"), new_user_password_path, class: "underline" %>
  <% end %>
  <% unless controller_name == "unlocks" %>
    <%= link_to t(".unlock"), new_user_unlock_path, class: "underline" %>
  <% end %>

  <% brand = Current.brand %>
  <% if brand && (brand.support_email.present? || brand.support_phone.present?) %>
    <p class="mt-4 text-center">
      <%= t(".support") %>
      <%= mail_to brand.support_email, class: "underline" if brand.support_email.present? %>
      <%= brand.support_phone %>
    </p>
  <% end %>
</nav>
