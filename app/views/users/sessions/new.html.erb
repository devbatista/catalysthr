<%= form_with model: resource, scope: resource_name, url: user_session_path, class: "mt-6 space-y-4" do |form| %>
  <div>
    <%= form.label :login, t(".login"), class: "field-label" %>
    <%= form.text_field :login, autofocus: true, autocomplete: "username", required: true,
      class: "input" %>
  </div>

  <div>
    <%= form.label :password, t(".password"), class: "field-label" %>
    <%= form.password_field :password, autocomplete: "current-password", required: true,
      class: "input" %>
  </div>

  <%= form.submit t(".submit"), class: "btn btn-primary btn-block" %>
<% end %>
