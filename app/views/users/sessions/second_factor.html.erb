<h1 class="mt-6 text-xl font-semibold"><%= t(".title") %></h1>
<p class="mt-2 text-sm"><%= t(".instructions") %></p>

<%= form_with url: user_second_factor_path, method: :post, class: "mt-6 space-y-4" do |form| %>
  <div>
    <%= form.label :otp_code, t(".code"), class: "block text-sm font-medium" %>
    <%= form.text_field :otp_code, autofocus: true, required: true, autocomplete: "one-time-code", inputmode: "text",
      class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 tracking-widest" %>
  </div>

  <label class="flex items-start gap-2 text-sm">
    <%= form.check_box :remember_device, { class: "mt-1" }, "1", "0" %>
    <span><%= t(".remember_device") %></span>
  </label>

  <%= form.submit t(".submit"), class: "w-full rounded-lg bg-brand-primary px-4 py-3 font-semibold text-white" %>
<% end %>
