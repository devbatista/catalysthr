<h1 class="mt-6 text-xl font-semibold"><%= t(".title") %></h1>
<p class="mt-2 text-sm"><%= t(".rules") %></p>
<%= render "users/shared/error_messages" %>

<%= form_with model: resource, scope: resource_name, url: user_password_path, method: :put, class: "mt-6 space-y-4" do |form| %>
  <%= form.hidden_field :reset_password_token %>

  <div>
    <%= form.label :password, t(".password"), class: "block text-sm font-medium" %>
    <%= form.password_field :password, autofocus: true, autocomplete: "new-password", required: true,
      class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </div>

  <div>
    <%= form.label :password_confirmation, t(".password_confirmation"), class: "block text-sm font-medium" %>
    <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true,
      class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </div>

  <%= form.submit t(".submit"), class: "w-full rounded-lg bg-brand-primary px-4 py-3 font-semibold text-white" %>
<% end %>
