<h1 class="mt-6 text-xl font-semibold"><%= t(".title") %></h1>
<p class="mt-2 text-sm"><%= t(".instructions") %></p>

<%= form_with model: resource, scope: resource_name, url: user_password_path, method: :post, class: "mt-6 space-y-4" do |form| %>
  <div>
    <%= form.label :login, t(".login"), class: "block text-sm font-medium" %>
    <%= form.text_field :login, autofocus: true, autocomplete: "username", required: true,
      class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </div>

  <%= form.submit t(".submit"), class: "w-full rounded-lg bg-brand-primary px-4 py-3 font-semibold text-white" %>
<% end %>
