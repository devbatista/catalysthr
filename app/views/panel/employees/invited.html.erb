<%# The portal's invitation of who still had no access (spec 16, D-600, D-645): who got it
    by e-mail, valid for 72 hours (RN-02-012), and who has no valid e-mail and gets the link
    or the QR code on their record. %>
<% content_for :title, t(".title") %>

<p class="text-sm"><%= link_to t(".back"), employees_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <section class="card card-body space-y-3">
    <h2 class="card-title"><%= t(".sent", count: @sent.size) %></h2>
    <% if @sent.empty? %>
      <p class="text-sm text-ink-soft"><%= t(".none_sent") %></p>
    <% else %>
      <ul class="divide-y divide-line-soft text-sm">
        <% @sent.each do |membership| %>
          <li class="py-2"><%= membership.worker_profile.display_name %> · <span class="text-ink-soft"><%= membership.user.email %></span></li>
        <% end %>
      </ul>
    <% end %>
  </section>
  <section class="card card-body space-y-3">
    <h2 class="card-title"><%= t(".without_email", count: @without_email.size) %></h2>
    <% if @without_email.empty? %>
      <p class="text-sm text-ink-soft"><%= t(".none_without_email") %></p>
    <% else %>
      <p class="field-hint"><%= t(".without_email_hint") %></p>
      <ul class="divide-y divide-line-soft text-sm">
        <% @without_email.each do |membership| %>
          <li class="py-2"><%= link_to membership.worker_profile.display_name, employee_path(membership.worker_profile), class: "link-button" %></li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
