<%# The person's record by the eSocial groups (RN-04-041, D-206). Documents and the
    disability are sensitive (D-086): the page opens after the password and each value goes
    through reveal_confirmed (RN-05-001). The civil name, CPF, birth date and sign-in
    contacts stay in the account (P-04-03). %>
<% content_for :title, t(".title") %>
<% select_options = ->(group, values) { values.map { |value| [ t("worker_profiles.#{group}.#{value}"), value ] } } %>

<p class="text-sm"><%= link_to t(".back", name: @profile.display_name), employee_path(@profile), class: "link-button" %></p>
<h1 class="page-title mt-3"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<%= form_with model: @profile, url: employee_path(@profile), method: :patch, class: "mt-6 max-w-3xl space-y-6" do |form| %>
  <% if @profile.errors.any? %>
    <div class="alert-bad" role="alert">
      <ul class="list-disc space-y-1 pl-5">
        <% @profile.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <section class="card card-body space-y-4">
    <h2 class="card-title"><%= t(".identification") %></h2>
    <div>
      <%= form.label :social_name, t(".social_name"), class: "field-label" %>
      <%= form.text_field :social_name, maxlength: 120, class: "input" %>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :sex, t(".sex"), class: "field-label" %>
        <%= form.select :sex, select_options.("sexes", WorkerProfile::SEXES), { include_blank: true }, class: "input" %>
      </div>
      <div>
        <%= form.label :race, t(".race"), class: "field-label" %>
        <%= form.select :race, select_options.("races", WorkerProfile::RACES), { include_blank: true }, class: "input" %>
      </div>
      <div>
        <%= form.label :marital_status, t(".marital_status"), class: "field-label" %>
        <%= form.select :marital_status, select_options.("marital_statuses", WorkerProfile::MARITAL_STATUSES), { include_blank: true }, class: "input" %>
      </div>
      <div>
        <%= form.label :education_level, t(".education_level"), class: "field-label" %>
        <%= form.select :education_level, select_options.("education_levels", WorkerProfile::EDUCATION_LEVELS), { include_blank: true }, class: "input" %>
      </div>
    </div>
  </section>

  <section class="card card-body space-y-4">
    <h2 class="card-title"><%= t(".birth") %></h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
      <div class="sm:col-span-3">
        <%= form.label :birth_city, t(".birth_city"), class: "field-label" %>
        <%= form.text_field :birth_city, class: "input" %>
      </div>
      <div class="sm:col-span-1">
        <%= form.label :birth_state, t(".state"), class: "field-label" %>
        <%= form.select :birth_state, Unit::STATES, { include_blank: true }, class: "input" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :birth_country, t(".birth_country"), class: "field-label" %>
        <%= form.text_field :birth_country, class: "input" %>
      </div>
      <div class="sm:col-span-3">
        <%= form.label :nationality, t(".nationality"), class: "field-label" %>
        <%= form.text_field :nationality, class: "input" %>
      </div>
    </div>
  </section>

  <section class="card card-body space-y-4">
    <div>
      <h2 class="card-title"><%= t(".documents") %></h2>
      <p class="field-hint"><%= t(".sensitive_hint") %></p>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
      <div class="sm:col-span-2">
        <%= form.label :rg_number, t(".rg_number"), class: "field-label" %>
        <%= form.text_field :rg_number, value: reveal_confirmed(@profile, :rg_number, as: :text, section: :documents), autocomplete: "off", class: "input font-mono" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :rg_issuer, t(".rg_issuer"), class: "field-label" %>
        <%= form.text_field :rg_issuer, class: "input" %>
      </div>
      <div class="sm:col-span-1">
        <%= form.label :rg_state, t(".state"), class: "field-label" %>
        <%= form.select :rg_state, Unit::STATES, { include_blank: true }, class: "input" %>
      </div>
      <div class="sm:col-span-1">
        <%= form.label :rg_issued_on, t(".issued_on"), class: "field-label" %>
        <%= form.date_field :rg_issued_on, class: "input" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :ctps_number, t(".ctps_number"), class: "field-label" %>
        <%= form.text_field :ctps_number, value: reveal_confirmed(@profile, :ctps_number, as: :text, section: :documents), autocomplete: "off", class: "input font-mono" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :ctps_series, t(".ctps_series"), class: "field-label" %>
        <%= form.text_field :ctps_series, class: "input font-mono" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :ctps_state, t(".state"), class: "field-label" %>
        <%= form.select :ctps_state, Unit::STATES, { include_blank: true }, class: "input" %>
      </div>
      <div class="sm:col-span-3">
        <%= form.label :pis_nis, t(".pis_nis"), class: "field-label" %>
        <%= form.text_field :pis_nis, value: reveal_confirmed(@profile, :pis_nis, as: :text, section: :documents), inputmode: "numeric", autocomplete: "off", class: "input font-mono" %>
      </div>
      <div class="sm:col-span-3">
        <%= form.label :voter_id, t(".voter_id"), class: "field-label" %>
        <%= form.text_field :voter_id, value: reveal_confirmed(@profile, :voter_id, as: :text, section: :documents), inputmode: "numeric", autocomplete: "off", class: "input font-mono" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :cnh_number, t(".cnh_number"), class: "field-label" %>
        <%= form.text_field :cnh_number, value: reveal_confirmed(@profile, :cnh_number, as: :text, section: :documents), autocomplete: "off", class: "input font-mono" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :cnh_category, t(".cnh_category"), class: "field-label" %>
        <%= form.select :cnh_category, WorkerProfile::CNH_CATEGORIES, { include_blank: true }, class: "input" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :cnh_expires_on, t(".cnh_expires_on"), class: "field-label" %>
        <%= form.date_field :cnh_expires_on, class: "input" %>
      </div>
      <div class="sm:col-span-3">
        <%= form.label :class_registration, t(".class_registration"), class: "field-label" %>
        <%= form.text_field :class_registration, value: reveal_confirmed(@profile, :class_registration, as: :text, section: :documents), autocomplete: "off", class: "input font-mono" %>
      </div>
      <div class="sm:col-span-3">
        <%= form.label :class_registration_issuer, t(".class_registration_issuer"), class: "field-label" %>
        <%= form.text_field :class_registration_issuer, class: "input" %>
      </div>
      <div class="sm:col-span-3">
        <%= form.label :foreign_registration, t(".foreign_registration"), class: "field-label" %>
        <%= form.text_field :foreign_registration, value: reveal_confirmed(@profile, :foreign_registration, as: :text, section: :documents), autocomplete: "off", class: "input font-mono" %>
      </div>
    </div>
  </section>

  <section class="card card-body space-y-4" data-unit-form data-address-scope="worker_profile">
    <h2 class="card-title"><%= t(".address") %></h2>
    <label class="flex items-center gap-2 text-sm">
      <%= form.check_box :lives_abroad %>
      <%= t(".lives_abroad") %>
    </label>
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <%= form.label :postal_code, t(".postal_code"), class: "field-label" %>
        <%= form.text_field :postal_code, inputmode: "numeric", maxlength: 9, class: "input w-40 font-mono", data: { postal_code: true } %>
      </div>
      <button type="button" class="btn btn-secondary" data-postal-code-lookup data-url="<%= address_lookup_path(postal_code: "CEP") %>"
        data-not-found="<%= t("panel.units.form.postal_code_not_found") %>" data-invalid="<%= t("panel.units.form.postal_code_invalid") %>">
        <%= t("panel.units.form.lookup") %>
      </button>
    </div>
    <p class="field-hint" data-lookup-status aria-live="polite"></p>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
      <div class="sm:col-span-4">
        <%= form.label :street, t(".street"), class: "field-label" %>
        <%= form.text_field :street, class: "input", data: { address_field: "street" } %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :street_number, t(".street_number"), class: "field-label" %>
        <%= form.text_field :street_number, class: "input" %>
      </div>
      <div class="sm:col-span-3">
        <%= form.label :complement, t(".complement"), class: "field-label" %>
        <%= form.text_field :complement, class: "input" %>
      </div>
      <div class="sm:col-span-3">
        <%= form.label :district, t(".district"), class: "field-label" %>
        <%= form.text_field :district, class: "input", data: { address_field: "district" } %>
      </div>
      <div class="sm:col-span-3">
        <%= form.label :city, t(".city"), class: "field-label" %>
        <%= form.text_field :city, class: "input", data: { address_field: "city" } %>
      </div>
      <div class="sm:col-span-1">
        <%= form.label :state, t(".state"), class: "field-label" %>
        <%= form.select :state, Unit::STATES, { include_blank: true }, class: "input", data: { address_field: "state" } %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :ibge_city_code, t(".ibge_city_code"), class: "field-label" %>
        <%= form.text_field :ibge_city_code, inputmode: "numeric", class: "input font-mono", data: { address_field: "ibge_city_code" } %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :foreign_country, t(".foreign_country"), class: "field-label" %>
        <%= form.text_field :foreign_country, class: "input" %>
      </div>
      <div class="sm:col-span-4">
        <%= form.label :foreign_address, t(".foreign_address"), class: "field-label" %>
        <%= form.text_field :foreign_address, class: "input" %>
      </div>
    </div>
    <p class="field-hint"><%= t(".abroad_hint") %></p>
  </section>

  <section class="card card-body space-y-4">
    <h2 class="card-title"><%= t(".foreign") %></h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :arrived_on, t(".arrived_on"), class: "field-label" %>
        <%= form.date_field :arrived_on, class: "input" %>
      </div>
      <div>
        <%= form.label :immigration_condition, t(".immigration_condition"), class: "field-label" %>
        <%= form.select :immigration_condition, select_options.("immigration_conditions", WorkerProfile::IMMIGRATION_CONDITIONS),
          { include_blank: true }, class: "input" %>
      </div>
      <label class="flex items-center gap-2 text-sm"><%= form.check_box :married_to_brazilian %> <%= t(".married_to_brazilian") %></label>
      <label class="flex items-center gap-2 text-sm"><%= form.check_box :brazilian_children %> <%= t(".brazilian_children") %></label>
    </div>
    <p class="field-hint"><%= t(".foreign_hint") %></p>
  </section>

  <section class="card card-body space-y-4">
    <div>
      <h2 class="card-title"><%= t(".disability") %></h2>
      <p class="field-hint"><%= t(".sensitive_hint") %></p>
    </div>
    <% shown = reveal_confirmed(@profile, :disability, as: :text, section: :health, value: disability_summary(@profile)) %>
    <% if impersonating? %>
      <p class="text-sm"><%= shown.presence || "—" %></p>
    <% else %>
      <%= hidden_field_tag "worker_profile[disability_types][]", "", id: nil %>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
        <% WorkerProfile::DISABILITY_TYPES.each do |type| %>
          <label class="flex items-center gap-2 text-sm">
            <%= check_box_tag "worker_profile[disability_types][]", type, @profile.disability_types.include?(type), id: "worker_profile_disability_#{type}" %>
            <%= t("worker_profiles.disability_types.#{type}") %>
          </label>
        <% end %>
      </div>
      <label class="flex items-center gap-2 text-sm">
        <%= hidden_field_tag "worker_profile[disability_rehabilitated]", "0", id: nil %>
        <%= check_box_tag "worker_profile[disability_rehabilitated]", "1", @profile.disability_rehabilitated, id: "worker_profile_disability_rehabilitated" %>
        <%= t(".rehabilitated") %>
      </label>
      <div>
        <%= label_tag "worker_profile_disability_notes", t(".disability_notes"), class: "field-label" %>
        <%= text_area_tag "worker_profile[disability_notes]", @profile.disability_notes, id: "worker_profile_disability_notes", rows: 2, class: "input" %>
      </div>
    <% end %>
  </section>

  <section class="card card-body space-y-4">
    <h2 class="card-title"><%= t(".contact") %></h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :personal_email, t(".personal_email"), class: "field-label" %>
        <%= form.email_field :personal_email, class: "input" %>
      </div>
      <div>
        <%= form.label :personal_phone, t(".personal_phone"), class: "field-label" %>
        <%= form.telephone_field :personal_phone, class: "input" %>
      </div>
    </div>
    <p class="field-hint"><%= t(".contact_hint") %></p>
  </section>

  <% definitions = CustomFieldDefinition.active.ordered.to_a %>
  <% if definitions.any? %>
    <section class="card card-body space-y-4">
      <h2 class="card-title"><%= t(".custom_fields") %></h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <% definitions.each do |definition| %>
          <% name = "worker_profile[custom_fields][#{definition.key}]" %>
          <% id = "worker_profile_custom_#{definition.key}" %>
          <% value = params.dig(:worker_profile, :custom_fields, definition.key) || @profile.custom_field_value(definition) %>
          <div>
            <%= label_tag id, definition.required ? t(".required_label", label: definition.label) : definition.label, class: "field-label" %>
            <% case definition.field_type %>
            <% when "number" %>
              <%= text_field_tag name, value, id: id, inputmode: "decimal", class: "input" %>
            <% when "date" %>
              <%= date_field_tag name, value, id: id, class: "input" %>
            <% when "select" %>
              <%= select_tag name, options_for_select(definition.options, value), include_blank: true, id: id, class: "input" %>
            <% when "boolean" %>
              <%= select_tag name, options_for_select([ [ t(".yes"), "true" ], [ t(".no"), "false" ] ], value.to_s), include_blank: true, id: id, class: "input" %>
            <% else %>
              <%= text_field_tag name, value, id: id, maxlength: 500, class: "input" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <div class="flex items-center gap-4">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), employee_path(@profile), class: "link-button text-sm" %>
  </div>
<% end %>
