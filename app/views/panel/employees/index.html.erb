<% content_for :title, t(".title") %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="page-title"><%= t(".title") %></h1>
  <div class="flex flex-wrap gap-3">
    <%# The portal's invitation of who still has no access (spec 16, D-645). %>
    <% if can?(:invite, Membership) %>
      <%= button_to t(".invite_all"), invite_employees_path, class: "btn btn-secondary", form: { data: { confirm: t(".invite_all_confirm") } } %>
    <% end %>
    <% if can?(:create, WorkerProfile) %>
      <%= link_to t(".new"), new_employee_path, class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<%# The situation filter comes from the HR panel's "Colaboradores ativos" (RN-17-002). %>
<% situation = { situation: @situation }.compact %>
<% if @situation %>
  <p class="mt-5 flex flex-wrap items-center gap-2 text-sm text-ink-soft">
    <span class="pill pill-info"><%= t(".situation_active") %></span>
    <%= link_to t(".clear_situation"), employees_path(params.permit(:unit_id, :client_id)), class: "link-button" %>
  </p>
<% end %>
<nav class="mt-5 flex flex-wrap gap-2" aria-label="<%= t(".filters") %>">
  <% total = @unit_counts.values.sum %>
  <%= link_to t(".all", count: total), employees_path(situation), class: "chip #{"chip-active" if params[:unit_id].blank?}" %>
  <% @units.each do |unit| %>
    <% next unless @unit_counts[unit.id] %>
    <%= link_to "#{unit.name} · #{@unit_counts[unit.id]}", employees_path(situation.merge(unit_id: unit.id)),
      class: "chip #{"chip-active" if params[:unit_id] == unit.id.to_s}" %>
  <% end %>
</nav>
<% if @client_counts&.keys&.compact&.any? %>
  <nav class="mt-2 flex flex-wrap gap-2" aria-label="<%= t(".client_filters") %>">
    <% @client_counts.keys.compact.sort_by(&:name).each do |client| %>
      <%= link_to "#{client.name} · #{@client_counts[client]}", employees_path(params.permit(:unit_id).to_h.merge(situation, client_id: client.id)),
        class: "chip #{"chip-active" if params[:client_id] == client.id.to_s}" %>
    <% end %>
    <% if @no_client_count.positive? %>
      <%= link_to "#{t(".no_client")} · #{@no_client_count}",
        employees_path(params.permit(:unit_id).to_h.merge(situation, client_id: Dashboards::Filter::NO_CLIENT)),
        class: "chip #{"chip-active" if params[:client_id] == Dashboards::Filter::NO_CLIENT}" %>
    <% end %>
  </nav>
<% end %>

<% if @rows.empty? %>
  <p class="card card-body mt-5 text-sm text-ink-soft"><%= t(".empty") %></p>
<% else %>
  <div class="card mt-5 overflow-x-auto">
    <table class="data-table min-w-[720px]">
      <thead>
        <tr>
          <th><%= t(".name") %></th>
          <th><%= t(".position") %></th>
          <th><%= t(".unit") %></th>
          <% if Current.company.uses_allocation_clients %><th><%= t(".client") %></th><% end %>
          <th><%= t(".manager") %></th>
          <th><%= t(".status") %></th>
        </tr>
      </thead>
      <tbody>
        <% @rows.each do |row| %>
          <tr>
            <td>
              <span class="flex items-center gap-2.5">
                <span class="avatar" aria-hidden="true"><%= initials(row.profile.display_name) %></span>
                <%= link_to row.profile.display_name, employee_path(row.profile), class: "link-button font-bold" %>
              </span>
            </td>
            <td><%= row.position&.name || "—" %></td>
            <td><%= row.unit&.name || "—" %></td>
            <% if Current.company.uses_allocation_clients %><td><%= row.revision&.allocation_client&.name || "—" %></td><% end %>
            <td class="text-ink-soft"><%= row.managers.map(&:name).sort.join(", ").presence || "—" %></td>
            <td><%= employment_status_pill(row.employment) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
