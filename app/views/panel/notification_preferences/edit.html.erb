<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<% unless current_user.email_deliverable? %>
  <p class="alert-bad mt-6" role="alert"><%= t(current_user.email_bounced? ? ".email_bounced" : ".email_missing") %></p>
<% end %>

<%= form_with url: notification_preferences_path, method: :patch, class: "mt-6 space-y-6" do |form| %>
  <% if @sections.empty? %>
    <p class="card card-body text-sm text-ink-soft"><%= t(".empty") %></p>
  <% end %>
  <% @sections.each do |section| %>
    <section class="card overflow-hidden">
      <div class="border-b border-line-soft px-5 py-3">
        <h2 class="card-title"><%= section.membership.organization.name %></h2>
      </div>
      <%= render "shared/notifications/channels", types: section.types, name: "preferences[#{section.membership.id}]",
        channels: section.types.to_h { |type| [ type.code, section.preferences[type.code]&.channels || section.defaults[type.code] || type.configurable_channels ] },
        errors: section.preferences.transform_values { |preference| preference.errors.full_messages } %>
    </section>
  <% end %>
  <% if @sections.any? %>
    <div class="flex items-center gap-3">
      <%= form.submit t(".save"), class: "btn btn-primary" %>
      <%= link_to t(".cancel"), root_path, class: "link-button text-sm" %>
    </div>
  <% end %>
<% end %>
