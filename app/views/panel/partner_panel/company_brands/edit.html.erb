<p class="text-sm"><%= link_to t("brands.back_to_portfolio"), partner_root_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t("brands.edit.company_title", company: @company.name) %></h1>
<p class="page-subtitle"><%= t("brands.edit.company_hint") %></p>

<%= form_with model: @brand, url: partner_company_brand_path(@company), method: :patch, multipart: true, class: "card card-body mt-6 space-y-5" do |form| %>
  <%= render "shared/brands/fields", form: form, brand: @brand, fields: Brands::UpdateCompanyBrand::ATTRIBUTES,
    images: Brands::AttachImages::COMPANY_KINDS, company: (@company if can?(:update_brand_display_mode, @company)) %>
  <div class="border-t border-line-soft pt-5"><%= form.submit t("brands.edit.submit"), class: "btn btn-primary" %></div>
<% end %>
