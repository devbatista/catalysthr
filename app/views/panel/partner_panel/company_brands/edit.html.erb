<p class="text-sm"><%= link_to t("brands.back_to_portfolio"), partner_root_path, class: "underline" %></p>
<h1 class="mt-4 text-2xl font-bold"><%= t("brands.edit.company_title", company: @company.name) %></h1>
<p class="mt-2 text-sm"><%= t("brands.edit.company_hint") %></p>

<%= form_with model: @brand, url: partner_company_brand_path(@company), method: :patch, multipart: true, class: "mt-6 max-w-2xl space-y-4" do |form| %>
  <%= render "shared/brands/fields", form: form, brand: @brand, fields: Brands::UpdateCompanyBrand::ATTRIBUTES,
    images: Brands::AttachImages::COMPANY_KINDS, company: (@company if can?(:update_brand_display_mode, @company)) %>
  <%= form.submit t("brands.edit.submit"), class: "rounded-lg bg-brand-primary px-4 py-2 font-semibold text-white" %>
<% end %>
