<p class="text-sm"><%= link_to t("brands.back_to_portfolio"), partner_root_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t("brands.edit.partner_title") %></h1>
<p class="page-subtitle"><%= t("brands.edit.partner_hint") %></p>

<%= form_with model: @brand, url: partner_brand_path, method: :patch, multipart: true, class: "card card-body mt-6 space-y-5" do |form| %>
  <%= render "shared/brands/fields", form: form, brand: @brand, fields: BrandEditing::FIELDS, images: Brands::AttachImages::KINDS %>
  <div class="border-t border-line-soft pt-5"><%= form.submit t("brands.edit.submit"), class: "btn btn-primary" %></div>
<% end %>

<% if FeatureFlags.enabled?(FeatureFlags::BRAND_EMAIL_DOMAIN) && can?(:manage_email_domain, @brand) %>
  <%= render "shared/brands/email_domain", brand: @brand, url: partner_brand_email_domain_path %>
<% end %>
