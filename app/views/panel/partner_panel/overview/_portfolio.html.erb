<%# Carteira e consumo (RN-17-041): the employees and the modules of each company and, for the
    administrator with the billing on, the contract against its band and its status. The AI
    and WhatsApp usage come with their modules (D-657). %>
<% rows = overview.portfolio %>
<% contract = overview.contract if FeatureFlags.enabled?(FeatureFlags::BILLING) && can?(:read_usage, overview.partner) %>
<div class="card">
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 pt-5">
    <h2 class="card-title"><%= t(".title") %></h2>
    <% if contract %>
      <span class="flex flex-wrap items-center gap-2 text-sm text-ink-soft">
        <%= subscription_status_pill(contract[:subscription]) %>
        <% if contract[:peak] %>
          <%= contract[:band] ? t(".contract_band", count: contract[:peak], band: contract[:band]) : t(".contract_peak", count: contract[:peak]) %>
        <% end %>
      </span>
    <% end %>
  </div>
  <div class="mt-3 overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t(".company") %></th>
          <th class="text-right"><%= t(".employees") %></th>
          <th class="hidden md:table-cell"><%= t(".modules") %></th>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <tr>
            <td class="font-bold"><%= row.company.name %></td>
            <td class="text-right"><%= number_with_delimiter(row.employees) %></td>
            <td class="hidden text-sm md:table-cell">
              <%= row.modules.any? ? row.modules.map { |code| t("modules.#{code}") }.to_sentence : t(".no_modules") %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <th><%= t(".total") %></th>
          <th class="text-right"><%= number_with_delimiter(rows.sum(&:employees)) %></th>
          <th class="hidden md:table-cell"></th>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
