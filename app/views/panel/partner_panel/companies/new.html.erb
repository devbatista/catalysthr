<%# Client company registered by the partner's administrator (P-03-14, RN-19-012, D-616) %>
<% content_for :title, t(".title") %>

<p class="text-sm"><%= link_to t(".back"), partner_root_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<% if @registration.contract? %>
  <%= form_with model: @registration, scope: :company, url: partner_companies_path, method: :post,
    class: "card card-body mt-6 space-y-5" do |form| %>
    <%= render "admin/plans/errors", records: [ @registration ] %>

    <fieldset class="space-y-4">
      <legend class="text-sm font-bold text-ink-strong"><%= t(".company") %></legend>
      <div class="form-grid">
        <div class="field-wide">
          <%= form.label :legal_name, t(".legal_name"), class: "field-label" %>
          <%= form.text_field :legal_name, required: true, maxlength: 200, class: "input" %>
        </div>
        <div>
          <%= form.label :commercial_name, t(".commercial_name"), class: "field-label" %>
          <%= form.text_field :commercial_name, required: true, maxlength: 120, class: "input" %>
        </div>
        <div>
          <%= form.label :cnpj, t(".cnpj"), class: "field-label" %>
          <%= form.text_field :cnpj, required: true, maxlength: 18, class: "input font-mono" %>
        </div>
      </div>
    </fieldset>

    <% if @registration.contracted_modules.any? %>
      <div class="border-t border-line-soft pt-5"><fieldset class="space-y-2">
        <legend class="text-sm font-bold text-ink-strong"><%= t(".modules") %></legend>
        <p class="field-hint"><%= t(".modules_hint") %></p>
        <%= hidden_field_tag "company[modules][]", "", id: nil %>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <% @registration.contracted_modules.each do |code| %>
            <label class="flex items-center gap-2 text-sm">
              <%= check_box_tag "company[modules][]", code, Array(@registration.modules).include?(code), id: "company_modules_#{code}" %>
              <%= t("modules.#{code}") %>
            </label>
          <% end %>
        </div>
      </fieldset></div>
    <% end %>

    <div class="border-t border-line-soft pt-5"><fieldset class="space-y-4">
      <legend class="text-sm font-bold text-ink-strong"><%= t(".admin") %></legend>
      <p class="field-hint"><%= t(".admin_hint") %></p>
      <div class="form-grid">
        <div class="field-wide">
          <%= form.label :admin_name, t(".admin_name"), class: "field-label" %>
          <%= form.text_field :admin_name, required: true, maxlength: 120, class: "input" %>
        </div>
        <div>
          <%= form.label :admin_cpf, t(".admin_cpf"), class: "field-label" %>
          <%= form.text_field :admin_cpf, required: true, inputmode: "numeric", maxlength: 14, autocomplete: "off", class: "input font-mono" %>
        </div>
        <div>
          <%= form.label :admin_email, t(".admin_email"), class: "field-label" %>
          <%= form.email_field :admin_email, required: true, class: "input" %>
        </div>
      </div>
    </fieldset></div>

    <div class="flex items-center gap-4 border-t border-line-soft pt-5">
      <%= form.submit t(".submit"), class: "btn btn-primary" %>
      <%= link_to t(".cancel"), partner_root_path, class: "link-button text-sm" %>
    </div>
  <% end %>
<% else %>
  <p class="alert-info mt-6"><%= t(".without_contract") %></p>
<% end %>
