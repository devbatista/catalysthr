<%# The contracted modules the partner turns on or off for a company (RN-19-012, D-616) %>
<% content_for :title, t(".title", company: @company.name) %>
<% enabled = @company.module_settings.select(&:enabled).map(&:module) %>

<p class="text-sm"><%= link_to t(".back"), partner_root_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title", company: @company.name) %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<% if @contracted.any? %>
  <%= form_with scope: :company, url: partner_company_modules_path(@company), method: :patch,
    class: "card card-body mt-6 space-y-5" do |form| %>
    <%= hidden_field_tag "company[modules][]", "", id: nil %>
    <div class="form-grid">
      <% @contracted.each do |code| %>
        <label class="flex items-start gap-3 rounded-lg border border-line p-3 text-sm">
          <%= check_box_tag "company[modules][]", code, enabled.include?(code), id: "company_modules_#{code}", class: "mt-0.5" %>
          <span><strong class="text-ink-strong"><%= t("modules.#{code}") %></strong><br>
            <span class="text-ink-soft"><%= t(".hints.#{code}") %></span></span>
        </label>
      <% end %>
    </div>
    <div class="flex items-center gap-4 border-t border-line-soft pt-5">
      <%= form.submit t(".submit"), class: "btn btn-primary" %>
      <%= link_to t(".cancel"), partner_root_path, class: "link-button text-sm" %>
    </div>
  <% end %>
<% else %>
  <p class="alert-info mt-6"><%= t(".without_modules") %></p>
<% end %>
