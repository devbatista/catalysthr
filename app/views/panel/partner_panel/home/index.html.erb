<h1 class="page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle", partner: partner_membership.organization.name) %></p>

<% if @companies.empty? %>
  <p class="card card-body mt-6 text-sm text-ink-soft"><%= t(".empty") %></p>
<% else %>
  <div class="card mt-6 overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t(".company") %></th>
          <th class="text-right"><span class="sr-only"><%= t(".actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% @companies.each do |company| %>
          <tr>
            <td class="font-bold text-ink-strong"><%= company.name %></td>
            <td>
              <span class="flex flex-wrap items-center justify-end gap-4">
                <% if can?(:update_brand_display_mode, company) %>
                  <%= link_to t(".company_brand"), edit_partner_company_brand_path(company), class: "link-button" %>
                <% end %>
                <% if can?(:read_hr_admin, Membership.new(organization: company, roles: %w[hr_admin])) %>
                  <%= link_to t(".hr_admins"), partner_company_hr_admins_path(company), class: "link-button" %>
                <% end %>
                <% if authorized_companies.include?(company) %>
                  <%= button_to t(".enter"), current_company_path, params: { company_id: company.id }, class: "btn btn-primary btn-sm" %>
                <% end %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
