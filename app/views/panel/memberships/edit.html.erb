<h1 class="text-2xl font-bold"><%= membership_t("edit.title", name: @membership.user.name) %></h1>
<%= render "panel/memberships/errors" %>

<%= form_with url: url_for(action: :update, id: @membership), method: :patch, class: "mt-6 max-w-xl space-y-4" do |form| %>
  <%= render "panel/memberships/roles_fields", scope: "membership", selected_roles: @membership.roles,
    selected_modules: @membership.enabled_modules, selected_company_ids: @membership.partner_membership_companies.map(&:company_id) %>
  <%= form.submit membership_t("edit.submit"), class: "rounded-lg bg-brand-primary px-4 py-2 font-semibold text-white" %>
  <%= link_to membership_t("edit.cancel"), url_for(action: :show, id: @membership), class: "ml-4 underline" %>
<% end %>
