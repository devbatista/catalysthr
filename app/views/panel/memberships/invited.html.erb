<% membership = @invitation.membership %>
<h1 class="text-2xl font-bold"><%= t(".title", name: membership.user.name) %></h1>
<p class="mt-2"><%= t(".validity", date: l(membership.invitation_expires_at, format: :long)) %></p>

<% if membership.invitation_channels.include?("email") %>
  <p class="mt-2"><%= t(".email_sent", email: membership.user.email) %></p>
<% end %>

<% if membership.invitation_channels.include?("link") %>
  <section class="mt-6 rounded-2xl bg-white p-6 ring-1 ring-slate-200">
    <h2 class="font-semibold"><%= t(".link_title") %></h2>
    <p class="mt-2 text-sm"><%= t(".link_instructions") %></p>
    <p class="mt-3 break-all font-mono text-sm"><%= @invitation.link %></p>
    <div class="mt-4 w-48 rounded-lg bg-white p-2 ring-1 ring-slate-200"><%= qr_code_svg(@invitation.link) %></div>
  </section>
<% end %>

<p class="mt-6"><%= link_to t(".back"), memberships_path, class: "underline" %></p>
