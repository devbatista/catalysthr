<% membership = @invitation.membership %>
<h1 class="page-title"><%= membership_t("invited.title", name: membership.user.name) %></h1>
<p class="page-subtitle"><%= membership_t("invited.validity", date: l(membership.invitation_expires_at, format: :long)) %></p>

<% if membership.invitation_channels.include?("email") %>
  <p class="alert-ok mt-6"><%= membership_t("invited.email_sent", email: membership.user.email) %></p>
<% end %>

<% if membership.invitation_channels.include?("link") %>
  <section class="card card-body mt-6">
    <h2 class="card-title"><%= membership_t("invited.link_title") %></h2>
    <p class="mt-2 text-sm"><%= membership_t("invited.link_instructions") %></p>
    <p class="mt-3 rounded-lg bg-canvas px-3 py-2 font-mono text-xs break-all"><%= @invitation.link %></p>
    <div class="mt-4 w-48 rounded-lg border border-line bg-white p-2"><%= qr_code_svg(@invitation.link) %></div>
  </section>
<% end %>

<p class="mt-6"><%= link_to membership_t("invited.back"), url_for(action: :index), class: "btn btn-secondary" %></p>
