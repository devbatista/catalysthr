<% user = @membership.user %>
<p class="text-sm"><%= link_to membership_t("show.back"), url_for(action: :index), class: "link-button" %></p>
<div class="mt-3 flex flex-wrap items-center gap-3">
  <h1 class="page-title"><%= user.name %></h1>
  <%= membership_status_pill(@membership.status) %>
</div>
<%= render "panel/memberships/errors" %>

<div class="card card-body mt-6 max-w-3xl">
  <dl class="details-list">
    <div><dt><%= membership_t("show.roles") %></dt><dd><%= @membership.roles.map { |role| t("roles.#{role}") }.join(", ") %></dd></div>
    <div><dt><%= membership_t("show.status") %></dt><dd><%= t("membership_statuses.#{@membership.status}") %></dd></div>
    <% if @membership.enabled_modules.any? %>
      <div><dt><%= membership_t("show.modules") %></dt><dd><%= @membership.enabled_modules.map { |mod| t("modules.#{mod}") }.join(", ") %></dd></div>
    <% end %>
    <% if assignable_units && @membership.roles.include?("hr_analyst") %>
      <div><dt><%= membership_t("show.units") %></dt><dd><%= Unit.joins(:membership_units).merge(MembershipUnit.where(membership: @membership)).ordered.map(&:name).join(", ").presence || "—" %></dd></div>
    <% end %>
    <% if @membership.roles.include?("consultant") %>
      <div><dt><%= membership_t("show.companies") %></dt><dd><%= @membership.assigned_companies.where(partner_id: @membership.organization_id).order(:name).map(&:name).join(", ").presence || "—" %></dd></div>
    <% end %>
    <div><dt><%= membership_t("show.email") %></dt><dd><%= user.email.presence || "—" %></dd></div>
    <div><dt><%= membership_t("show.mobile_phone") %></dt><dd><%= user.mobile_phone.presence || "—" %></dd></div>
    <div><dt><%= membership_t("show.mfa") %></dt><dd><%= membership_t(user.mfa_enabled? ? "show.mfa_on" : "show.mfa_off") %></dd></div>
  </dl>

  <% if may_manage_membership?(:update, @membership) %>
    <p class="mt-5 border-t border-line-soft pt-4"><%= link_to membership_t("show.edit"), url_for(action: :edit, id: @membership), class: "btn btn-secondary" %></p>
  <% end %>
</div>

<div class="mt-6 max-w-3xl space-y-6">
  <% if @membership.invited? && may_manage_membership?(:resend_invitation, @membership) %>
    <%= form_with url: url_for(action: :resend_invitation, id: @membership), method: :post, class: "card card-body space-y-2" do |form| %>
      <p class="card-title"><%= membership_t("show.resend") %></p>
      <% Membership::INVITATION_CHANNELS.each do |channel| %>
        <label class="flex items-center gap-2 text-sm">
          <%= check_box_tag "channels[]", channel, channel == "email" && user.email.present?, id: "resend_channel_#{channel}" %>
          <%= t("invitation_channels.#{channel}") %>
        </label>
      <% end %>
      <div class="pt-2"><%= form.submit membership_t("show.resend_submit"), class: "btn btn-secondary" %></div>
    <% end %>
  <% end %>

  <% if may_manage_membership?(:correct_contact, @membership) %>
    <%= form_with url: url_for(action: :contact, id: @membership), method: :patch, class: "card card-body space-y-2" do |form| %>
      <p class="card-title"><%= membership_t("show.contact") %></p>
      <p class="field-hint"><%= membership_t("show.contact_hint") %></p>
      <%= email_field_tag :email, user.email, class: "input", "aria-label": membership_t("show.email") %>
      <%= telephone_field_tag :mobile_phone, user.mobile_phone, class: "input", "aria-label": membership_t("show.mobile_phone") %>
      <div class="pt-2"><%= form.submit membership_t("show.contact_submit"), class: "btn btn-secondary" %></div>
    <% end %>
  <% elsif membership_permission(:correct_contact) && may_manage_membership?(:update, @membership) %>
    <p class="text-sm text-ink-muted"><%= membership_t("show.support_only") %></p>
  <% end %>

  <% reset_mfa = user.mfa_enabled? && may_manage_membership?(:reset_mfa, @membership) %>
  <% remove = may_manage_membership?(@membership.invited? ? :cancel_invitation : :revoke, @membership) %>
  <% if reset_mfa || remove %>
    <div class="flex flex-wrap gap-3">
      <% if reset_mfa %>
        <%= button_to membership_t("show.reset_mfa"), url_for(action: :reset_mfa, id: @membership), method: :post,
          class: "btn btn-secondary", form: { data: { confirm: membership_t("show.reset_mfa_confirm") } } %>
      <% end %>
      <% if remove %>
        <%= button_to membership_t(@membership.invited? ? "show.cancel_invitation" : "show.revoke"), url_for(action: :destroy, id: @membership), method: :delete,
          class: "btn btn-danger", form: { data: { confirm: membership_t("show.revoke_confirm") } } %>
      <% end %>
    </div>
  <% end %>
</div>
