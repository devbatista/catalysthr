<h1 class="text-2xl font-bold"><%= t(".title") %></h1>
<p class="mt-2 text-sm"><%= t(".instructions") %></p>
<%= render "errors" %>

<%= form_with url: memberships_path, method: :post, class: "mt-6 max-w-xl space-y-4" do |form| %>
  <% [ [ :name, :text_field, "name" ], [ :cpf, :text_field, "off" ], [ :email, :email_field, "email" ], [ :mobile_phone, :telephone_field, "tel" ] ].each do |field, type, autocomplete| %>
    <div>
      <%= label_tag "invitation_#{field}", t(".#{field}"), class: "block text-sm font-medium" %>
      <%= public_send("#{type}_tag", "invitation[#{field}]", @form[field], id: "invitation_#{field}", autocomplete: autocomplete,
        required: field.in?(%i[name cpf]), class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2") %>
    </div>
  <% end %>

  <%= render "roles_fields", scope: "invitation", selected_roles: @form[:roles], selected_modules: @form[:enabled_modules] %>

  <fieldset>
    <legend class="text-sm font-medium"><%= t(".channels") %></legend>
    <% Membership::INVITATION_CHANNELS.each do |channel| %>
      <label class="mt-2 flex items-center gap-2 text-sm">
        <%= check_box_tag "invitation[channels][]", channel, @form[:channels].include?(channel), id: "invitation_channel_#{channel}" %>
        <%= t("invitation_channels.#{channel}") %>
      </label>
    <% end %>
  </fieldset>

  <%= form.submit t(".submit"), class: "rounded-lg bg-brand-primary px-4 py-2 font-semibold text-white" %>
  <%= link_to t(".cancel"), memberships_path, class: "ml-4 underline" %>
<% end %>
