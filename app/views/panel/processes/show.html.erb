<%# A process under way (spec 06, D-641), the page specs 07 and 09 reuse: the checklist as
    in the prototype (item, responsible, date, status), the alerts of RN-06-022 and
    RN-06-036, the HR's end and cancel (RN-06-053) and the history (RN-06-051). The manager
    and the client manager see only their items (RN-03-014). Inline forms use <details>,
    without JavaScript (D-022). %>
<% title = process_title(@instance) %>
<% content_for :title, title %>
<% today = @instance.today %>
<% editable = @hr && @instance.open? %>

<div class="flex flex-wrap items-center gap-3">
  <h1 class="page-title"><%= title %></h1>
  <%= process_status_pill(@instance) %>
  <% if @hr && @instance.ready_to_complete? %><span class="pill pill-ok"><%= t(".ready") %></span><% end %>
</div>
<p class="page-subtitle">
  <%= t(".started", name: @instance.started_by.name, date: l(@instance.created_at, format: "%d/%m/%Y")) %>
  <% if @instance.template %> · <%= t(".from_template", name: @instance.template.name) %><% end %>
</p>

<% if @admission && can?(:read_summary, @admission) %>
  <p class="mt-3 text-sm"><%= link_to t(".admission"), admission_path(@admission), class: "link-button" %></p>
<% end %>

<% if @hr %>
  <% if @instance.responsible_alert? %>
    <p class="alert-bad mt-6" role="alert"><%= t(".responsible_alert") %></p>
  <% end %>
  <% if @instance.open? && (changes = @instance.subject_changes).any? %>
    <p class="alert-info mt-6"><%= t(".subject_changed", fields: changes.map { |key| t(".snapshot.#{key}") }.to_sentence) %></p>
  <% end %>
  <% if @instance.cancelled? %>
    <p class="alert-info mt-6"><%= t(".cancelled_reason", name: @instance.cancelled_by&.name, reason: @instance.cancel_reason) %></p>
  <% end %>
<% end %>

<div class="card card-body mt-6">
  <dl class="details-list">
    <div><dt><%= t(".person") %></dt><dd><%= @instance.subject.worker_profile.display_name %></dd></div>
    <div><dt><%= t(".unit") %></dt><dd><%= @instance.unit&.name || "—" %></dd></div>
    <% process_anchor_dates(@instance).each do |label, value| %>
      <div><dt><%= label %></dt><dd><%= value %></dd></div>
    <% end %>
    <% if @instance.completed? %>
      <div><dt><%= t(".completed_at") %></dt><dd><%= l(@instance.completed_at, format: "%d/%m/%Y %H:%M") %><%= " · #{@instance.completed_by.name}" if @instance.completed_by %></dd></div>
    <% end %>
  </dl>

  <% if editable && @admission.nil? %>
    <div class="mt-5 flex flex-wrap items-start gap-3 border-t border-line-soft pt-4">
      <% if @instance.ready_to_complete? %>
        <%= button_to t(".complete"), complete_process_path(@instance), method: :patch, class: "btn btn-primary",
          form: { data: { confirm: t(".complete_confirm") } } %>
      <% else %>
        <p class="field-hint self-center"><%= t(".not_ready") %></p>
      <% end %>
      <details class="w-full sm:w-auto">
        <summary class="btn btn-danger"><%= t(".cancel") %></summary>
        <%= form_with url: cancel_process_path(@instance), method: :patch, class: "mt-3 space-y-3 sm:w-96" do |form| %>
          <%= form.label :cancel_reason, t(".cancel_reason"), class: "field-label" %>
          <%= form.text_area :cancel_reason, rows: 3, required: true, maxlength: 2000, class: "input" %>
          <%= form.submit t(".cancel_submit"), class: "btn btn-danger", data: { confirm: t(".cancel_confirm") } %>
        <% end %>
      </details>
    </div>
  <% end %>
</div>

<section id="items" class="card card-body mt-6 space-y-4">
  <h2 class="card-title"><%= t(@hr ? ".items" : ".my_items", count: @items.size) %></h2>

  <% if @items.empty? %>
    <p class="text-sm text-ink-soft"><%= t(".no_items") %></p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t(".item") %></th>
            <th class="hidden md:table-cell"><%= t(".responsible") %></th>
            <th class="hidden md:table-cell"><%= t(".due") %></th>
            <th class="hidden lg:table-cell"><%= t(".status") %></th>
          </tr>
        </thead>
        <tbody>
          <% @items.each_with_index do |item, index| %>
            <tr>
              <td>
                <span class="font-mono text-xs text-ink-muted"><%= item.position %>.</span>
                <span class="font-bold text-ink-strong"><%= item.title %></span>
                <span class="mt-1 flex flex-wrap gap-1">
                  <span class="pill pill-info"><%= t("process_templates.item_kinds.#{item.kind}") %></span>
                  <span class="pill pill-mute"><%= t("process_templates.items.#{item.required ? "required" : "optional"}") %></span>
                  <span class="contents lg:hidden"><%= process_item_pills(item, today) %></span>
                </span>
                <% if item.instructions %><p class="mt-1 text-xs text-ink-soft whitespace-pre-line"><%= item.instructions %></p><% end %>
                <% if item.blocked? %>
                  <p class="mt-1 text-xs text-ink-soft"><%= t(".waiting_for", items: item.depends_on.map(&:title).to_sentence) %></p>
                <% end %>
                <% if @hr && item.responsible_fallback && item.open? %>
                  <p class="mt-1 text-xs text-bad"><%= t(".fallback", role: t("process_templates.roles.#{item.responsible_role}")) %></p>
                <% end %>
                <%= render "panel/processes/item_result", item: item %>
                <div class="mt-1 space-y-0.5 text-xs text-ink-soft md:hidden">
                  <p><%= responsible_names(item, @people) %> · <%= process_item_due(item) %></p>
                </div>
                <%= render "panel/processes/item_actions", item: item, index: index, editable: editable %>
              </td>
              <td class="hidden md:table-cell"><%= responsible_names(item, @people) %></td>
              <td class="hidden md:table-cell"><%= process_item_due(item) %></td>
              <td class="hidden lg:table-cell"><span class="flex flex-wrap gap-1"><%= process_item_pills(item, today) %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if editable %>
    <div class="border-t border-line-soft pt-4">
      <h3 class="text-sm font-bold text-ink-strong"><%= t(".new_item") %></h3>
      <div class="mt-3 flex flex-wrap gap-2">
        <% ProcessItem::ADDABLE_KINDS.each do |kind| %>
          <%= link_to t("process_templates.item_kinds.#{kind}"), new_process_item_path(@instance, kind: kind), class: "btn btn-secondary btn-sm" %>
        <% end %>
      </div>
    </div>
  <% end %>
</section>

<% if @hr %>
  <section class="card card-body mt-6 space-y-4">
    <h2 class="card-title"><%= t(".history") %></h2>
    <ol class="space-y-3">
      <% @events.each do |event| %>
        <li class="border-l-2 border-line-soft pl-3 text-sm">
          <p class="text-ink-strong"><%= process_event_text(event) %></p>
          <p class="text-xs text-ink-soft"><%= l(event.created_at, format: "%d/%m/%Y %H:%M") %> · <%= event.actor&.name || t(".system") %></p>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
