<%# What can be done on an item (D-641): who answers for it, or the HR, resolves a task, an
    approval or (the HR) a forward; the HR also edits, moves, skips and removes. %>
<% actor = @instance.open? && item.pending? && can?(:act, item) %>
<% refused = editable && item.rejected? && @instance.admission? %>
<%# The HR records a forward also after sending it to the firm (D-652). %>
<% recordable = @instance.open? && item.forward? && @hr && (actor || (item.sent? && can?(:adjust, @instance))) %>
<% firm = linked_firm if actor && item.forward? && @hr && @instance.admission? %>
<% if (actor && item.panel_kind?) || recordable || (editable && item.open?) || refused %>
  <div class="mt-3 flex flex-wrap items-start gap-2">
    <% if actor && item.task? %>
      <details class="w-full sm:w-auto">
        <summary class="btn btn-primary btn-sm"><%= t("processes.actions.done") %></summary>
        <%= form_with url: done_process_item_path(@instance, item), method: :patch, class: "mt-2 space-y-2 sm:w-80" do |form| %>
          <%= form.label :comment, t("processes.actions.comment"), class: "field-label", for: "comment_#{item.id}" %>
          <%= form.text_area :comment, id: "comment_#{item.id}", rows: 2, maxlength: 2000, class: "input" %>
          <%= form.submit t("processes.actions.done_submit"), class: "btn btn-primary btn-sm" %>
        <% end %>
      </details>
    <% elsif actor && item.approval? %>
      <%= button_to t("processes.actions.approve"), approve_process_item_path(@instance, item), method: :patch, class: "btn btn-primary btn-sm",
        form: { data: { confirm: t("processes.actions.approve_confirm", title: item.title) } } %>
      <details class="w-full sm:w-auto">
        <summary class="btn btn-danger btn-sm"><%= t("processes.actions.reject") %></summary>
        <%= form_with url: reject_process_item_path(@instance, item), method: :patch, class: "mt-2 space-y-2 sm:w-80" do |form| %>
          <%= form.label :reason, t("processes.actions.reason"), class: "field-label", for: "reason_#{item.id}" %>
          <%= form.text_area :reason, id: "reason_#{item.id}", rows: 2, required: true, maxlength: 2000, class: "input" %>
          <%= form.submit t("processes.actions.reject_submit"), class: "btn btn-danger btn-sm" %>
        <% end %>
      </details>
    <% elsif recordable %>
      <% if firm %>
        <%= button_to t("processes.actions.send_to_firm"), send_to_firm_process_item_path(@instance, item), method: :patch, class: "btn btn-primary btn-sm",
          form: { data: { confirm: t("processes.actions.send_to_firm_confirm", firm: firm.name) } } %>
      <% end %>
      <details class="w-full sm:w-auto">
        <summary class="btn <%= firm || item.sent? ? "btn-secondary" : "btn-primary" %> btn-sm"><%= t("processes.actions.forward") %></summary>
        <%= form_with url: forward_process_item_path(@instance, item), method: :patch, multipart: true, class: "mt-2 space-y-2 sm:w-80" do |form| %>
          <p class="field-hint"><%= t("processes.actions.forward_hint") %></p>
          <%= form.label :sent_on, t("processes.actions.sent_on"), class: "field-label", for: "sent_on_#{item.id}" %>
          <%= form.date_field :sent_on, id: "sent_on_#{item.id}", required: true, max: @instance.today, value: @instance.today, class: "input" %>
          <%= form.label :receipt, t("processes.actions.receipt"), class: "field-label", for: "receipt_#{item.id}" %>
          <%= form.file_field :receipt, id: "receipt_#{item.id}", required: true, accept: FileSignature::SIGNATURES.keys.join(","), class: "input" %>
          <%= form.submit t("processes.actions.forward_submit"), class: "btn btn-primary btn-sm" %>
        <% end %>
      </details>
    <% end %>

    <%# A refused approval: the HR gives it back to who answers for it, or skips it with a
        reason; cancelling is on the admission's page (RN-07-083, D-648). %>
    <% if refused %>
      <%= button_to t("processes.actions.reopen"), reopen_process_item_path(@instance, item), method: :patch, class: "btn btn-secondary btn-sm" %>
    <% end %>
    <% if editable && (item.open? || refused) %>
      <% if item.open? && index.positive? %>
        <%= button_to "↑", move_process_item_path(@instance, item, direction: "up"), method: :patch, class: "btn btn-secondary btn-sm",
          title: t("processes.actions.up"), "aria-label": t("processes.actions.up") %>
      <% end %>
      <% if item.open? && index < @items.size - 1 %>
        <%= button_to "↓", move_process_item_path(@instance, item, direction: "down"), method: :patch, class: "btn btn-secondary btn-sm",
          title: t("processes.actions.down"), "aria-label": t("processes.actions.down") %>
      <% end %>
      <% if item.open? %><%= link_to t("processes.actions.edit"), edit_process_item_path(@instance, item), class: "btn btn-secondary btn-sm" %><% end %>
      <%# The CLT's ASO is never skipped nor removed (P-07-11). %>
      <% unless Admissions::Aso.required_item?(item) %>
      <details class="w-full sm:w-auto">
        <summary class="btn btn-secondary btn-sm"><%= t("processes.actions.skip") %></summary>
        <%= form_with url: skip_process_item_path(@instance, item), method: :patch, class: "mt-2 space-y-2 sm:w-80" do |form| %>
          <%= form.label :skipped_reason, t("processes.actions.skip_reason"), class: "field-label", for: "skipped_reason_#{item.id}" %>
          <%= form.text_area :skipped_reason, id: "skipped_reason_#{item.id}", rows: 2, required: item.required, maxlength: 2000, class: "input" %>
          <p class="field-hint"><%= t("processes.actions.skip_hint.#{item.required ? "required" : "optional"}") %></p>
          <%= form.submit t("processes.actions.skip_submit"), class: "btn btn-secondary btn-sm" %>
        <% end %>
      </details>
      <%= button_to t("processes.actions.remove"), process_item_path(@instance, item), method: :delete, class: "btn btn-danger btn-sm",
        form: { data: { confirm: t("processes.actions.remove_confirm", title: item.title) } } %>
      <% end %>
    <% end %>
  </div>
<% end %>
