<%# What was recorded on the item: the comment, the reason of a rejection or of a skip, the
    forward's date and receipt, and the acknowledgement's PDF (RN-06-010, RN-06-066,
    P-06-17). %>
<% result = item.result %>
<% if item.completed_at && item.resolved? || item.rejected? %>
  <p class="mt-1 text-xs text-ink-soft">
    <%= t("processes.result.by", name: item.completed_by&.name || t("panel.processes.show.system"), date: l(item.completed_at, format: "%d/%m/%Y %H:%M")) %>
  </p>
<% end %>
<% if result["comment"] %><p class="mt-1 text-xs text-ink-soft"><%= t("processes.result.comment", text: result["comment"]) %></p><% end %>
<% if result["reason"] %><p class="mt-1 text-xs text-bad"><%= t("processes.result.rejected", text: result["reason"]) %></p><% end %>
<% if item.skipped? && item.skipped_reason %><p class="mt-1 text-xs text-ink-soft"><%= t("processes.result.skipped", text: item.skipped_reason) %></p><% end %>
<% if result["sent_at"] %>
  <p class="mt-1 text-xs text-ink-soft">
    <%= t("processes.result.sent_to_firm", firm: result["accounting_firm_name"], date: l(Time.iso8601(result["sent_at"]).in_time_zone, format: "%d/%m/%Y %H:%M")) %>
    <% if item.sent? %> · <%= t("processes.result.waiting_firm") %><% end %>
  </p>
<% end %>
<% if result["sent_on"] %>
  <p class="mt-1 text-xs text-ink-soft">
    <%= t("processes.result.sent_on", date: l(Date.iso8601(result["sent_on"]), format: "%d/%m/%Y")) %>
    <% if @hr && item.forward_receipt.attached? %>
      <% status = item.forward_receipt.blob.file_scan&.status || "scanning" %>
      · <% if status == "clean" %><%= link_to t("processes.result.receipt"), receipt_process_item_path(@instance, item), class: "link-button", target: "_blank", rel: "noopener" %><% else %><%= t("process_templates.materials.scan.#{status}") %><% end %>
    <% end %>
  </p>
<% end %>
<% if item.acknowledgement? %>
  <% material = item.material %>
  <p class="mt-1 text-xs text-ink-soft">
    <% if material&.clean? %>
      <%= link_to t("process_templates.materials.in_use", version: material.version), material_process_item_path(@instance, item),
        class: "link-button", target: "_blank", rel: "noopener" %> ·
    <% end %>
    <%= t("processes.portal_only") %>
  </p>
<% elsif item.document? %>
  <%# The document sent for the item, approved by the HR in the folder (RN-06-010, D-642). %>
  <% document = Document.kept.find_by(source_ref: item) %>
  <% waiting = @hr && @instance.open? && item.status.in?(%w[pending correction_requested]) %>
  <p class="mt-1 text-xs text-ink-soft">
    <% if document && can?(:read, document) %>
      <%= link_to t("processes.result.document"), document_path(document), class: "link-button" %> ·
    <% end %>
    <% if waiting && document && can?(:upload, document) %>
      <%= link_to t("processes.actions.send_version"), new_document_version_path(document), class: "link-button" %> ·
    <% elsif waiting && document.nil? && can?(:upload, Document) %>
      <%= link_to t("processes.actions.send_document"), new_employee_document_path(@instance.subject.worker_profile,
        document_type_id: item.config["document_type_id"], process_item_id: item.id), class: "link-button" %> ·
    <% end %>
    <%= t("processes.document_hint") %>
  </p>
<% elsif item.form? %>
  <%# The HR fills, reviews and applies (RN-06-031, D-649). %>
  <p class="mt-1 text-xs text-ink-soft">
    <% if @hr && @instance.open? && item.status.in?(Processes::FormItem::APPLICABLE) %>
      <%= link_to t(item.submitted? ? "processes.form.review" : "processes.form.fill"), edit_process_item_form_path(@instance, item), class: "link-button" %> ·
    <% end %>
    <%= item.done? ? t("processes.form.applied", count: item.result["applied"].to_i) : t("processes.form.applied_hint") %>
  </p>
<% end %>
