<%# The admission's invitation out (RN-07-020): the e-mail sent, or the link and the QR code
    to hand out, valid for 72 hours (RN-02-012, CA-07-003). %>
<% membership = @invitation.membership %>
<% name = @admission.worker_profile.display_name %>
<% content_for :title, t(".title", name: name) %>

<p class="text-sm"><%= link_to t(".back"), admission_path(@admission), class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title", name: name) %></h1>
<p class="page-subtitle"><%= t(".validity", date: l(membership.invitation_expires_at, format: :long)) %></p>

<% if membership.invitation_channels.include?("email") %>
  <p class="alert-ok mt-6"><%= t(".email_sent", email: membership.user.email) %></p>
<% end %>
<% if membership.invitation_channels.include?("link") %>
  <section class="card card-body mt-6">
    <h2 class="card-title"><%= t(".link_title") %></h2>
    <p class="mt-2 text-sm"><%= t(".link_instructions") %></p>
    <p class="mt-3 rounded-lg bg-canvas px-3 py-2 font-mono text-xs break-all"><%= @invitation.link %></p>
    <div class="mt-4 w-48 rounded-lg border border-line bg-white p-2"><%= qr_code_svg(@invitation.link) %></div>
  </section>
<% end %>
