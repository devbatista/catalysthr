<%# The position's form (RN-04-030 to RN-04-032). The CBO is searched in the official table
    by code or title; without JavaScript, the code is typed. %>
<%= form_with model: position, url: url, method: method, class: "card card-body mt-6 space-y-5" do |form| %>
  <% if position.errors.any? %>
    <div class="alert-bad" role="alert">
      <ul class="list-disc space-y-1 pl-5">
        <% position.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="field-wide">
      <%= form.label :name, t("panel.positions.form.name"), class: "field-label" %>
      <%= form.text_field :name, required: true, maxlength: 120, class: "input" %>
    </div>

    <div class="field-wide" data-cbo-picker data-url="<%= cbo_search_path %>" data-empty="<%= t("panel.positions.form.cbo_none") %>">
      <%= label_tag "cbo_query", t("panel.positions.form.cbo"), class: "field-label" %>
      <input type="search" id="cbo_query" class="input" autocomplete="off" placeholder="<%= t("panel.positions.form.cbo_placeholder") %>"
        value="<%= position.cbo_occupation&.label %>" data-cbo-query aria-describedby="cbo_hint">
      <ul class="mt-1 hidden max-h-64 overflow-y-auto rounded-lg border border-line bg-white text-sm shadow-sm" data-cbo-results role="listbox"></ul>
      <div class="mt-2 flex items-center gap-2">
        <%= form.label :cbo_code, t("panel.positions.form.cbo_code"), class: "text-xs font-semibold text-ink-soft" %>
        <%= form.text_field :cbo_code, required: true, inputmode: "numeric", maxlength: 6, pattern: "\\d{6}", class: "input mt-0 w-28 font-mono", data: { cbo_code: true } %>
      </div>
      <p class="field-hint" id="cbo_hint"><%= t("panel.positions.form.cbo_hint") %></p>
    </div>

    <div class="field-wide">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <%= label_tag "position_salary_min", t("panel.positions.form.salary_min"), class: "field-label" %>
          <%= text_field_tag "position[salary_min]", MoneyCents.format(position.salary_min_cents), id: "position_salary_min",
            inputmode: "decimal", placeholder: "0,00", class: "input" %>
        </div>
        <div>
          <%= label_tag "position_salary_max", t("panel.positions.form.salary_max"), class: "field-label" %>
          <%= text_field_tag "position[salary_max]", MoneyCents.format(position.salary_max_cents), id: "position_salary_max",
            inputmode: "decimal", placeholder: "0,00", class: "input" %>
        </div>
      </div>
      <p class="field-hint"><%= t("panel.positions.form.salary_hint") %></p>
    </div>

    <div class="field-full">
      <%= form.label :description, t("panel.positions.form.description"), class: "field-label" %>
      <%= form.text_area :description, rows: 3, class: "input" %>
    </div>
    <div class="field-full">
      <%= form.label :requirements, t("panel.positions.form.requirements"), class: "field-label" %>
      <%= form.text_area :requirements, rows: 3, class: "input" %>
    </div>

    <%# The position's own admission model, ahead of the company's default (D-204, RN-06-003). %>
    <div class="field-wide">
      <%= form.label :admission_template_id, t("panel.positions.form.admission_template"), class: "field-label" %>
      <%= form.select :admission_template_id,
        ProcessTemplate.admission.where(status: "active").or(ProcessTemplate.where(id: position.admission_template_id)).order(:name).pluck(:name, :id),
        { include_blank: t("panel.positions.form.default_admission_template") }, class: "input" %>
      <p class="field-hint"><%= t("panel.positions.form.admission_template_hint") %></p>
    </div>

    <% if position.persisted? %>
      <div>
        <%= form.label :status, t("panel.positions.form.status"), class: "field-label" %>
        <%= form.select :status, Position::STATUSES.map { |status| [ t("positions.statuses.#{status}"), status ] }, {}, class: "input w-auto" %>
      </div>
    <% end %>
  </div>

  <div class="flex items-center gap-4 border-t border-line-soft pt-5">
    <%= form.submit t("panel.positions.form.submit"), class: "btn btn-primary" %>
    <%= link_to t("panel.positions.form.cancel"), position.persisted? ? position_path(position) : positions_path, class: "link-button text-sm" %>
  </div>
<% end %>
