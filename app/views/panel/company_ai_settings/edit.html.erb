<%# The company's AI functions (spec 14, RN-14-010 to RN-14-012, D-389) and the day's use
    against the safety cap (RN-14-114). %>
<% content_for :title, t(".title") %>

<%= link_to t(".back"), edit_company_settings_path, class: "link-button text-sm" %>
<h1 class="page-title mt-2"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<% if @cap&.paused? %>
  <p class="alert-bad mt-6" role="alert" data-ai-paused><%= t(".paused", cap: number_with_delimiter(@cap.cap_credits)) %></p>
<% elsif @breaker_until %>
  <p class="alert-info mt-6" role="status" data-ai-breaker><%= t(".breaker", until: l(@breaker_until, format: "%H:%M")) %></p>
<% end %>

<section class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3" aria-label="<%= t(".today") %>">
  <div class="card card-body" data-ai-today>
    <p class="eyebrow"><%= t(".today") %></p>
    <p class="mt-2 text-2xl font-extrabold text-ink-strong"><%= t(".used_of", used: number_with_delimiter(@cap&.used_credits.to_i), cap: number_with_delimiter(@cap_credits)) %></p>
    <p class="mt-1 text-sm text-ink-soft"><%= t(".cap_hint") %></p>
  </div>
</section>

<%= form_with url: company_ai_settings_path, method: :patch, class: "mt-6 space-y-6" do |form| %>
  <section class="card overflow-hidden">
    <ul class="divide-y divide-line-soft">
      <% @features.each do |feature| %>
        <% enabled = @settings[feature.code]&.enabled != false %>
        <li class="flex items-start gap-3 px-5 py-4" data-ai-feature="<%= feature.code %>">
          <%= check_box_tag "enabled[]", feature.code, enabled, id: "ai_#{feature.code}", class: "mt-1 size-4" %>
          <label for="ai_<%= feature.code %>" class="flex-1">
            <span class="block font-semibold text-ink-strong"><%= t("ai.features.#{feature.code}.name") %></span>
            <span class="block text-sm text-ink-soft"><%= t("ai.features.#{feature.code}.hint") %></span>
            <span class="block text-xs text-ink-muted"><%= t("ai.features.#{feature.code}.off") %></span>
          </label>
          <span class="pill <%= enabled ? "pill-ok" : "pill-mute" %>"><%= t(enabled ? ".on" : ".off") %></span>
        </li>
      <% end %>
    </ul>
  </section>
  <p class="text-sm text-ink-soft"><%= t(".notice") %></p>
  <div class="flex items-center gap-3">
    <%= form.submit t(".save"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), edit_company_settings_path, class: "link-button text-sm" %>
  </div>
<% end %>
