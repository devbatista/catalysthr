<%# A document of the employee's folder (spec 08, RN-08-022, RN-08-051, RN-08-052,
    RN-08-080, RN-08-081; spec 16, D-645): the version in force, which a sensitive document
    opens after the password, the correction the HR asked, the upload of a new version and
    the acknowledgment ("Li e estou ciente"), which confirms the receipt only. %>
<% name = [ @document.document_type.name, @document.dependent&.name ].compact.join(" · ") %>
<% content_for :title, name %>

<p class="text-sm"><%= link_to t(".back"), portal_documents_path, class: "link-button" %></p>
<div class="mt-3 flex flex-wrap items-center gap-3">
  <h1 class="page-title"><%= name %></h1>
  <%= portal_document_state(@document) %>
</div>
<p class="page-subtitle"><%= t("documents.categories.#{@document.category}") %><% if @document.expires_on %> · <%= t(".expires_on", date: l(@document.expires_on)) %><% end %></p>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <div class="space-y-6">
    <% if @latest&.status.in?(%w[correction_requested rejected_by_scan]) %>
      <p class="alert-bad" role="alert">
        <%= @latest.rejected_by_scan? ? t(".rejected_by_scan") : t(".correction", reason: correction_text(@latest)) %>
      </p>
    <% elsif @latest && !@latest.approved? && @latest != @version %>
      <p class="alert-info"><%= t(".in_review") %></p>
    <% end %>

    <section class="card card-body space-y-3">
      <h2 class="card-title"><%= t(".file") %></h2>
      <% if @version&.readable? %>
        <p class="text-sm text-ink-soft"><%= t(".validated", date: l(@version.reviewed_at, format: "%d/%m/%Y")) %></p>
        <%= link_to t(".open"), file_portal_document_path(@document), class: "btn btn-secondary w-full sm:w-auto", target: "_blank", rel: "noopener" %>
        <% if @document.sensitive? %><p class="field-hint"><%= t(".sensitive") %></p><% end %>
      <% else %>
        <p class="text-sm text-ink-soft"><%= t(".no_file") %></p>
      <% end %>
    </section>

    <%# A document the HR published asking for the acknowledgment is the HR's (D-643). %>
    <% if !@document.read_only? && @document.publication.nil? && can?(:upload_own, @document) %>
      <%= link_to t(@document.current_version ? ".new_version" : ".send"), new_portal_document_version_path(@document), class: "btn btn-primary w-full sm:w-auto" %>
    <% end %>
  </div>

  <div class="space-y-6">
    <% @acknowledgments.each do |acknowledgment| %>
      <section class="card card-body space-y-3" aria-labelledby="ack-<%= acknowledgment.id %>">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 id="ack-<%= acknowledgment.id %>" class="card-title"><%= acknowledgment.publication&.title || t(".acknowledgment") %></h2>
          <%= acknowledgment_pill(acknowledgment) %>
        </div>
        <% if acknowledgment.publication&.message %><p class="whitespace-pre-line text-sm"><%= acknowledgment.publication.message %></p><% end %>
        <% if acknowledgment.awaiting? && can?(:acknowledge, acknowledgment) %>
          <p class="alert-info"><%= t("documents.acknowledgment_meaning") %></p>
          <%= form_with url: confirm_portal_acknowledgment_path(acknowledgment), method: :patch, class: "space-y-3" do |form| %>
            <div>
              <%= form.label :comment, t(".comment"), class: "field-label", for: "comment_#{acknowledgment.id}" %>
              <%= form.text_area :comment, rows: 2, maxlength: 2000, id: "comment_#{acknowledgment.id}", class: "input" %>
            </div>
            <%= form.submit t(".confirm"), class: "btn btn-primary w-full sm:w-auto", disabled: !@version&.readable? %>
            <% unless @version&.readable? %><p class="field-hint"><%= t(".confirm_wait") %></p><% end %>
          <% end %>
          <p class="field-hint"><%= t(".due", date: l(acknowledgment.due_on)) %></p>
        <% elsif acknowledgment.acknowledged? %>
          <p class="text-sm text-ink-soft"><%= t(".acknowledged", date: l(acknowledgment.acknowledged_at, format: "%d/%m/%Y %H:%M")) %></p>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
