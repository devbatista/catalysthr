<%# "Minha equipe" (spec 16, RN-16-030, RN-16-031, D-420, D-645): the process items
    assigned to the manager, resolved in the process's page in the panel, and the team's
    documents expiring, the text only (P-08-11). Approvals, absences, the schedule and the
    probation's end come with their specs. %>
<% content_for :title, t(".title") %>

<p class="text-sm"><%= link_to t(".back"), portal_more_path, class: "link-button" %></p>
<div class="mt-3 flex flex-wrap items-center justify-between gap-3">
  <h1 class="page-title"><%= t(".title") %></h1>
  <%= link_to t(".open_panel"), root_path(panel: 1), class: "btn btn-secondary" %>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <section class="card card-body space-y-3">
    <h2 class="card-title"><%= t(".items", count: @team.items.size) %></h2>
    <% if @team.items.empty? %>
      <p class="text-sm text-ink-soft"><%= t(".no_items") %></p>
    <% else %>
      <ul class="divide-y divide-line-soft text-sm">
        <% @team.items.each do |item| %>
          <li class="flex flex-wrap items-center justify-between gap-2 py-2">
            <span class="flex flex-col">
              <%= link_to item.title, process_path(item.instance, anchor: "items"), class: "link-button font-bold" %>
              <span class="text-xs text-ink-soft"><%= item.instance.subject.worker_profile.display_name %></span>
            </span>
            <% if item.due_on %><span class="pill <%= item.overdue? ? "pill-bad" : "pill-info" %>"><%= l(item.due_on, format: "%d/%m") %></span><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="card card-body space-y-3">
    <h2 class="card-title"><%= t(".expiring", count: @team.expiring.size) %></h2>
    <% if @team.expiring.empty? %>
      <p class="text-sm text-ink-soft"><%= t(".no_expiring") %></p>
    <% else %>
      <ul class="divide-y divide-line-soft text-sm">
        <% @team.expiring.each do |entry| %>
          <li class="py-2"><%= t(".expiring_line", document: entry.document, person: entry.person, date: l(entry.date)) %>
            <span class="pill <%= entry.status == "expired" ? "pill-bad" : "pill-warn" %> ml-1"><%= t("documents.statuses.#{entry.status}") %></span></li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
