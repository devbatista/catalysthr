<%# A new version of the employee's document (RN-08-013, RN-08-022): the one asked, the
    correction or the renewal, from the camera or the device. %>
<% name = @document.document_type.name %>
<% content_for :title, t(".title", document: name) %>

<p class="text-sm"><%= link_to t(".back"), portal_document_path(@document), class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title", document: name) %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<%= form_with model: @upload, scope: :upload, url: portal_document_versions_path(@document), method: :post, multipart: true,
  class: "card card-body mt-6 space-y-5" do |form| %>
  <%= render "admin/plans/errors", records: [ @upload ] %>
  <% if (latest = @document.latest_version)&.correction_requested? %>
    <p class="alert-bad"><%= t("panel.portal.documents.show.correction", reason: correction_text(latest)) %></p>
  <% end %>
  <div class="form-grid">
    <%= render "panel/portal/documents/upload_fields", max_files: @document.document_type.max_files %>
  </div>
  <div class="flex flex-wrap items-center gap-4 border-t border-line-soft pt-5">
    <%= form.submit t(".submit"), class: "btn btn-primary w-full sm:w-auto" %>
    <%= link_to t(".cancel"), portal_document_path(@document), class: "link-button text-sm" %>
  </div>
<% end %>
