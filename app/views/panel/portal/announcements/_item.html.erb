<%# A notice in the portal's lists: the title, the start of the text and the date; the pin and
    the new ones marked (RN-16-020, D-656). %>
<%= link_to portal_announcement_path(announcement), class: "card card-body block space-y-1 no-underline hover:no-underline" do %>
  <span class="flex flex-wrap items-start justify-between gap-2">
    <strong class="text-ink-strong"><%= announcement.title %></strong>
    <span class="flex shrink-0 gap-1">
      <% if announcement.pinned && announcement.live? %><span class="pill pill-info"><%= t("announcements.pinned") %></span><% end %>
      <% if unread %><span class="pill pill-warn"><%= t("announcements.unread") %></span><% end %>
    </span>
  </span>
  <span class="block text-sm text-ink-soft"><%= truncate(announcement.body.squish, length: 140) %></span>
  <span class="block text-xs text-ink-muted"><%= l(announcement.published_at.to_date, format: "%d/%m/%Y") %></span>
<% end %>
