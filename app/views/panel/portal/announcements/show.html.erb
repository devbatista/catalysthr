<%# A notice of the board in the portal (spec 15, RN-15-072, RN-15-073, D-656): the text and
    the attachment, once clean. Opening it counts as read. %>
<% content_for :title, @announcement.title %>
<% content_for :portal_title, t("panel.portal.announcements.index.title") %>

<p class="text-sm"><%= link_to t(".back"), portal_announcements_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= @announcement.title %></h1>
<p class="page-subtitle">
  <%= t(".published", date: l(@announcement.published_at.to_date, format: "%d/%m/%Y")) %>
  <% unless @announcement.live? %> · <%= t(".ended") %><% end %>
</p>

<section class="card card-body mt-6 space-y-4 lg:max-w-3xl">
  <p class="whitespace-pre-line text-sm leading-relaxed"><%= @announcement.body %></p>
  <% if @announcement.attachment_clean? %>
    <%= link_to t(".attachment", name: @announcement.attachment.filename), attachment_portal_announcement_path(@announcement),
      class: "btn btn-secondary w-full sm:w-auto", target: "_blank", rel: "noopener" %>
  <% end %>
</section>
