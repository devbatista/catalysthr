<%# The HR with a form item (RN-06-031, D-649): fills it in the person's name, corrects,
    gives it back and applies. Nothing goes to the record before "Aplicar". %>
<% content_for :title, @item.title %>
<% response_record = @form.response %>
<% show = ->(record, field, section, answer) { answer.present? ? reveal_confirmed(record, field, as: :text, section: section, value: answer) : nil } %>

<p class="text-sm"><%= link_to t(".back"), process_path(@instance, anchor: "items"), class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= @item.title %></h1>
<p class="page-subtitle"><%= t(".subtitle", person: @instance.subject.worker_profile.display_name) %></p>
<div class="mt-3"><%= process_item_pills(@item, @instance.today) %></div>

<% if @form.errors.any? %>
  <div class="alert-bad mt-6" role="alert">
    <ul class="list-disc space-y-1 pl-5"><% @form.errors.each do |message| %><li><%= message %></li><% end %></ul>
  </div>
<% end %>
<% if @item.correction_requested? && response_record.correction_reason %>
  <p class="alert-info mt-6"><%= t(".given_back_reason", reason: response_record.correction_reason) %></p>
<% end %>
<% if @item.instructions %><p class="mt-4 whitespace-pre-line text-sm"><%= @item.instructions %></p><% end %>

<%= form_with url: process_item_form_path(@instance, @item), method: :patch, class: "mt-6 space-y-6", id: "process_form" do |form| %>
  <%= render "shared/process_forms/fields", schema: @form.schema, response: response_record, show: show %>
  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit t(".apply"), formaction: apply_process_item_form_path(@instance, @item), class: "btn btn-primary",
      data: { confirm: t(".apply_confirm") } %>
    <%= form.submit t(".save"), class: "btn btn-secondary" %>
  </div>
<% end %>

<% if @item.submitted? %>
  <details class="mt-4">
    <summary class="btn btn-secondary"><%= t(".give_back") %></summary>
    <%= form_with url: give_back_process_item_form_path(@instance, @item), method: :patch, class: "mt-3 space-y-3 sm:w-96" do |form| %>
      <%= form.label :reason, t(".reason"), class: "field-label" %>
      <%= form.text_area :reason, rows: 3, required: true, maxlength: 2000, class: "input" %>
      <p class="field-hint"><%= t(".reason_hint") %></p>
      <%= form.submit t(".give_back_submit"), class: "btn btn-primary" %>
    <% end %>
  </details>
<% end %>
