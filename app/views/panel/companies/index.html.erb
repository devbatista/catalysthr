<h1 class="text-2xl font-bold"><%= t(".title") %></h1>
<p class="mt-2"><%= t(".instructions") %></p>

<ul class="mt-6 space-y-2">
  <% authorized_companies.each do |company| %>
    <li>
      <%= button_to company.name, current_company_path, params: { company_id: company.id },
        class: "w-full rounded-lg bg-white px-4 py-3 text-left font-semibold ring-1 ring-slate-200" %>
    </li>
  <% end %>
</ul>
