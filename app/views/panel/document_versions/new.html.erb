<%# A new version of a document, by the HR (RN-08-013): approving it later replaces the one
    in force (RN-08-023). %>
<% title = document_title(@document) %>
<% content_for :title, t(".title", document: title) %>

<p class="text-sm"><%= link_to t(".back"), document_path(@document), class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title", document: title) %></h1>
<p class="page-subtitle"><%= t(".subtitle", name: @document.worker_profile.display_name) %></p>

<%= form_with model: @upload, scope: :upload, url: document_versions_path(@document), method: :post, multipart: true,
  class: "card card-body mt-6 space-y-5" do |form| %>
  <%= render "admin/plans/errors", records: [ @upload ] %>
  <div class="form-grid">
    <%= render "shared/documents/upload_fields", form: form %>
  </div>
  <p class="field-hint"><%= t(".files_allowed", count: @document.document_type.max_files) %></p>
  <div class="flex items-center gap-4 border-t border-line-soft pt-5">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), document_path(@document), class: "link-button text-sm" %>
  </div>
<% end %>
