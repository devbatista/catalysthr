<% content_for :title, t(".title") %>

<%= link_to t(".back"), edit_company_settings_path, class: "link-button text-sm" %>
<h1 class="page-title mt-2"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<%= form_with url: company_notification_settings_path, method: :patch, class: "mt-6 space-y-6" do |form| %>
  <section class="card overflow-hidden">
    <%= render "shared/notifications/channels", types: @settings.map(&:type), name: "settings",
      channels: @settings.to_h { |setting| [ setting.notification_type, setting.channels ] },
      errors: @settings.to_h { |setting| [ setting.notification_type, setting.errors.full_messages ] } %>
  </section>
  <div class="flex items-center gap-3">
    <%= form.submit t(".save"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), edit_company_settings_path, class: "link-button text-sm" %>
  </div>
<% end %>
