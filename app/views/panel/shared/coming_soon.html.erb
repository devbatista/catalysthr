<%# A module of the prototype not built yet (D-597), or one that waits for the contract
    during the trial (CA-19-003, D-616). No date is promised. %>
<% feature_name = t(ComingSoon.translation_key(@feature)) %>
<% state = @state || :soon %>
<% content_for :title, feature_name %>

<div class="flex flex-wrap items-center gap-3">
  <h1 class="page-title"><%= feature_name %></h1>
  <span class="pill pill-mute"><%= t("navigation.tags.#{state}") %></span>
</div>

<div class="card card-body mt-6 max-w-xl border-dashed">
  <% if state == :after_contract %>
    <p class="text-sm text-ink-soft"><%= t(".after_contract") %></p>
    <p class="mt-2 text-sm text-ink-soft"><%= t(Current.company.direct? ? ".after_contract_direct" : ".after_contract_partner") %></p>
  <% else %>
    <p class="text-sm text-ink-soft"><%= t(".text") %></p>
  <% end %>
  <p class="mt-4"><%= link_to t(".back"), panel_context == :partner ? partner_root_path : root_path, class: "btn btn-secondary" %></p>
</div>
