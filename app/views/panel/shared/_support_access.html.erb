<%# Fixed on every page of the support's entry, whose writes are real (D-581) %>
<div class="bg-sky-700 text-white" role="status">
  <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-2 text-sm sm:px-7">
    <p><strong><%= t("support_accesses.banner.title", company: Current.support_access.company.name) %></strong>
      <span class="ml-2"><%= t("support_accesses.banner.real") %></span></p>
    <%= button_to t("support_accesses.banner.stop"), support_access_path, method: :delete,
      class: "btn btn-sm cursor-pointer bg-white text-sky-800 hover:bg-sky-50" %>
  </div>
</div>
