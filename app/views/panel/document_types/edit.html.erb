<% content_for :title, @type.name %>

<p class="text-sm"><%= link_to t(".back"), document_types_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= @type.name %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<%= render "shared/document_types/form", type: @type, url: document_type_path(@type), method: :patch, platform: false,
  cancel_path: document_types_path %>
