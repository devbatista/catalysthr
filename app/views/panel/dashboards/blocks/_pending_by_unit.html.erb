<%# "Pendências por unidade" (RN-17-011): the pending documents and the overdue items of each
    unit of the scope. The approvals' column comes with spec 09 (D-657). %>
<% rows = panel.pending_by_unit %>
<div class="card overflow-hidden">
  <h2 class="card-title px-5 pt-5"><%= t(".title") %></h2>
  <% if rows.empty? %>
    <p class="px-5 pb-5 pt-2 text-sm text-ink-soft"><%= t(".empty") %></p>
  <% else %>
    <div class="mt-3 overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t(".unit") %></th>
            <% if panel.documents? %><th class="text-right"><%= t(".documents") %></th><% end %>
            <% if panel.overdue_items? %><th class="text-right"><%= t(".overdue") %></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <% unit_filter = panel.filter.params.merge(unit_id: row.unit.id) %>
            <tr>
              <td class="font-bold"><%= row.unit.name %></td>
              <% if panel.documents? %>
                <td class="text-right"><%= link_to number_with_delimiter(row.documents), pending_documents_path(unit_filter), class: "link-button" %></td>
              <% end %>
              <% if panel.overdue_items? %>
                <td class="text-right">
                  <%= link_to number_with_delimiter(row.overdue), overdue_items_path(unit_filter),
                    class: "link-button #{"font-extrabold text-bad" if row.overdue.positive?}" %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
