<%# The experiences of the team about to end, by the company's lead (D-653, D-659), without an
    action: the decision is the HR's (RN-07-101). %>
<% entries = overview.probations %>
<div class="card card-body">
  <h2 class="card-title"><%= t(".title", count: entries.size) %></h2>
  <% if entries.empty? %>
    <p class="mt-2 text-sm text-ink-soft"><%= t(".empty") %></p>
  <% else %>
    <ul class="mt-3 divide-y divide-line-soft text-sm">
      <% entries.each do |entry| %>
        <li class="py-2"><%= t("panel.portal.teams.show.probation_line", person: entry.person, date: l(entry.date)) %></li>
      <% end %>
    </ul>
  <% end %>
</div>
