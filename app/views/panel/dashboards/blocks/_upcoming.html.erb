<%# "Próximos vencimentos" (RN-17-011, D-658): the 10 nearest of the 30 days, the same rows as
    the list "Vencimentos". %>
<% rows = panel.expirations? ? panel.expirations(limit: Dashboards::HrPanel::UPCOMING_SHOWN) : [] %>
<div class="card card-body">
  <div class="flex items-center justify-between gap-3">
    <h2 class="card-title"><%= t(".title") %></h2>
    <% if rows.any? %>
      <%= link_to t(".all"), upcoming_expirations_path(panel.filter.params), class: "link-button text-sm" %>
    <% end %>
  </div>
  <% if rows.empty? %>
    <p class="mt-2 text-sm text-ink-soft"><%= t(".empty") %></p>
  <% else %>
    <ul class="mt-3 divide-y divide-line-soft">
      <% rows.each do |row| %>
        <li class="flex items-center justify-between gap-3 py-2 text-sm">
          <span><%= expiration_label(row) %></span>
          <span class="font-bold text-warn"><%= l(row.date, format: "%d/%m") %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
