<%# "Esperando por você" (RN-17-020, D-659): the pending process items assigned to the manager,
    resolved in the process's page, as in the portal. The requests of spec 09 come here. %>
<% items = overview.items %>
<div class="card card-body">
  <h2 class="card-title"><%= t(".title", count: items.size) %></h2>
  <% if items.empty? %>
    <p class="mt-2 text-sm text-ink-soft"><%= t(".empty") %></p>
  <% else %>
    <ul class="mt-3 divide-y divide-line-soft text-sm">
      <% items.each do |item| %>
        <li class="flex flex-wrap items-center justify-between gap-2 py-2">
          <span class="flex flex-col">
            <%= link_to item.title, process_path(item.instance, anchor: "items"), class: "link-button font-bold" %>
            <span class="text-xs text-ink-soft"><%= item.instance.subject.worker_profile.display_name %></span>
          </span>
          <% if item.due_on %><span class="pill <%= item.overdue? ? "pill-bad" : "pill-info" %>"><%= l(item.due_on, format: "%d/%m") %></span><% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
