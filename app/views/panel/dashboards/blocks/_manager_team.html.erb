<%# The team, active and on leave (RN-17-020). The reason of a leave is not shown: an
    absence for health is only "afastado" (D-301). %>
<% members = overview.members %>
<div class="card">
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 pt-5">
    <h2 class="card-title"><%= t(".title", count: members.size) %></h2>
    <% on_leave = members.count(&:on_leave?) %>
    <% if on_leave.positive? %><span class="pill pill-warn"><%= t(".on_leave_count", count: on_leave) %></span><% end %>
  </div>
  <% if members.empty? %>
    <p class="px-5 pb-5 pt-2 text-sm text-ink-soft"><%= t(".empty") %></p>
  <% else %>
    <div class="mt-3 overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t(".name") %></th>
            <th class="hidden md:table-cell"><%= t(".position") %></th>
            <th class="hidden lg:table-cell"><%= t(".department") %></th>
            <th class="hidden lg:table-cell"><%= t(".unit") %></th>
            <th><%= t(".status") %></th>
          </tr>
        </thead>
        <tbody>
          <% members.each do |member| %>
            <tr>
              <td>
                <% if can?(:read, member.profile) %>
                  <%= link_to member.profile.display_name, employee_path(member.profile), class: "link-button font-bold" %>
                <% else %>
                  <span class="font-bold"><%= member.profile.display_name %></span>
                <% end %>
                <p class="mt-1 text-xs text-ink-soft md:hidden"><%= member.revision&.position&.name %></p>
              </td>
              <td class="hidden md:table-cell"><%= member.revision&.position&.name %></td>
              <td class="hidden lg:table-cell"><%= member.revision&.department&.name %></td>
              <td class="hidden lg:table-cell"><%= member.revision&.unit&.name %></td>
              <td>
                <span class="pill <%= member.on_leave? ? "pill-warn" : "pill-ok" %>"><%= t(member.on_leave? ? ".on_leave" : ".active") %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
