<%# A new employment with its first conditions (RN-04-051, RN-04-060), or the intern's
    conversion to CLT (CA-04-006, D-604). %>
<%= form_with model: @registration, scope: :employment_form, url: url, method: :post, class: "mt-6 space-y-6" do |form| %>
  <%= render "panel/employees/errors", record: @registration %>

  <section class="card card-body space-y-4">
    <h2 class="card-title"><%= t("panel.employments.registration.employment") %></h2>
    <div class="form-grid">
      <% unless conversion %>
        <div>
          <%= form.label :kind, t("panel.employments.registration.kind"), class: "field-label" %>
          <%= form.select :kind, Employment::KINDS.map { |kind| [ t("employments.kinds.#{kind}"), kind ] }, {}, class: "input" %>
        </div>
      <% end %>
      <div class="field-wide">
        <%= form.label :category, t("panel.employments.registration.category"), class: "field-label" %>
        <%= form.select :category, Employment::CLT_CATEGORIES.map { |category| [ t("employments.categories.#{category}"), category ] }, {}, class: "input" %>
        <% unless conversion %><p class="field-hint"><%= t("panel.employments.registration.category_hint") %></p><% end %>
      </div>
      <div>
        <%= form.label :registration_number, t("panel.employments.registration.registration_number"), class: "field-label" %>
        <%= form.text_field :registration_number, required: true, maxlength: 30, class: "input font-mono" %>
        <p class="field-hint"><%= t("panel.employments.registration.registration_number_hint") %></p>
      </div>
      <div>
        <%= form.label :started_on, t(conversion ? "panel.employments.registration.clt_started_on" : "panel.employments.registration.started_on"), class: "field-label" %>
        <%= form.date_field :started_on, required: true, max: Date.current, class: "input" %>
        <% if conversion %><p class="field-hint"><%= t("panel.employments.registration.clt_started_on_hint") %></p><% end %>
      </div>
    </div>
  </section>

  <% if admissions_on? && !conversion %>
    <section class="card card-body"><%= render "panel/employments/experience_fields", form: form %></section>
  <% end %>

  <section class="card card-body space-y-4">
    <h2 class="card-title"><%= t("panel.employments.registration.conditions") %></h2>
    <%= render "panel/employment_revisions/conditions_fields", form: form, revision: @registration, salary: @registration.salary %>
  </section>

  <div class="flex items-center gap-4">
    <%= form.submit submit, class: "btn btn-primary" %>
    <%= link_to t("panel.employees.records.cancel"), employee_path(@profile), class: "link-button text-sm" %>
  </div>
<% end %>
