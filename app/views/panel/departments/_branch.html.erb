<%# One department of the tree, with its subdepartments below (RN-04-020). Each level
    is a nested list, without a style attribute, which the CSP blocks (P-05-29) %>
<li>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 py-1.5">
    <% if depth.positive? %><span class="text-ink-muted" aria-hidden="true">└</span><% end %>
    <%= link_to department.name, department_path(department), class: "link-button text-sm" %>
    <% if department.inactive? %><span class="pill pill-mute"><%= t("departments.statuses.inactive") %></span><% end %>
    <span class="text-xs text-ink-muted">
      <%= department.managers.map { |membership| membership.user.name }.sort.join(", ").presence || t("panel.departments.index.no_manager") %>
    </span>
  </div>
  <% if by_parent[department.id].present? %>
    <ul class="pl-5">
      <%= render partial: "panel/departments/branch", collection: by_parent[department.id], as: :department,
        locals: { by_parent: by_parent, depth: depth + 1 } %>
    </ul>
  <% end %>
</li>
