<% user = @membership.user %>
<h1 class="mt-6 text-lg font-extrabold text-ink-strong"><%= t(".title", name: user.first_name) %></h1>

<% if user.password_set? %>
  <p class="mt-2 text-sm"><%= t(".existing_account") %></p>
<% else %>
  <p class="mt-2 text-sm"><%= t(".create_password") %></p>
  <%= render "users/shared/password_rules" %>
<% end %>

<% if @error || user.errors.any? %>
  <div class="mt-6 alert-bad" role="alert">
    <ul class="list-disc space-y-1 pl-5">
      <% ([ @error ].compact + user.errors.full_messages).each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with url: invitation_path, method: :patch, class: "mt-6 space-y-4" do |form| %>
  <%= form.hidden_field :token, value: params[:token] %>

  <div>
    <%= form.label :password, user.password_set? ? t(".current_password") : t(".new_password"), class: "field-label" %>
    <%= form.password_field :password, autofocus: true, required: true,
      autocomplete: user.password_set? ? "current-password" : "new-password",
      class: "input" %>
  </div>

  <% unless user.password_set? %>
    <div>
      <%= form.label :password_confirmation, t(".password_confirmation"), class: "field-label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
        class: "input" %>
    </div>
  <% end %>

  <%= form.submit t(".submit"), class: "btn btn-primary btn-block" %>
<% end %>
