<%# A custom field (RN-04-080, D-605): never for sensitive data. %>
<%= form_with model: field, url: url, method: method, class: "card card-body mt-6 space-y-5" do |form| %>
  <%= render "panel/employees/errors", record: field %>
  <p class="alert-info"><%= t("panel.custom_fields.form.sensitive_warning") %></p>
  <div class="form-grid">
    <div class="field-wide">
      <%= form.label :label, t("panel.custom_fields.form.label"), class: "field-label" %>
      <%= form.text_field :label, required: true, maxlength: 80, class: "input" %>
    </div>
    <div>
      <%= form.label :field_type, t("panel.custom_fields.form.field_type"), class: "field-label" %>
      <% if field.persisted? %>
        <p class="text-sm"><%= t("custom_fields.field_types.#{field.field_type}") %></p>
        <p class="field-hint"><%= t("panel.custom_fields.form.type_fixed") %></p>
      <% else %>
        <%= form.select :field_type, CustomFieldDefinition::FIELD_TYPES.map { |type| [ t("custom_fields.field_types.#{type}"), type ] }, {}, class: "input" %>
      <% end %>
    </div>
    <% if field.new_record? || field.type_select? %>
      <div class="field-full">
        <%= label_tag "custom_field_definition_options_text", t("panel.custom_fields.form.options"), class: "field-label" %>
        <%= text_area_tag "custom_field_definition[options_text]", field.options.join("\n"), id: "custom_field_definition_options_text", rows: 4, class: "input" %>
        <p class="field-hint"><%= t("panel.custom_fields.form.options_hint") %></p>
      </div>
    <% end %>
    <fieldset class="field-wide space-y-2">
      <label class="flex items-center gap-2 text-sm"><%= form.check_box :required %> <%= t("panel.custom_fields.form.required") %></label>
      <label class="flex items-center gap-2 text-sm"><%= form.check_box :visible_to_employee %> <%= t("panel.custom_fields.form.visible_to_employee") %></label>
      <label class="flex items-center gap-2 text-sm"><%= form.check_box :editable_by_employee %> <%= t("panel.custom_fields.form.editable_by_employee") %></label>
      <p class="field-hint"><%= t("panel.custom_fields.form.employee_hint") %></p>
    </fieldset>
    <% if field.persisted? %>
      <div>
        <%= form.label :status, t("panel.custom_fields.form.status"), class: "field-label" %>
        <%= form.select :status, CustomFieldDefinition::STATUSES.map { |status| [ t("custom_fields.statuses.#{status}"), status ] }, {}, class: "input w-auto" %>
        <p class="field-hint"><%= t("panel.custom_fields.form.status_hint") %></p>
      </div>
    <% end %>
  </div>
  <div class="flex items-center gap-4 border-t border-line-soft pt-5">
    <%= form.submit t("panel.custom_fields.form.submit"), class: "btn btn-primary" %>
    <%= link_to t("panel.custom_fields.form.cancel"), custom_fields_path, class: "link-button text-sm" %>
  </div>
<% end %>
