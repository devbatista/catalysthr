<%# "Vencimentos", opened by the HR panel (RN-17-010, D-658): documents and experience
    periods ending from today to 30 days, the nearest first. %>
<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle", from: l(@today, format: "%d/%m/%Y"), until: l(@until, format: "%d/%m/%Y")) %></p>
<%= render "panel/dashboards/filter_notice", filter: @filter, clear_path: upcoming_expirations_path %>

<section class="card card-body mt-6 space-y-3">
  <h2 class="card-title"><%= t(".count", count: @rows.size) %></h2>
  <% if @rows.empty? %>
    <p class="text-sm text-ink-soft"><%= t(".empty") %></p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t(".what") %></th>
            <th class="hidden md:table-cell"><%= t(".person") %></th>
            <th><%= t(".date") %></th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td>
                <%= link_to expiration_title(row), expiration_path(row), class: "link-button font-bold" %>
                <p class="mt-1 text-xs text-ink-soft md:hidden"><%= expiration_owner(row) %></p>
              </td>
              <td class="hidden md:table-cell"><%= expiration_owner(row) %></td>
              <td>
                <%= l(row.date, format: "%d/%m/%Y") %>
                <span class="field-hint"><%= t(".in_days", count: (row.date - @today).to_i) %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <p class="field-hint"><%= link_to t(".expired"), expirations_documents_path(status: "expired"), class: "link-button" if can?(:read, Document) %></p>
</section>
