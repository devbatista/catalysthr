<main class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-6 py-12">
  <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
    <%= render "brand_logo", brand: Current.brand %>
    <%= render "shared/flash" %>

    <p class="mt-6 text-center text-lg"><%= t(".greeting", name: current_user.first_name) %></p>
    <p class="mt-2 text-center"><%= t(".subtitle", brand: Current.brand.commercial_name) %></p>

    <p class="mt-6 text-center"><%= link_to t("account.security"), account_root_path, class: "underline" %></p>
    <%= render "users/shared/sign_out" %>
  </div>
</main>
