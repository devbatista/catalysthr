<% brand = Current.brand %>

<main class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-4 py-12 sm:px-6">
  <div class="card p-6 shadow-sm sm:p-8">
    <%= render "brand_logo", brand: brand %>

    <p class="mt-5 text-center text-base text-ink-soft">
      <%= brand.login_welcome_text.presence || t(".default_welcome") %>
    </p>

    <p class="mt-6 rounded-lg bg-brand-primary px-4 py-3 text-center text-sm font-bold text-white">
      <%= t(".coming_soon") %>
    </p>
  </div>

  <% if brand.support_email.present? || brand.support_phone.present? %>
    <p class="mt-6 text-center text-sm text-ink-soft">
      <%= t(".support") %>
      <%= mail_to brand.support_email, class: "link-button" if brand.support_email.present? %>
      <%= brand.support_phone %>
    </p>
  <% end %>
</main>
