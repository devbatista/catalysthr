<%# A person's folder, as in the prototype ("Pessoa › Documentos › Pessoais"): a chip per
    category with its count, only the ones the person who opens it may read (P-03-17,
    P-03-16), and each document with its latest version (spec 08, D-642). %>
<% name = @profile.display_name %>
<% content_for :title, t(".title", name: name) %>
<% documents = (@by_category[@category] || []).sort_by { |document| document_title(document) } %>

<p class="text-sm">
  <%= link_to name, employee_path(@profile), class: "link-button" %> ›
  <%= t(".documents") %> › <%= t("documents.categories.#{@category}") %>
</p>
<div class="mt-3 flex flex-wrap items-center justify-between gap-4">
  <h1 class="page-title"><%= t(".title", name: name) %></h1>
  <% if can?(:upload, folder_document) %>
    <div class="flex flex-wrap gap-3">
      <% person = { audience: { worker_profile_ids: [ @profile.id ] } } %>
      <% if can?(:create, DocumentRequest) %>
        <%= link_to t(".request"), new_document_request_path(person), class: "btn btn-secondary" %>
      <% end %>
      <% if can?(:create, DocumentPublication) %>
        <%= link_to t(".publish"), new_document_publication_path(person), class: "btn btn-secondary" %>
      <% end %>
      <%= link_to t(".new"), new_employee_document_path(@profile), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<%# The folder's ZIP, for who asks it, with the password, for 24 hours (RN-08-082, D-644). %>
<% if can?(:export, @profile) %>
  <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
    <%= button_to t(".export"), employee_document_export_path(@profile), class: "btn btn-secondary btn-sm",
      form: { data: { confirm: t(".export_confirm") } } %>
    <% if @export&.available? %>
      <%= link_to t(".export_ready", date: l(@export.expires_at, format: "%d/%m %H:%M")), download_document_folder_export_path(@export),
        class: "link-button" %>
    <% elsif @export&.queued? %>
      <span class="text-ink-soft"><%= t(".export_queued") %></span>
    <% elsif @export&.failed? %>
      <span class="text-bad"><%= t(".export_failed") %></span>
    <% end %>
  </div>
<% end %>

<nav class="mt-5 flex flex-wrap gap-2" aria-label="<%= t(".categories") %>">
  <% @categories.each do |category| %>
    <%= link_to "#{t("documents.categories.#{category}")} · #{@by_category.fetch(category, []).size}",
      employee_documents_path(@profile, category: category), class: "chip #{"chip-active" if category == @category}",
      "aria-current": (category == @category ? "page" : nil) %>
  <% end %>
</nav>

<% if documents.empty? %>
  <p class="card card-body mt-5 text-sm text-ink-soft"><%= t(".empty") %></p>
<% else %>
  <div class="card mt-5 overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t(".document") %></th>
          <th class="hidden md:table-cell"><%= t(".latest") %></th>
          <th><%= t(".status") %></th>
        </tr>
      </thead>
      <tbody>
        <% documents.each do |document| %>
          <% latest = document.latest_version %>
          <tr>
            <td>
              <%= link_to document_title(document), document_path(document), class: "link-button font-bold" %>
              <span class="mt-1 flex flex-wrap gap-1">
                <% if document.sensitive? %><span class="pill pill-warn"><%= t("document_types.flags.sensitive") %></span><% end %>
                <% if document.document_type.internal %><span class="pill pill-mute"><%= t("document_types.flags.internal") %></span><% end %>
                <% if document.read_only? %><span class="pill pill-mute"><%= t(".generated") %></span><% end %>
              </span>
              <% if latest %><p class="mt-1 text-xs text-ink-soft md:hidden"><%= version_upload_text(latest) %></p><% end %>
            </td>
            <td class="hidden md:table-cell text-sm text-ink-soft"><%= latest ? version_upload_text(latest) : "—" %></td>
            <td><%= document_version_pill(latest) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<%# The deleted ones, recoverable for 30 days by the HR administrator (RN-08-083, D-644). %>
<% if @deleted&.any? %>
  <section class="card card-body mt-6 space-y-3">
    <div>
      <h2 class="card-title"><%= t(".deleted", count: @deleted.size) %></h2>
      <p class="field-hint"><%= t(".deleted_hint") %></p>
    </div>
    <ul class="divide-y divide-line-soft">
      <% @deleted.each do |document| %>
        <li class="flex flex-wrap items-center justify-between gap-3 py-3 text-sm">
          <div>
            <p class="font-bold text-ink-strong"><%= document_title(document) %></p>
            <p class="text-xs text-ink-soft"><%= t(".deleted_by", name: document.deleted_by&.name, date: l(document.deleted_at, format: "%d/%m/%Y %H:%M"), reason: document.delete_reason) %></p>
            <p class="text-xs text-ink-soft"><%= t(".recoverable_until", date: l((document.deleted_at + Documents::Removal::RECOVERABLE_FOR).to_date)) %></p>
          </div>
          <%= button_to t(".restore"), restore_document_path(document), method: :patch, class: "btn btn-secondary btn-sm" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
