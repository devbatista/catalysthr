<%# A notice of the board in the panel (RN-15-072, D-656): the text, the attachment, the
    audience, the dates and, for who published it and the HR administrator, how many of the
    audience opened it, against the audience now. Editing and withdrawing are theirs. %>
<% content_for :title, @announcement.title %>
<% zone = Announcements::Form.zone(Current.company) %>

<p class="text-sm"><%= link_to t(".back"), announcements_path, class: "link-button" %></p>
<div class="mt-3 flex flex-wrap items-center justify-between gap-4">
  <h1 class="page-title"><%= @announcement.title %></h1>
  <div class="flex flex-wrap items-center gap-3">
    <% if @announcement.withdrawable? && can?(:update, @announcement) %>
      <%= link_to t(".edit"), edit_announcement_path(@announcement), class: "btn btn-secondary" %>
    <% end %>
    <% if @announcement.withdrawable? && can?(:withdraw, @announcement) %>
      <%= button_to t(".withdraw.#{@announcement.status}"), withdraw_announcement_path(@announcement), method: :patch, class: "btn btn-danger",
        data: { confirm: t(".withdraw_confirm.#{@announcement.status}") } %>
    <% end %>
  </div>
</div>
<p class="page-subtitle">
  <%= announcement_status_pill(@announcement) %>
  <% if @announcement.pinned %><span class="pill pill-info"><%= t("announcements.pinned") %></span><% end %>
  <%= t("panel.announcements.index.author", name: @announcement.author.name) %>
</p>

<% if @announcement.draft? && @announcement.scan_status == "infected" %>
  <p class="alert-bad mt-4" role="alert"><%= t(".infected") %></p>
<% elsif @announcement.scheduled? && @announcement.scan_status == "scanning" %>
  <p class="alert-info mt-4"><%= t(".scanning") %></p>
<% end %>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
  <section class="card card-body space-y-3 lg:col-span-2">
    <p class="whitespace-pre-line text-sm"><%= @announcement.body %></p>
    <% if @announcement.attachment_clean? %>
      <p><%= link_to t(".attachment", name: @announcement.attachment.filename), attachment_announcement_path(@announcement),
        class: "link-button text-sm", target: "_blank", rel: "noopener" %></p>
    <% end %>
  </section>

  <section class="card card-body">
    <dl class="space-y-3 text-sm">
      <div>
        <dt class="text-ink-soft"><%= t(".audience") %></dt>
        <dd class="mt-0.5 text-ink-strong"><%= announcement_audience_summary(@audience) %></dd>
      </div>
      <% if (time = @announcement.published_at || @announcement.publish_at) %>
        <div>
          <dt class="text-ink-soft"><%= @announcement.published_at ? t(".published_at") : t(".publish_at") %></dt>
          <dd class="mt-0.5 text-ink-strong"><%= announcement_time(time, zone) %></dd>
        </div>
      <% end %>
      <div>
        <dt class="text-ink-soft"><%= t(".expires_at") %></dt>
        <dd class="mt-0.5 text-ink-strong"><%= l(@announcement.expires_at.in_time_zone(zone).to_date) %></dd>
      </div>
      <% if @announcement.withdrawn? %>
        <div>
          <dt class="text-ink-soft"><%= t(".withdrawn") %></dt>
          <dd class="mt-0.5 text-ink-strong"><%= t(".withdrawn_value", name: @announcement.withdrawn_by&.name, date: announcement_time(@announcement.withdrawn_at, zone)) %></dd>
        </div>
      <% end %>
      <% if @reads %>
        <div>
          <dt class="text-ink-soft"><%= t(".reads") %></dt>
          <dd class="mt-0.5 text-2xl font-bold text-ink-strong"><%= t(".reads_value", opened: @reads[:opened], count: @reads[:count]) %></dd>
          <dd class="field-hint"><%= t(".reads_hint") %></dd>
        </div>
      <% end %>
    </dl>
  </section>
</div>
