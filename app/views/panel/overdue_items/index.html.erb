<%# "Tarefas atrasadas", opened by the HR panel (RN-17-010, RN-06-028, D-658): the open items
    past their date of the open processes in the person's scope, the oldest date first. %>
<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>
<%= render "panel/dashboards/filter_notice", filter: @filter, clear_path: overdue_items_path %>

<section class="card card-body mt-6 space-y-3">
  <h2 class="card-title"><%= t(".count", count: @count) %></h2>
  <% if @items.empty? %>
    <p class="text-sm text-ink-soft"><%= t(".empty") %></p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t(".item") %></th>
            <th class="hidden md:table-cell"><%= t(".process") %></th>
            <th class="hidden lg:table-cell"><%= t(".responsible") %></th>
            <th><%= t(".due_on") %></th>
          </tr>
        </thead>
        <tbody>
          <% @items.each do |item| %>
            <% instance = item.instance %>
            <% person = instance.employment&.worker_profile %>
            <tr>
              <td>
                <%= link_to item.title, process_path(instance), class: "link-button font-bold" %>
                <p class="mt-1 text-xs text-ink-soft md:hidden"><%= [ t("process_templates.kinds.#{instance.kind}"), person&.display_name ].compact.join(" · ") %></p>
              </td>
              <td class="hidden md:table-cell">
                <%= [ t("process_templates.kinds.#{instance.kind}"), person&.display_name ].compact.join(" · ") %>
                <% if instance.unit %><span class="field-hint"><%= instance.unit.name %></span><% end %>
              </td>
              <td class="hidden lg:table-cell text-sm text-ink-soft">
                <% names = item.responsible_membership_ids.filter_map { |id| @people[id]&.user&.name } %>
                <%= names.any? ? names.join(", ") : t("process_templates.roles.#{item.responsible_role}") %>
              </td>
              <td><span class="pill pill-bad"><%= l(item.due_on, format: "%d/%m/%Y") %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @count > @items.size %>
      <p class="field-hint"><%= t(".more", shown: @items.size, count: @count) %></p>
    <% end %>
  <% end %>
</section>
