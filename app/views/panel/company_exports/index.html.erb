<%# The company's full export (spec 18, RN-18-070 to RN-18-075, D-667): what goes in the
    ZIP, the password shown once, the request with the weekly limit (RN-18-074, CA-18-012)
    and the exports asked, with who asked. %>
<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<section class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <div class="card card-body space-y-2">
    <h2 class="card-title"><%= t(".contents_title") %></h2>
    <p class="text-sm text-ink-soft"><%= t(".contents") %></p>
  </div>
  <div class="card card-body space-y-2">
    <h2 class="card-title"><%= t(".password_title") %></h2>
    <p class="text-sm text-ink-soft"><%= t(".password") %></p>
    <p class="text-sm text-ink-soft"><%= t(".how_to_open") %></p>
  </div>
</section>

<div class="mt-6 flex flex-wrap items-center gap-4">
  <% if @next_allowed_at %>
    <p class="alert-info" role="status" data-next-allowed><%= t(".next_allowed", date: l(@next_allowed_at.in_time_zone.to_date)) %></p>
  <% else %>
    <%= button_to t(".request"), company_exports_path, method: :post, class: "btn btn-primary" %>
  <% end %>
</div>

<section class="card mt-6">
  <h2 class="card-title px-5 pt-5"><%= t(".history") %></h2>
  <% if @exports.empty? %>
    <p class="px-5 pb-5 pt-2 text-sm text-ink-soft"><%= t(".empty") %></p>
  <% else %>
    <div class="mt-3 overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t(".requested") %></th>
            <th class="hidden md:table-cell"><%= t(".requested_by") %></th>
            <th><%= t(".status") %></th>
            <th class="hidden lg:table-cell text-right"><%= t(".size") %></th>
          </tr>
        </thead>
        <tbody>
          <% @exports.each do |export| %>
            <tr>
              <td>
                <%= link_to l(export.created_at, format: "%d/%m/%Y %H:%M"), company_export_path(export), class: "link-button font-bold" %>
                <p class="mt-1 text-xs text-ink-soft md:hidden"><%= export.requested_by.name %></p>
              </td>
              <td class="hidden md:table-cell"><%= export.requested_by.name %></td>
              <td><%= company_export_status_pill(export) %></td>
              <td class="hidden lg:table-cell text-right text-sm"><%= number_to_human_size(export.size_bytes) if export.size_bytes %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
