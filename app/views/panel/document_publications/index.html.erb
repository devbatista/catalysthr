<%# The publications asking for an acknowledgment (RN-08-050), the newest first, with each
    one's counts of the viewer's scope. %>
<% content_for :title, t(".title") %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="page-title"><%= t("panel.documents.index.title") %></h1>
  <% if can?(:create, DocumentPublication) %>
    <%= link_to t(".new"), new_document_publication_path, class: "btn btn-primary" %>
  <% end %>
</div>
<p class="page-subtitle"><%= t(".subtitle") %></p>
<%= render "panel/documents/tabs", current: :publications %>

<section class="card card-body mt-6 space-y-3">
  <h2 class="card-title"><%= t(".title") %></h2>
  <% if @publications.empty? %>
    <p class="text-sm text-ink-soft"><%= t(".empty") %></p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t(".document") %></th>
            <th class="hidden md:table-cell"><%= t(".due_on") %></th>
            <th><%= t(".progress") %></th>
          </tr>
        </thead>
        <tbody>
          <% @publications.each do |publication| %>
            <% records = publication.acknowledgments.select { |each| @visible.include?(each.worker_profile_id) } %>
            <tr>
              <td>
                <%= link_to publication.title, document_publication_path(publication), class: "link-button font-bold" %>
                <p class="mt-1 text-xs text-ink-soft"><%= publication.document_type.name %> · <%= t(".published", name: publication.published_by.name, date: l(publication.created_at, format: "%d/%m/%Y")) %></p>
                <p class="mt-1 text-xs text-ink-soft md:hidden"><%= l(publication.due_on) %></p>
              </td>
              <td class="hidden md:table-cell"><%= l(publication.due_on) %></td>
              <td class="text-sm">
                <%= t(".progress_value", acknowledged: records.count(&:acknowledged?), count: records.size) %>
                <% if (late = records.count(&:overdue?)).positive? %><span class="pill pill-bad ml-1"><%= t(".late", count: late) %></span><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
