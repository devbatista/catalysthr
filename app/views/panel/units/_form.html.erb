<%# The unit's form (RN-04-011 to RN-04-013): the address by CEP (D-215) and the position
    confirmed on the map (RN-04-012, D-216). Without JavaScript, everything is filled by hand. %>
<%= form_with model: unit, url: url, method: method, class: "mt-6 space-y-6", data: { unit_form: true } do |form| %>
  <% if unit.errors.any? %>
    <div class="alert-bad" role="alert">
      <ul class="list-disc space-y-1 pl-5">
        <% unit.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <section class="card card-body space-y-4">
    <h2 class="card-title"><%= t("panel.units.form.identification") %></h2>
    <div class="form-grid">
      <div class="field-wide">
        <%= form.label :name, t("panel.units.form.name"), class: "field-label" %>
        <%= form.text_field :name, required: true, maxlength: 120, class: "input" %>
      </div>
      <div>
        <%= form.label :registration_type, t("panel.units.form.registration_type"), class: "field-label" %>
        <%= form.select :registration_type, Unit::REGISTRATION_TYPES.map { |type| [ t("units.registration_types.#{type}"), type ] },
          { include_blank: t("panel.units.form.no_registration") }, class: "input" %>
      </div>
      <div>
        <%= form.label :registration_number, t("panel.units.form.registration_number"), class: "field-label" %>
        <%= form.text_field :registration_number, autocomplete: "off", class: "input font-mono" %>
      </div>
      <p class="field-hint field-full -mt-3"><%= t("panel.units.form.registration_hint", root: Current.company.formatted_document) %></p>
      <div>
        <%= form.label :time_zone, t("panel.units.form.time_zone"), class: "field-label" %>
        <%= form.select :time_zone, Unit::TIME_ZONES, {}, class: "input" %>
      </div>
      <% unless unit.headquarters? %>
        <div>
          <%= form.label :status, t("panel.units.form.status"), class: "field-label" %>
          <%= form.select :status, Unit::STATUSES.map { |status| [ t("units.statuses.#{status}"), status ] }, {}, class: "input" %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="card card-body space-y-4">
    <h2 class="card-title"><%= t("panel.units.form.address") %></h2>
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <%= form.label :postal_code, t("panel.units.form.postal_code"), class: "field-label" %>
        <%= form.text_field :postal_code, inputmode: "numeric", autocomplete: "postal-code", maxlength: 9,
          class: "input w-40 font-mono", data: { postal_code: true } %>
      </div>
      <button type="button" class="btn btn-secondary" data-postal-code-lookup data-url="<%= address_lookup_path(postal_code: "CEP") %>"
        data-not-found="<%= t("panel.units.form.postal_code_not_found") %>" data-invalid="<%= t("panel.units.form.postal_code_invalid") %>">
        <%= t("panel.units.form.lookup") %>
      </button>
    </div>
    <p class="field-hint" data-lookup-status aria-live="polite"></p>
    <div class="form-grid">
      <div class="field-wide">
        <%= form.label :street, t("panel.units.form.street"), class: "field-label" %>
        <%= form.text_field :street, autocomplete: "address-line1", class: "input", data: { address_field: "street" } %>
      </div>
      <div>
        <%= form.label :street_number, t("panel.units.form.street_number"), class: "field-label" %>
        <%= form.text_field :street_number, class: "input" %>
      </div>
      <div>
        <%= form.label :complement, t("panel.units.form.complement"), class: "field-label" %>
        <%= form.text_field :complement, autocomplete: "address-line2", class: "input" %>
      </div>
      <div>
        <%= form.label :district, t("panel.units.form.district"), class: "field-label" %>
        <%= form.text_field :district, class: "input", data: { address_field: "district" } %>
      </div>
      <div>
        <%= form.label :city, t("panel.units.form.city"), class: "field-label" %>
        <%= form.text_field :city, autocomplete: "address-level2", class: "input", data: { address_field: "city" } %>
      </div>
      <div>
        <%= form.label :state, t("panel.units.form.state"), class: "field-label" %>
        <%= form.select :state, Unit::STATES, { include_blank: true }, class: "input", data: { address_field: "state" } %>
      </div>
      <div>
        <%= form.label :ibge_city_code, t("panel.units.form.ibge_city_code"), class: "field-label" %>
        <%= form.text_field :ibge_city_code, inputmode: "numeric", class: "input font-mono", data: { address_field: "ibge_city_code" } %>
      </div>
    </div>
  </section>

  <section class="card card-body space-y-4">
    <div>
      <h2 class="card-title"><%= t("panel.units.form.position") %></h2>
      <p class="field-hint"><%= t("panel.units.form.position_hint") %></p>
    </div>
    <button type="button" class="btn btn-secondary" data-geocode data-url="<%= geocode_path %>"><%= t("panel.units.form.locate") %></button>
    <p class="field-hint" data-geocode-status aria-live="polite"></p>
    <div class="h-72 overflow-hidden rounded-lg border border-line bg-canvas" data-unit-map
      data-not-found="<%= t("panel.units.form.not_found") %>" data-searching="<%= t("panel.units.form.searching") %>"
      data-found="<%= t("panel.units.form.found") %>"></div>
    <div class="form-grid">
      <div>
        <%= form.label :latitude, t("panel.units.form.latitude"), class: "field-label" %>
        <%= form.number_field :latitude, step: "any", min: -90, max: 90, class: "input font-mono", data: { latitude: true } %>
      </div>
      <div>
        <%= form.label :longitude, t("panel.units.form.longitude"), class: "field-label" %>
        <%= form.number_field :longitude, step: "any", min: -180, max: 180, class: "input font-mono", data: { longitude: true } %>
      </div>
    </div>
    <p class="text-xs text-ink-muted"><%= t("panel.units.form.map_attribution") %></p>
  </section>

  <div class="flex items-center gap-4">
    <%= form.submit t("panel.units.form.submit"), class: "btn btn-primary" %>
    <%= link_to t("panel.units.form.cancel"), unit.persisted? ? unit_path(unit) : units_path, class: "link-button text-sm" %>
  </div>
<% end %>
