<%# One import (RN-18-001, steps 3 to 6): while it is read or recorded, the page refreshes
    itself; then the preview with the counts, the errors line by line and the fields that
    change (RN-18-006, RN-18-007); the confirmation of everything or only the valid lines;
    and the result with the file of errors to fix and send again (P-18-04). %>
<% content_for :title, data_import_kind_title(@import.kind) %>

<p class="text-sm"><%= link_to t(".back"), import_path_for(:index), class: "link-button" %></p>
<div class="mt-2 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="page-title"><%= data_import_kind_title(@import.kind) %></h1>
    <p class="page-subtitle">
      <% if @import.assisted? && import_area == :panel %>
        <%= t(".sent_assisted", file: @import.original_filename, at: l(@import.created_at, format: "%d/%m/%Y %H:%M")) %>
      <% else %>
        <%= t(".sent", file: @import.original_filename, name: @import.created_by.name, at: l(@import.created_at, format: "%d/%m/%Y %H:%M")) %>
      <% end %>
    </p>
  </div>
  <%= data_import_status_pill(@import) %>
</div>

<% if @import.working? %>
  <p class="alert-info mt-6" role="status" data-reload-after="3000"><%= t(".working.#{@import.status}") %></p>
<% elsif @import.failed? %>
  <p class="alert-bad mt-6" role="alert"><%= @import.failure_reason %></p>
<% end %>

<% if @import.row_count.positive? %>
  <section class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-5" aria-label="<%= t(".counts") %>">
    <% done = @import.finished? && !@import.cancelled? %>
    <% [ [ :rows, @import.row_count ], [ (done ? :created : :to_create), @import.created_count ], [ (done ? :updated : :to_update), @import.updated_count ],
         [ :unchanged, @import.unchanged_count ], [ :errors, @import.error_count + @import.failed_count ] ].each do |key, value| %>
      <div class="card card-body" data-count="<%= key %>">
        <p class="eyebrow"><%= t(".count.#{key}") %></p>
        <p class="mt-2 text-2xl font-extrabold <%= key == :errors && value.positive? ? "text-bad" : "text-ink-strong" %>"><%= number_with_delimiter(value) %></p>
      </div>
    <% end %>
  </section>
<% end %>

<% if @import.preview? %>
  <section class="card card-body mt-6 space-y-3">
    <h2 class="card-title"><%= t(".confirm_title") %></h2>
    <% if @import.all_valid? %>
      <p class="text-sm text-ink-soft"><%= t(".all_valid") %></p>
    <% elsif @import.importable? %>
      <p class="text-sm text-ink-soft"><%= t(".some_invalid", count: @import.error_count) %></p>
    <% else %>
      <p class="text-sm text-ink-soft"><%= t(".none_valid") %></p>
    <% end %>
    <% if @import.kind_class.respond_to?(:preview_note) %>
      <p class="alert-info text-sm" data-preview-note><%= @import.kind_class.preview_note %></p>
    <% end %>
    <% if @import.kind_class.sensitive? %>
      <p class="text-sm text-ink-soft"><%= t(".sensitive") %></p>
    <% end %>
    <div class="flex flex-wrap items-end gap-3">
      <% if @import.importable? %>
        <% only_valid = !@import.all_valid? %>
        <%= form_with url: import_path_for(:confirm, @import), method: :patch, class: "flex flex-wrap items-end gap-3",
          data: (only_valid ? { confirm: t(".import_valid_confirm", count: @import.error_count) } : {}) do %>
          <%= hidden_field_tag :only_valid, "1" if only_valid %>
          <% if declaration?(@import.kind_class) %>
            <label class="flex items-start gap-2 text-sm field-full">
              <%= check_box_tag :declaration, "1", false, required: true, class: "mt-1" %>
              <span><%= t(import_area == :admin ? ".declaration_assisted" : ".declaration") %></span>
            </label>
          <% end %>
          <%= submit_tag only_valid ? t(".import_valid", count: @import.valid_count) : t(".import_all"), class: "btn btn-primary" %>
        <% end %>
      <% end %>
      <%= button_to t(".cancel"), import_path_for(:cancel, @import), method: :patch, class: "btn btn-secondary" %>
    </div>
  </section>
<% end %>

<% if @import.undo_blockers.any? && !@import.undone? %>
  <section class="card card-body mt-6 space-y-3" role="alert" data-undo-blockers>
    <h2 class="card-title text-bad"><%= t(".undo_blocked_title") %></h2>
    <p class="text-sm text-ink-soft"><%= t(".undo_blocked_text") %></p>
    <ul class="list-disc space-y-1 pl-5 text-sm">
      <% @import.undo_blockers.each do |blocker| %>
        <li><% if blocker["record"] %><strong><%= blocker["record"] %>:</strong> <% end %><%= blocker["message"] %></li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @import.undone? %>
  <p class="alert-info mt-6" role="status">
    <%= t(".undone", name: @import.undone_by&.name, at: l(@import.undone_at, format: "%d/%m/%Y %H:%M")) %>
  </p>
<% elsif import_area == :panel && can?(:undo, @import) && Imports::Undo.available?(@import) %>
  <section class="card card-body mt-6 space-y-3" data-undo>
    <h2 class="card-title"><%= t(".undo_title") %></h2>
    <p class="text-sm text-ink-soft"><%= t(".undo_text") %></p>
    <%= button_to t(".undo"), undo_data_import_path(@import), method: :patch, class: "btn btn-secondary",
      form: { data: { confirm: t(".undo_confirm") } } %>
  </section>
<% end %>

<% if import_area == :panel && @import.kind == "employees" && @import.created_count.positive? && %w[completed completed_with_errors].include?(@import.status) %>
  <section class="card card-body mt-6 space-y-3" data-next-step="invite">
    <h2 class="card-title"><%= t(".invite_title") %></h2>
    <p class="text-sm text-ink-soft"><%= t(".invite_text") %></p>
    <% if can?(:invite, Membership) %>
      <%= button_to t(".invite_all"), invite_employees_path, method: :post, class: "btn btn-primary",
        form: { data: { confirm: t("panel.employees.index.invite_all_confirm") } } %>
    <% end %>
  </section>
<% end %>

<% if @rows.any? %>
  <section class="card mt-6">
    <div class="flex flex-wrap items-center justify-between gap-3 px-5 pt-5">
      <h2 class="card-title"><%= t(".errors_title") %></h2>
      <% if can?(:download_errors, @import) && Imports::ErrorsFile.new(@import).available? %>
        <%= link_to t(".errors_file"), import_path_for(:errors, @import), class: "btn btn-secondary btn-sm" %>
      <% end %>
    </div>
    <div class="mt-3 overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t(".line") %></th>
            <th><%= t(".column") %></th>
            <th class="hidden md:table-cell"><%= t(".value") %></th>
            <th><%= t(".message") %></th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <% row.issues.each do |issue| %>
              <tr data-error-line="<%= row.line_number %>">
                <td class="whitespace-nowrap">
                  <%= t(".line_of", sheet: @sheets[row.sheet]&.title, line: row.line_number) %>
                </td>
                <td><%= issue["column"] ? data_import_column(@sheets, row, issue["column"]) : "—" %></td>
                <td class="hidden md:table-cell whitespace-nowrap font-mono text-sm"><%= data_import_value(@sheets, row, issue["column"], issue["value"]) || "—" %></td>
                <td class="text-sm"><%= issue["message"] %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<% if @updates.any? && @import.preview? %>
  <section class="card mt-6">
    <h2 class="card-title px-5 pt-5"><%= t(".updates_title") %></h2>
    <div class="mt-3 overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t(".line") %></th>
            <th><%= t(".column") %></th>
            <th><%= t(".before") %></th>
            <th><%= t(".after") %></th>
          </tr>
        </thead>
        <tbody>
          <% @updates.each do |row| %>
            <% row.diff.each do |column, (before, after)| %>
              <tr>
                <td class="whitespace-nowrap"><%= t(".line_of", sheet: @sheets[row.sheet]&.title, line: row.line_number) %></td>
                <td><%= data_import_column(@sheets, row, column) %></td>
                <td class="text-sm text-ink-soft"><%= data_import_value(@sheets, row, column, before) || "—" %></td>
                <td class="text-sm font-bold"><%= data_import_value(@sheets, row, column, after) || "—" %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
