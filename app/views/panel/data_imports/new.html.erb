<%# Sending a file to an import (RN-18-001, steps 1 and 2): the template to download, the
    limits (RN-18-002) and the formats the kind takes (D-662). Nothing is recorded before the
    preview and the confirmation (D-462). %>
<% content_for :title, data_import_kind_title(@kind.code) %>

<p class="text-sm"><%= link_to t(".back"), import_path_for(:index), class: "link-button" %></p>
<h1 class="page-title mt-2"><%= data_import_kind_title(@kind.code) %></h1>
<p class="page-subtitle"><%= t("imports.kinds.#{@kind.code}.description") %></p>

<section class="card card-body mt-6 space-y-3">
  <h2 class="card-title"><%= t(".steps_title") %></h2>
  <ol class="list-decimal space-y-1 pl-5 text-sm">
    <% t(".steps").each do |step| %><li><%= step %></li><% end %>
  </ol>
  <p><%= link_to t(".template"), import_path_for(:template, kind: @kind.code), class: "btn btn-secondary" %></p>
</section>

<%= form_with url: import_path_for(:create), method: :post, multipart: true, class: "card card-body mt-6 space-y-5" do |form| %>
  <%= hidden_field_tag :kind, @kind.code %>
  <% if @error %>
    <p class="alert-bad" role="alert">
      <%= t(".errors.#{@error}", formats: @kind.formats.map(&:upcase).to_sentence, size: DataImport::MAX_SIZE / 1.megabyte) %>
    </p>
  <% end %>
  <div class="form-grid">
    <div class="field-wide">
      <%= label_tag :file, t(".file"), class: "field-label" %>
      <%= file_field_tag :file, required: true, accept: @kind.formats.map { |format| ".#{format}" }.join(","), class: "input" %>
      <p class="field-hint"><%= t(".file_hint", formats: @kind.formats.map(&:upcase).to_sentence, size: DataImport::MAX_SIZE / 1.megabyte,
        rows: number_with_delimiter(DataImport::MAX_ROWS)) %></p>
    </div>
  </div>
  <div>
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
  </div>
<% end %>
