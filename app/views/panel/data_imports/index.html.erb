<%# The company's imports (spec 18, D-661): the kinds the person may use, each with its
    template, and the history with the counts, without the data (RN-18-010). %>
<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<section class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2 2xl:grid-cols-3" aria-label="<%= t(".kinds") %>">
  <% @kinds.each_with_index do |kind, index| %>
    <div class="card card-body flex flex-col gap-3">
      <p class="eyebrow"><%= t(".step", number: index + 1) %></p>
      <h2 class="card-title"><%= data_import_kind_title(kind.code) %></h2>
      <p class="text-sm text-ink-soft"><%= t("imports.kinds.#{kind.code}.description") %></p>
      <div class="mt-auto flex flex-wrap gap-3">
        <%= link_to t(".template"), template_data_imports_path(kind.code), class: "btn btn-secondary" %>
        <%= link_to t(".send"), new_data_import_path(kind: kind.code), class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</section>

<section class="card mt-6">
  <h2 class="card-title px-5 pt-5"><%= t(".history") %></h2>
  <% if @imports.empty? %>
    <p class="px-5 pb-5 pt-2 text-sm text-ink-soft"><%= t(".empty") %></p>
  <% else %>
    <div class="mt-3 overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t(".sent") %></th>
            <th><%= t(".kind") %></th>
            <th class="hidden md:table-cell"><%= t(".file") %></th>
            <th><%= t(".status") %></th>
            <th class="hidden lg:table-cell text-right"><%= t(".counts") %></th>
          </tr>
        </thead>
        <tbody>
          <% @imports.each do |import| %>
            <tr>
              <td>
                <%= link_to l(import.created_at, format: "%d/%m/%Y %H:%M"), data_import_path(import), class: "link-button font-bold" %>
                <p class="mt-1 text-xs text-ink-soft"><%= import.created_by.name %></p>
              </td>
              <td><%= data_import_kind_title(import.kind) %></td>
              <td class="hidden md:table-cell text-sm text-ink-soft"><%= import.original_filename %></td>
              <td><%= data_import_status_pill(import) %></td>
              <td class="hidden lg:table-cell text-right text-sm">
                <%= t(".counts_line", rows: import.row_count, created: import.created_count, updated: import.updated_count, errors: import.error_count + import.failed_count) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
