<%# A request for a document (RN-08-040): the type, the people, the date and a message.
    Each person gets a pending document in the folder; their notice comes with the portal
    (spec 16). %>
<% content_for :title, t(".title") %>

<p class="text-sm"><%= link_to t(".back"), document_requests_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title") %></h1>
<p class="page-subtitle"><%= t(".subtitle") %></p>

<%= form_with url: document_requests_path, method: :post, class: "mt-6 space-y-6" do |form| %>
  <%= render "admin/plans/errors", records: [ @form ] %>
  <section class="card card-body space-y-4">
    <div class="form-grid">
      <div class="field-wide">
        <%= label_tag "request_document_type_id", t(".type"), class: "field-label" %>
        <%= select_tag "request[document_type_id]",
          grouped_options_for_select(audience_types.group_by(&:category).sort_by { |category, _| DocumentCategory::ALL.index(category) }
            .map { |category, types| [ t("documents.categories.#{category}"), types.map { |type| [ type.name, type.id ] } ] }, @form.document_type&.id),
          include_blank: true, required: true, id: "request_document_type_id", class: "input" %>
      </div>
      <div>
        <%= label_tag "request_due_on", t(".due_on"), class: "field-label" %>
        <%= date_field_tag "request[due_on]", @form.due_on, min: Date.current, id: "request_due_on", class: "input" %>
      </div>
      <div class="field-full">
        <%= label_tag "request_message", t(".message"), class: "field-label" %>
        <%= text_area_tag "request[message]", @form.message, rows: 3, maxlength: 2000, id: "request_message", class: "input" %>
        <p class="field-hint"><%= t(".message_hint") %></p>
      </div>
    </div>
  </section>

  <%= render "shared/documents/audience_fields", filter: @form.audience_filter %>

  <div class="flex items-center gap-4">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), document_requests_path, class: "link-button text-sm" %>
  </div>
<% end %>
