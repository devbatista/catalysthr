<%# A request's panel (RN-08-041, CA-08-005): how many answered (approved), are in review
    or pending, and how many are late, with each person's document. Only the viewer's
    scope. The HR may send on the person's behalf from the document. %>
<% content_for :title, t(".title", document: @request.document_type.name) %>

<p class="text-sm"><%= link_to t(".back"), document_requests_path, class: "link-button" %></p>
<h1 class="mt-3 page-title"><%= t(".title", document: @request.document_type.name) %></h1>
<p class="page-subtitle">
  <%= t(".asked", name: @request.requested_by.name, date: l(@request.created_at, format: "%d/%m/%Y")) %> ·
  <%= @request.due_on ? t(".due_on", date: l(@request.due_on)) : t("panel.document_requests.index.no_due") %>
</p>
<% if @request.message %><p class="alert-info mt-4 whitespace-pre-line"><%= @request.message %></p><% end %>

<dl class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
  <% %w[fulfilled in_review pending late].each do |key| %>
    <div class="card card-body">
      <dt class="text-sm text-ink-soft"><%= t(".counts.#{key}") %></dt>
      <dd class="mt-1 text-2xl font-bold text-ink-strong"><%= @counts[key] %></dd>
    </div>
  <% end %>
</dl>

<section class="card card-body mt-6 space-y-3">
  <h2 class="card-title"><%= t(".people", count: @targets.size) %></h2>
  <div class="overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t(".person") %></th>
          <th><%= t(".status") %></th>
        </tr>
      </thead>
      <tbody>
        <% @targets.each do |target| %>
          <tr>
            <td><%= link_to target.worker_profile.display_name, document_path(target.document), class: "link-button font-bold" %></td>
            <td><%= request_target_pill(target, @request.due_on) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
