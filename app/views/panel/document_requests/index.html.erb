<%# The HR's requests for a document (RN-08-040, RN-08-041), the newest first, with each
    one's counts of the viewer's scope. %>
<% content_for :title, t(".title") %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="page-title"><%= t("panel.documents.index.title") %></h1>
  <% if can?(:create, DocumentRequest) %>
    <%= link_to t(".new"), new_document_request_path, class: "btn btn-primary" %>
  <% end %>
</div>
<p class="page-subtitle"><%= t(".subtitle") %></p>
<%= render "panel/documents/tabs", current: :requests %>

<section class="card card-body mt-6 space-y-3">
  <h2 class="card-title"><%= t(".title") %></h2>
  <% if @requests.empty? %>
    <p class="text-sm text-ink-soft"><%= t(".empty") %></p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t(".document") %></th>
            <th class="hidden md:table-cell"><%= t(".due_on") %></th>
            <th><%= t(".progress") %></th>
          </tr>
        </thead>
        <tbody>
          <% @requests.each do |request| %>
            <% targets = request.targets.select { |target| @visible.include?(target.worker_profile_id) } %>
            <% counts = request.counts(targets) %>
            <tr>
              <td>
                <%= link_to request.document_type.name, document_request_path(request), class: "link-button font-bold" %>
                <p class="mt-1 text-xs text-ink-soft"><%= t(".asked", name: request.requested_by.name, date: l(request.created_at, format: "%d/%m/%Y")) %></p>
                <p class="mt-1 text-xs text-ink-soft md:hidden"><%= request.due_on ? l(request.due_on) : t(".no_due") %></p>
              </td>
              <td class="hidden md:table-cell"><%= request.due_on ? l(request.due_on) : t(".no_due") %></td>
              <td class="text-sm"><%= t(".progress_value", fulfilled: counts["fulfilled"], count: targets.size) %>
                <% if counts["late"].positive? %><span class="pill pill-bad ml-1"><%= t(".late", count: counts["late"]) %></span><% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
