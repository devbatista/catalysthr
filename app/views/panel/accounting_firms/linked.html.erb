<% firm = @link.accounting_firm %>
<% if @invitation %>
  <% membership = @invitation.membership %>
  <h1 class="text-2xl font-bold"><%= t(".invited_title", firm: firm.name, name: membership.user.name) %></h1>
  <p class="mt-2"><%= t("panel.memberships.invited.validity", date: l(membership.invitation_expires_at, format: :long)) %></p>
  <% if membership.invitation_channels.include?("email") %>
    <p class="mt-2"><%= t("panel.memberships.invited.email_sent", email: membership.user.email) %></p>
  <% end %>
  <% if membership.invitation_channels.include?("link") %>
    <section class="mt-6 rounded-2xl bg-white p-6 ring-1 ring-slate-200">
      <h2 class="font-semibold"><%= t("panel.memberships.invited.link_title") %></h2>
      <p class="mt-2 text-sm"><%= t("panel.memberships.invited.link_instructions") %></p>
      <p class="mt-3 break-all font-mono text-sm"><%= @invitation.link %></p>
      <div class="mt-4 w-48 rounded-lg bg-white p-2 ring-1 ring-slate-200"><%= qr_code_svg(@invitation.link) %></div>
    </section>
  <% end %>
<% else %>
  <h1 class="text-2xl font-bold"><%= t(".requested_title", firm: firm.name) %></h1>
  <p class="mt-2"><%= t(".requested_body") %></p>
<% end %>

<p class="mt-6"><%= link_to t(".back"), accounting_firm_path, class: "underline" %></p>
