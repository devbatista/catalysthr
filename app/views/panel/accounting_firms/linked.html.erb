<% firm = @link.accounting_firm %>
<% if @invitation %>
  <% membership = @invitation.membership %>
  <h1 class="page-title"><%= t(".invited_title", firm: firm.name, name: membership.user.name) %></h1>
  <p class="page-subtitle"><%= t("panel.memberships.invited.validity", date: l(membership.invitation_expires_at, format: :long)) %></p>
  <% if membership.invitation_channels.include?("email") %>
    <p class="alert-ok mt-6"><%= t("panel.memberships.invited.email_sent", email: membership.user.email) %></p>
  <% end %>
  <% if membership.invitation_channels.include?("link") %>
    <section class="card card-body mt-6">
      <h2 class="card-title"><%= t("panel.memberships.invited.link_title") %></h2>
      <p class="mt-2 text-sm"><%= t("panel.memberships.invited.link_instructions") %></p>
      <p class="mt-3 rounded-lg bg-canvas px-3 py-2 font-mono text-xs break-all"><%= @invitation.link %></p>
      <div class="mt-4 w-48 rounded-lg border border-line bg-white p-2"><%= qr_code_svg(@invitation.link) %></div>
    </section>
  <% end %>
<% else %>
  <h1 class="page-title"><%= t(".requested_title", firm: firm.name) %></h1>
  <p class="page-subtitle"><%= t(".requested_body") %></p>
<% end %>

<p class="mt-6"><%= link_to t(".back"), accounting_firm_path, class: "btn btn-secondary" %></p>
