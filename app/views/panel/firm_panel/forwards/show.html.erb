<%# The forward, after the password (D-651): the record without health and the validated
    documents the item chose (RN-06-065, D-652, spec 03, section 4.3). Read only; the firm
    only confirms. %>
<% content_for :title, @profile.display_name %>
<% user = @profile.user %>
<% current = @employment.effective_revision %>
<% labels = "panel.employees.show" %>

<p class="text-sm"><%= link_to t(".back"), firm_forwards_path, class: "link-button" %></p>
<div class="mt-3 flex flex-wrap items-center gap-3">
  <div class="min-w-0">
    <h1 class="page-title"><%= @profile.display_name %></h1>
    <p class="page-subtitle"><%= @item.company.name %></p>
  </div>
  <div class="flex flex-wrap items-center gap-3 sm:ml-auto">
    <%= firm_forward_pill(@item) %>
    <% if @item.sent? %>
      <%= button_to t(".confirm"), confirm_firm_forward_path(@item), method: :patch, class: "btn btn-primary",
        form: { data: { confirm: t(".confirm_confirm") } } %>
    <% end %>
  </div>
</div>

<div class="mt-6 space-y-6">
  <% if @item.config["record"] %>
    <section class="card card-body">
      <h2 class="card-title"><%= employment_kind(@employment) %> · <%= t("#{labels}.registration", number: @employment.registration_number) %></h2>
      <dl class="details-list mt-3">
        <div><dt><%= t(".started_on") %></dt><dd><%= l(@employment.started_on) %></dd></div>
        <% if current %>
          <div><dt><%= t("#{labels}.position") %></dt><dd><%= current.position.name %> <span class="font-mono text-xs text-ink-muted"><%= current.cbo_code %></span></dd></div>
          <div><dt><%= t("#{labels}.place") %></dt><dd><%= revision_place(current) %></dd></div>
          <div><dt><%= t("#{labels}.weekly_hours") %></dt><dd><%= current.weekly_hours ? t("#{labels}.hours", hours: number_with_precision(current.weekly_hours, strip_insignificant_zeros: true)) : "—" %></dd></div>
          <div><dt><%= t("#{labels}.salary") %></dt><dd><%= revision_salary(current) %></dd></div>
        <% end %>
        <% @employment.shown_details.reject { |_key, value| value.nil? }.each do |key, value| %>
          <div><dt><%= t("employments.details.#{key}") %></dt><dd><%= employment_detail_value(key, value) %></dd></div>
        <% end %>
      </dl>
    </section>

    <section class="card card-body">
      <h2 class="card-title"><%= t("#{labels}.personal") %></h2>
      <dl class="details-list mt-3">
        <div><dt><%= t(".name") %></dt><dd><%= user.name %></dd></div>
        <div><dt><%= t("#{labels}.cpf") %></dt><dd class="font-mono"><%= forward_cpf(user) %></dd></div>
        <div><dt><%= t("#{labels}.birth_date") %></dt><dd><%= user.birth_date ? l(user.birth_date) : "—" %></dd></div>
        <div><dt><%= t("#{labels}.email") %></dt><dd><%= user.email || "—" %></dd></div>
        <div><dt><%= t("#{labels}.mobile_phone") %></dt><dd><%= user.mobile_phone || "—" %></dd></div>
        <div><dt><%= t("#{labels}.sex") %></dt><dd><%= option_label("worker_profiles.sexes", @profile.sex) %></dd></div>
        <div><dt><%= t("#{labels}.race") %></dt><dd><%= option_label("worker_profiles.races", @profile.race) %></dd></div>
        <div><dt><%= t("#{labels}.marital_status") %></dt><dd><%= option_label("worker_profiles.marital_statuses", @profile.marital_status) %></dd></div>
        <div><dt><%= t("#{labels}.education_level") %></dt><dd><%= option_label("worker_profiles.education_levels", @profile.education_level) %></dd></div>
        <div><dt><%= t("#{labels}.birthplace") %></dt><dd><%= [ @profile.birth_city, @profile.birth_state, @profile.birth_country ].compact.join(" · ").presence || "—" %></dd></div>
        <div><dt><%= t("#{labels}.nationality") %></dt><dd><%= @profile.nationality || "—" %></dd></div>
        <div class="sm:col-span-2"><dt><%= t("#{labels}.address") %></dt><dd><%= worker_address(@profile).presence || "—" %></dd></div>
      </dl>
    </section>

    <section class="card card-body">
      <h2 class="card-title"><%= t("#{labels}.documents") %></h2>
      <dl class="details-list mt-3">
        <div>
          <dt><%= t("#{labels}.rg") %></dt>
          <dd><span class="font-mono"><%= reveal_confirmed(@profile, :rg_number, as: :text, section: :documents).presence || "—" %></span>
            <%= [ @profile.rg_issuer, @profile.rg_state, (l(@profile.rg_issued_on) if @profile.rg_issued_on) ].compact.join(" · ") %></dd>
        </div>
        <div>
          <dt><%= t("#{labels}.ctps") %></dt>
          <dd><span class="font-mono"><%= reveal_confirmed(@profile, :ctps_number, as: :text, section: :documents).presence || "—" %></span>
            <%= [ (t("#{labels}.series", series: @profile.ctps_series) if @profile.ctps_series), @profile.ctps_state ].compact.join(" · ") %></dd>
        </div>
        <div><dt><%= t("#{labels}.pis_nis") %></dt><dd class="font-mono"><%= reveal_confirmed(@profile, :pis_nis, as: :text, section: :documents).presence || "—" %></dd></div>
        <div><dt><%= t("#{labels}.voter_id") %></dt><dd class="font-mono"><%= reveal_confirmed(@profile, :voter_id, as: :text, section: :documents).presence || "—" %></dd></div>
        <div>
          <dt><%= t("#{labels}.cnh") %></dt>
          <dd><span class="font-mono"><%= reveal_confirmed(@profile, :cnh_number, as: :text, section: :documents).presence || "—" %></span>
            <%= [ (t("#{labels}.cnh_category", category: @profile.cnh_category) if @profile.cnh_category), (t("#{labels}.expires_on", date: l(@profile.cnh_expires_on)) if @profile.cnh_expires_on) ].compact.join(" · ") %></dd>
        </div>
        <div>
          <dt><%= t("#{labels}.class_registration") %></dt>
          <dd><span class="font-mono"><%= reveal_confirmed(@profile, :class_registration, as: :text, section: :documents).presence || "—" %></span>
            <%= @profile.class_registration_issuer %></dd>
        </div>
        <div><dt><%= t("#{labels}.foreign_registration") %></dt><dd class="font-mono"><%= reveal_confirmed(@profile, :foreign_registration, as: :text, section: :documents).presence || "—" %></dd></div>
      </dl>
    </section>

    <section class="card card-body">
      <h2 class="card-title"><%= t("#{labels}.dependents") %></h2>
      <% dependents = @profile.dependents.ordered.to_a %>
      <% if dependents.empty? %>
        <p class="mt-2 text-sm text-ink-soft"><%= t("#{labels}.no_dependents") %></p>
      <% else %>
        <div class="mt-3 overflow-x-auto rounded-lg border border-line-soft">
          <table class="data-table min-w-[640px]">
            <thead>
              <tr>
                <th><%= t("#{labels}.dependent_name") %></th>
                <th><%= t("#{labels}.relationship") %></th>
                <th><%= t("#{labels}.birth_date") %></th>
                <th><%= t("#{labels}.cpf") %></th>
                <th><%= t("#{labels}.dependent_uses") %></th>
              </tr>
            </thead>
            <tbody>
              <% dependents.each do |dependent| %>
                <tr class="<%= "text-ink-muted" if dependent.ended? %>">
                  <td><%= dependent.name %></td>
                  <td><%= t("dependents.relationship_types.#{dependent.relationship_type}") %></td>
                  <td class="whitespace-nowrap"><%= l(dependent.birth_date) %></td>
                  <td class="font-mono"><%= dependent_cpf(dependent) %></td>
                  <td><%= forward_dependent_uses(dependent) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>

    <section class="card card-body">
      <h2 class="card-title"><%= t("#{labels}.bank_accounts") %></h2>
      <% accounts = @profile.bank_accounts.ordered.select(&:active?) %>
      <% if accounts.empty? %>
        <p class="mt-2 text-sm text-ink-soft"><%= t("#{labels}.no_bank_accounts") %></p>
      <% else %>
        <ul class="mt-3 divide-y divide-line-soft">
          <% accounts.each do |account| %>
            <li class="py-3 text-sm font-semibold">
              <%= bank_account_summary(account) %>
              <% if account.primary? %><span class="pill pill-ok ml-1"><%= t("#{labels}.primary") %></span><% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>

  <% if @item.config["validated_documents"] %>
    <section class="card card-body">
      <h2 class="card-title"><%= t(".validated_documents") %></h2>
      <% if @documents.empty? %>
        <p class="mt-2 text-sm text-ink-soft"><%= t(".no_documents") %></p>
      <% else %>
        <ul class="mt-3 divide-y divide-line-soft">
          <% @documents.each do |document| %>
            <li class="flex flex-wrap items-center justify-between gap-3 py-3 text-sm">
              <span class="font-semibold"><%= document.document_type.name %></span>
              <% if impersonating? %>
                <span class="text-ink-soft"><%= t(".impersonating") %></span>
              <% elsif document.current_version.readable? %>
                <%= link_to t(".open"), document_firm_forward_path(@item, document), class: "link-button", target: "_blank", rel: "noopener" %>
              <% else %>
                <span class="text-ink-soft"><%= t(".not_ready") %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
</div>
