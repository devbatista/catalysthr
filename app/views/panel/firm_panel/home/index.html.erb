<% firm = firm_membership.organization %>
<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= firm.name %></h1>
  <% if can?(:read, Membership.new(organization: firm)) %>
    <%= link_to t(".team"), firm_team_members_path, class: "rounded-lg px-4 py-2 ring-1 ring-slate-300" %>
  <% end %>
</div>
<p class="mt-2 text-sm"><%= t(".subtitle", brand: Current.brand.commercial_name) %></p>

<% if @links.empty? %>
  <p class="mt-6"><%= t(".empty") %></p>
<% else %>
  <ul class="mt-6 space-y-2">
    <% @links.each do |link| %>
      <li class="flex flex-wrap items-center justify-between gap-3 rounded-lg bg-white px-4 py-3 ring-1 ring-slate-200">
        <span>
          <span class="font-semibold"><%= link.company.name %></span>
          <% if link.pending? %><span class="ml-2 text-sm text-slate-500"><%= t(".pending") %></span><% end %>
        </span>
        <span class="flex items-center gap-3 text-sm">
          <% if link.pending? %>
            <% if can?(:accept, link) %>
              <%= button_to t(".accept"), accept_firm_link_path(link), class: "rounded-lg bg-brand-primary px-3 py-1 font-semibold text-white" %>
              <%= button_to t(".refuse"), refuse_firm_link_path(link), class: "rounded-lg px-3 py-1 ring-1 ring-slate-300",
                form: { data: { confirm: t(".refuse_confirm", company: link.company.name) } } %>
            <% end %>
          <% elsif authorized_companies.include?(link.company) %>
            <%= button_to t(".enter"), current_company_path, params: { company_id: link.company_id },
              class: "rounded-lg bg-brand-primary px-3 py-1 font-semibold text-white" %>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>
<% end %>
