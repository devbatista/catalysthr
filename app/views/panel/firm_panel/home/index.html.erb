<% firm = firm_membership.organization %>
<h1 class="page-title"><%= firm.name %></h1>
<p class="page-subtitle"><%= t(".subtitle", brand: Current.brand.commercial_name) %></p>

<% if @links.empty? %>
  <p class="card card-body mt-6 text-sm text-ink-soft"><%= t(".empty") %></p>
<% else %>
  <div class="card mt-6 overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t(".company") %></th>
          <th class="text-right"><span class="sr-only"><%= t(".actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% @links.each do |link| %>
          <tr>
            <td>
              <span class="font-bold text-ink-strong"><%= link.company.name %></span>
              <% if link.pending? %><span class="pill pill-warn ml-2"><%= t(".pending") %></span><% end %>
            </td>
            <td>
              <span class="flex flex-wrap items-center justify-end gap-2">
                <% if link.pending? %>
                  <% if can?(:accept, link) %>
                    <%= button_to t(".accept"), accept_firm_link_path(link), class: "btn btn-primary btn-sm" %>
                    <%= button_to t(".refuse"), refuse_firm_link_path(link), class: "btn btn-secondary btn-sm",
                      form: { data: { confirm: t(".refuse_confirm", company: link.company.name) } } %>
                  <% end %>
                <% elsif authorized_companies.include?(link.company) %>
                  <%= button_to t(".enter"), current_company_path, params: { company_id: link.company_id }, class: "btn btn-primary btn-sm" %>
                <% end %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
