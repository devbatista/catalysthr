<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || Current.brand.commercial_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= Current.brand.app_name %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="<%= theme_colors[:primary] %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= tag.link rel: "manifest", href: manifest_path %>
    <%= push_meta_tag %>
    <%# The brand's icons, or the CatalystHR ones when it has none (D-159, RN-01-035) %>
    <% if (favicon = brand_image_path(Current.brand, :favicon)) %>
      <%= tag.link rel: "icon", href: favicon %>
    <% else %>
      <link rel="icon" href="/favicon.ico" sizes="48x48">
      <link rel="icon" href="/icon.png" type="image/png">
    <% end %>
    <%= tag.link rel: "apple-touch-icon", href: brand_image_path(Current.brand, :pwa_icon_large) || "/apple-touch-icon.png" %>

    <%# Brand colors as CSS variables used by the Tailwind theme (RN-01-031), and the
        sidebar's text color (D-597) %>
    <style nonce="<%= content_security_policy_nonce %>">
      :root {
        --brand-primary: <%= theme_colors[:primary] %>;
        --brand-secondary: <%= theme_colors[:secondary] %>;
        --brand-accent: <%= theme_colors[:accent] %>;
        --brand-on-secondary: <%= sidebar_text_color %>;
        --brand-on-primary: <%= primary_text_color %>;
      }
    </style>

    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen">
    <%# The banners stay on top of every page; the sidebar starts below them and fits the
        rest of the screen (application.js measures them into --top-banners). %>
    <% lock = contract_lock if defined?(contract_lock) %>
    <% if impersonating? || Current.support_access || lock %>
      <div class="sticky top-0 z-50" data-top-banners>
        <%= render "panel/shared/impersonation" if impersonating? %>
        <%= render "panel/shared/support_access" if Current.support_access %>
        <%= render "panel/shared/contract_lock", lock: lock if lock %>
      </div>
    <% end %>
    <%# A new version of the app and an old browser (spec 16, RN-16-064, RN-16-080), shown by
        application.js when they apply. %>
    <div hidden data-sw-update role="status"
      class="fixed inset-x-4 bottom-20 z-50 mx-auto flex max-w-md items-center justify-between gap-3 rounded-xl bg-ink-strong px-4 py-3 text-sm font-semibold text-white shadow-lg lg:bottom-6">
      <span><%= t("pwa.update.message") %></span>
      <button type="button" class="btn btn-primary btn-sm" data-sw-update-button><%= t("pwa.update.button") %></button>
    </div>
    <p hidden data-old-browser role="status" class="alert-info fixed inset-x-4 top-4 z-50 mx-auto max-w-md shadow-lg"><%= t("pwa.old_browser") %></p>
    <%= content_for?(:content) ? yield(:content) : yield %>
  </body>
</html>
