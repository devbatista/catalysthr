<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || Current.brand.commercial_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= Current.brand.app_name %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="<%= theme_colors[:primary] %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= tag.link rel: "manifest", href: manifest_path %>
    <%# The brand's icons, or the CatalystHR ones when it has none (D-159, RN-01-035) %>
    <% if Current.brand.favicon.attached? %>
      <%= tag.link rel: "icon", href: url_for(Current.brand.favicon) %>
    <% else %>
      <link rel="icon" href="/favicon.ico" sizes="48x48">
      <link rel="icon" href="/icon.png" type="image/png">
    <% end %>
    <%= tag.link rel: "apple-touch-icon", href: Current.brand.pwa_icon_large.attached? ? url_for(Current.brand.pwa_icon_large) : "/apple-touch-icon.png" %>

    <%# Brand colors as CSS variables used by the Tailwind theme (RN-01-031) %>
    <style>
      :root {
        --brand-primary: <%= theme_colors[:primary] %>;
        --brand-secondary: <%= theme_colors[:secondary] %>;
        --brand-accent: <%= theme_colors[:accent] %>;
      }
    </style>

    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-brand-secondary">
    <%= render "panel/shared/impersonation" if impersonating? %>
    <%= render "panel/shared/support_access" if Current.support_access %>
    <%= content_for?(:content) ? yield(:content) : yield %>
  </body>
</html>
