<%# Sign-in, recovery and unlock pages, inside the admin or the brand's layout %>
<% content_for :content do %>
  <div class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-4 py-12 sm:px-6">
    <div class="card p-6 shadow-sm sm:p-8">
      <%= render "users/shared/header" %>
      <% if flash.any? { |type, _message| type.to_s != "simulation" } %>
        <div class="mt-6 -mb-6"><%= render "shared/flash" %></div>
      <% end %>
      <%= yield %>
    </div>

    <%= render "users/shared/links" %>
  </div>
<% end %>
<%= render template: Current.area == :panel ? "layouts/panel" : "layouts/application" %>
