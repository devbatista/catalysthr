<%# The notices' e-mail (RN-15-002): the brand's logo or name, the text, and a footer that
    says why the person got it. Styles are inline, as e-mail clients need. %>
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <body style="margin:0;padding:0;background:#F2F5F9;font-family:Helvetica,Arial,sans-serif;color:#0A2A4A;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F2F5F9;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#FFFFFF;border:1px solid #DCE3EC;border-radius:12px;">
            <tr>
              <td style="padding:20px 28px;border-bottom:1px solid #E7ECF2;">
                <% if @logo_url %>
                  <img src="<%= @logo_url %>" alt="<%= @sender_name %>" height="32" style="display:block;height:32px;width:auto;border:0;">
                <% else %>
                  <strong style="font-size:18px;color:<%= @color %>;"><%= @sender_name %></strong>
                <% end %>
              </td>
            </tr>
            <tr>
              <td style="padding:28px;font-size:15px;line-height:1.55;">
                <%= yield %>
              </td>
            </tr>
          </table>
          <p style="max-width:560px;margin:16px auto 0;font-size:12px;line-height:1.5;color:#5B6B7F;">
            <%= t(@notification.in_bell? ? "notification_mailer.footer_bell" : "notification_mailer.footer", brand: @sender_name) %>
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
