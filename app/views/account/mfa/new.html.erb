<% issuer = Current.brand&.commercial_name || "CatalystHR" %>
<% uri = current_user.otp_provisioning_uri(current_user.email.presence || current_user.first_name, issuer: issuer, otp_secret: @secret) %>

<div class="mx-auto max-w-md px-6 py-12">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <% if current_user.mfa_required? %>
    <p class="mt-2 text-sm"><%= t(".required") %></p>
  <% end %>
  <%= render "shared/flash" %>

  <ol class="mt-6 list-decimal space-y-4 pl-5 text-sm">
    <li><%= t(".install") %></li>
    <li>
      <%= t(".scan") %>
      <div class="mt-3 w-48 rounded-lg bg-white p-2 ring-1 ring-slate-200">
        <%= qr_code_svg(uri) %>
      </div>
      <p class="mt-3"><%= t(".manual") %></p>
      <p class="mt-1 break-all font-mono text-base tracking-widest"><%= @secret.scan(/.{1,4}/).join(" ") %></p>
    </li>
    <li><%= t(".confirm") %></li>
  </ol>

  <%= form_with url: account_mfa_path, method: :post, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :otp_code, t(".code"), class: "block text-sm font-medium" %>
      <%= form.text_field :otp_code, required: true, autocomplete: "one-time-code", inputmode: "numeric",
        class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 tracking-widest" %>
    </div>
    <%= form.submit t(".submit"), class: "w-full rounded-lg bg-brand-primary px-4 py-3 font-semibold text-white" %>
  <% end %>

  <% unless current_user.mfa_required? %>
    <p class="mt-6 text-sm"><%= link_to t("account.back_to_security"), account_root_path, class: "underline" %></p>
  <% end %>
</div>
