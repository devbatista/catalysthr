<div class="mx-auto max-w-2xl px-6 py-12">
  <p class="text-sm"><%= link_to t("account.back"), root_path, class: "underline" %></p>
  <h1 class="mt-4 text-2xl font-bold"><%= t(".title") %></h1>
  <%= render "shared/flash" %>

  <section class="mt-8 rounded-2xl bg-white p-6 ring-1 ring-slate-200">
    <h2 class="text-lg font-semibold"><%= t(".password.title") %></h2>
    <p class="mt-2"><%= link_to t(".password.change"), edit_account_password_path, class: "underline" %></p>
  </section>

  <section class="mt-6 rounded-2xl bg-white p-6 ring-1 ring-slate-200">
    <h2 class="text-lg font-semibold"><%= t(".mfa.title") %></h2>
    <% if current_user.mfa_enabled? %>
      <p class="mt-2"><%= t(".mfa.enabled", count: current_user.otp_backup_codes.to_a.size) %></p>

      <%= form_with url: account_recovery_codes_path, method: :post, class: "mt-4 space-y-2" do |form| %>
        <%= form.label :current_password, t(".current_password"), class: "block text-sm font-medium" %>
        <%= form.password_field :current_password, required: true, autocomplete: "current-password",
          class: "block w-full rounded-lg border border-slate-300 px-3 py-2" %>
        <%= form.submit t(".mfa.regenerate"), class: "rounded-lg bg-brand-primary px-4 py-2 font-semibold text-white" %>
      <% end %>

      <% unless current_user.mfa_required? %>
        <%= form_with url: account_mfa_path, method: :delete, class: "mt-4 space-y-2" do |form| %>
          <%= form.label :current_password, t(".current_password"), class: "block text-sm font-medium" %>
          <%= form.password_field :current_password, required: true, autocomplete: "current-password",
            class: "block w-full rounded-lg border border-slate-300 px-3 py-2" %>
          <%= form.submit t(".mfa.disable"), class: "rounded-lg px-4 py-2 font-semibold text-red-700 ring-1 ring-red-300" %>
        <% end %>
      <% end %>
    <% else %>
      <p class="mt-2"><%= t(current_user.mfa_required? ? ".mfa.required" : ".mfa.optional") %></p>
      <p class="mt-2"><%= link_to t(".mfa.enable"), new_account_mfa_path, class: "underline" %></p>
    <% end %>
  </section>

  <section class="mt-6 rounded-2xl bg-white p-6 ring-1 ring-slate-200">
    <h2 class="text-lg font-semibold"><%= t(".devices.title") %></h2>
    <% if @devices.empty? %>
      <p class="mt-2"><%= t(".devices.empty") %></p>
    <% else %>
      <ul class="mt-2 divide-y divide-slate-200">
        <% @devices.each do |device| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <span class="text-sm">
              <%= device.user_agent.presence || t(".unknown_browser") %><br>
              <span class="text-slate-500"><%= t(".devices.details", last_used: l(device.last_used_at, format: :short), expires: l(device.expires_at.to_date)) %></span>
            </span>
            <%= button_to t(".devices.forget"), account_trusted_device_path(device), method: :delete, class: "text-sm underline" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="mt-6 rounded-2xl bg-white p-6 ring-1 ring-slate-200">
    <h2 class="text-lg font-semibold"><%= t(".sessions.title") %></h2>
    <ul class="mt-2 divide-y divide-slate-200">
      <% @sessions.each do |user_session| %>
        <li class="flex items-center justify-between gap-4 py-3">
          <span class="text-sm">
            <%= user_session.user_agent.presence || t(".unknown_browser") %><br>
            <span class="text-slate-500">
              <%= user_session.brand&.commercial_name || t(".sessions.admin") %> ·
              <%= t(".sessions.details", ip: user_session.ip, last_seen: l(user_session.last_seen_at, format: :short)) %>
            </span>
          </span>
          <% if user_session == Current.user_session %>
            <span class="text-sm font-semibold"><%= t(".sessions.current") %></span>
          <% else %>
            <%= button_to t(".sessions.end"), account_session_path(user_session), method: :delete, class: "text-sm underline" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</div>
