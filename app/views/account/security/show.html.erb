<div>
  <h1 class="page-title"><%= t(".title") %></h1>

  <section class="mt-6 card card-body">
    <h2 class="card-title"><%= t(".password.title") %></h2>
    <p class="mt-2 text-sm"><%= link_to t(".password.change"), edit_account_password_path, class: "link-button" %></p>
  </section>

  <section class="mt-6 card card-body">
    <h2 class="card-title"><%= t(".mfa.title") %></h2>
    <% if current_user.mfa_enabled? %>
      <p class="mt-2 text-sm"><%= t(".mfa.enabled", count: current_user.otp_backup_codes.to_a.size) %></p>

      <%= form_with url: account_recovery_codes_path, method: :post, class: "mt-4 space-y-2" do |form| %>
        <div class="form-grid">
          <div>
            <%= form.label :current_password, t(".current_password"), class: "field-label" %>
            <%= form.password_field :current_password, required: true, autocomplete: "current-password",
              class: "input" %>
          </div>
        </div>
        <%= form.submit t(".mfa.regenerate"), class: "btn btn-primary" %>
      <% end %>

      <% unless current_user.mfa_required? %>
        <%= form_with url: account_mfa_path, method: :delete, class: "mt-4 space-y-2" do |form| %>
          <div class="form-grid">
            <div>
              <%= form.label :current_password, t(".current_password"), class: "field-label" %>
              <%= form.password_field :current_password, required: true, autocomplete: "current-password",
                class: "input" %>
            </div>
          </div>
          <%= form.submit t(".mfa.disable"), class: "btn btn-danger" %>
        <% end %>
      <% end %>
    <% else %>
      <p class="mt-2 text-sm"><%= t(current_user.mfa_required? ? ".mfa.required" : ".mfa.optional") %></p>
      <p class="mt-2 text-sm"><%= link_to t(".mfa.enable"), new_account_mfa_path, class: "link-button" %></p>
    <% end %>
  </section>

  <% if FeatureFlags.enabled?(FeatureFlags::PASSKEYS) && !Current.support_access %>
    <%= render "account/security/passkeys" %>
  <% end %>

  <section class="mt-6 card card-body">
    <h2 class="card-title"><%= t(".devices.title") %></h2>
    <% if @devices.empty? %>
      <p class="mt-2 text-sm"><%= t(".devices.empty") %></p>
    <% else %>
      <ul class="mt-2 divide-y divide-line-soft">
        <% @devices.each do |device| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <span class="text-sm">
              <%= device.user_agent.presence || t(".unknown_browser") %><br>
              <span class="text-ink-muted"><%= t(".devices.details", last_used: l(device.last_used_at, format: :short), expires: l(device.expires_at.to_date)) %></span>
            </span>
            <%= button_to t(".devices.forget"), account_trusted_device_path(device), method: :delete, class: "link-button text-sm" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="mt-6 card card-body">
    <h2 class="card-title"><%= t(".sessions.title") %></h2>
    <ul class="mt-2 divide-y divide-line-soft">
      <% @sessions.each do |user_session| %>
        <li class="flex items-center justify-between gap-4 py-3">
          <span class="text-sm">
            <%= user_session.user_agent.presence || t(".unknown_browser") %><br>
            <span class="text-ink-muted">
              <%= user_session.brand&.commercial_name || t(".sessions.admin") %> ·
              <%= t(".sessions.details", ip: user_session.ip, last_seen: l(user_session.last_seen_at, format: :short)) %>
            </span>
          </span>
          <% if user_session == Current.user_session %>
            <span class="text-sm font-semibold"><%= t(".sessions.current") %></span>
          <% else %>
            <%= button_to t(".sessions.end"), account_session_path(user_session), method: :delete, class: "link-button text-sm" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</div>
