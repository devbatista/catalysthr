<%# Centered, like every screen of the MFA flow (D-615) %>
<div class="card card-body mx-auto max-w-3xl">
  <h1 class="page-title"><%= t(".title") %></h1>
  <p class="page-subtitle"><%= t(".instructions") %></p>

  <ul class="mt-6 grid grid-cols-2 gap-2 rounded-lg border border-line bg-canvas p-4 font-mono text-lg">
    <% @codes.each do |code| %>
      <li><%= code %></li>
    <% end %>
  </ul>

  <p class="mt-6"><%= link_to t(".continue"), root_path, class: "btn btn-primary" %></p>
</div>
